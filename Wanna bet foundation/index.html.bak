  comment:'<path d="M20.5 12.2c0 4-3.8 7.2-8.5 7.2-1 0-2-.15-2.9-.42L4 20.5l1.5-3.4A6.9 6.9 0 0 1 3.5 12.2C3.5 8.2 7.3 5 12 5s8.5 3.2 8.5 7.2z"/>',
  flameS:'<path d="M12.6 2.2c.7 3.3-1.3 4.8-2.9 6.4-1.9 1.9-4 3.7-4 7.1A6.3 6.3 0 0 0 12 21.8a6.3 6.3 0 0 0 6.3-6.1c0-2.8-1.3-4.3-2.6-5.8-.5 1.1-1.4 1.7-2.4 2 .8-2.8.3-6.9-.7-9.7z" fill="currentColor" stroke="none"/><path d="M12 18.6a2.7 2.7 0 0 1-2.7-2.8c0-1.4 1-2.2 1.8-3.1.5 1 1.2 1.4 2 1.6-.3 1.2 0 2 .6 2.7a2.6 2.6 0 0 1-1.7 1.6z" fill="#FFFFFF" stroke="none" opacity=".35"/>',
  dumbbellS:'<rect x="2" y="9" width="3" height="6" rx="1.2" fill="currentColor" stroke="none"/><rect x="5.6" y="6.8" width="3.4" height="10.4" rx="1.4" fill="currentColor" stroke="none"/><rect x="9" y="10.6" width="6" height="2.8" rx="1.2" fill="currentColor" stroke="none"/><rect x="15" y="6.8" width="3.4" height="10.4" rx="1.4" fill="currentColor" stroke="none"/><rect x="19" y="9" width="3" height="6" rx="1.2" fill="currentColor" stroke="none"/>',
  shoe:'<path d="M2.6 16.4h17.2c.9 0 1.6.7 1.6 1.6v.4c0 .9-.7 1.6-1.6 1.6H4.2a1.6 1.6 0 0 1-1.6-1.6z" fill="currentColor" stroke="none"/><path d="M2.6 16.4v-4.3c0-.7.5-1.2 1.2-1.2h1.7c.6 0 1.1.3 1.4.7l1.2 1.7c.3.4.8.7 1.3.8l4.3.4c2 .2 3.9 1.1 5.4 2.5" stroke-width="1.9"/><path d="m7.6 12.1 1.5-1.9M10.4 13l1.6-2M13.3 13.6l1.5-1.9" stroke-width="1.5"/>',
  trophyS:'<path d="M7.6 3.5h8.8v5.2a4.4 4.4 0 0 1-8.8 0z" fill="currentColor" stroke="none"/><path d="M7.6 5H5.1v1.6A3.1 3.1 0 0 0 8 9.7M16.4 5h2.5v1.6a3.1 3.1 0 0 1-2.9 3.1" stroke-width="1.8"/><path d="M11 13.2h2v3.4h-2z" fill="currentColor" stroke="none"/><path d="M8 20.2h8a.9.9 0 0 0 0-1.8H8a.9.9 0 0 0 0 1.8z" fill="currentColor" stroke="none"/>',
  dollarS:'<path d="M12.9 2.6v1.6c1.9.2 3.3 1.1 3.7 2.7l-2.2.6c-.3-.8-1-1.3-2.2-1.3-1.3 0-2.1.5-2.1 1.3 0 .9.8 1.2 2.6 1.6 2.6.6 4.2 1.4 4.2 3.7 0 1.9-1.4 3.2-3.9 3.5v1.6h-1.9v-1.6c-2.2-.2-3.8-1.3-4.2-3.2l2.3-.6c.3 1.1 1.2 1.7 2.6 1.7 1.4 0 2.2-.5 2.2-1.4 0-.9-.8-1.2-2.7-1.6-2.4-.5-4.1-1.3-4.1-3.6 0-1.8 1.3-3.1 3.7-3.4V2.6z" fill="currentColor" stroke="none"/>',
  trendS:'<path d="M3.6 16.2 9 10.8l3.4 3.4L20.4 6" stroke-width="2.4"/><path d="M15.4 6h5v5" stroke-width="2.4"/>',
};
/* overview icons cropped from the design so they match it exactly */
const MOCK_ICON = {
  ov_workouts:'data:image/png;base64,',
  ov_wins:'data:image/png;base64,',
  ov_money:'data:image/png;base64,',
  ov_level:'data:image/png;base64,'
};
function mockIcon(k){ return `<img class="mock-ic" src="${MOCK_ICON[k]}" alt="">`; }

const WORDMARK = 'data:image/webp;base64,';

const COACH_BOT = 'data:image/webp;base64,';

const CHAL_ART = 'data:image/webp;base64,';

const RUNNER_MARK = 'data:image/webp;base64,';

function ic(name, cls){
  const p = IP[name] || IP.dot;
  return `<svg class="ico ${cls||''}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
}
/* glyph resolver: accepts an icon name, pre-built svg, or legacy emoji */
function G(v){
  if(!v) return ic('dot');
  const s = String(v);
  if(s.indexOf('<svg') === 0) return s;
  if(IP[s]) return ic(s);
  return ic(EMOJI_FALLBACK[s] || 'dot');
}
const EMOJI_FALLBACK = {};


/* ═══════════════ v4 engine — Health, verification, live, auto-settle ═══════════════ */

/* ── metrics gain a Health-tracked distance option ── */
METRICS.push({id:'distance', name:'Distance', unit:'mi', emoji:'run', color:'#2563EB', target:10, health:true});
METRICS.forEach(m=>{
  m.emoji = {steps:'shoe', workouts:'flameS', minutes:'timer', calories:'bolt', habit:'dumbbellS', distance:'run'}[m.id] || 'dot';
  m.health = m.id === 'distance' || m.id === 'steps';
  m.verify = m.health ? 'health' : (m.id === 'habit' ? 'checkin' : 'video');
});
const VERIFY_LABEL = {health:'Health data', video:'Video proof', checkin:'Daily check-in'};

/* ── Apple Health / fitness app connection ── */
function health(){ DB.health = DB.health || {connected:false, provider:'Apple Health', grantedAt:null, lastSync:null}; return DB.health; }
function healthOn(){ return !!health().connected; }
function connectHealth(after){
  const h = health();
  h.connected = true;
  h.grantedAt = now();
  h.lastSync = now();
  DB.profile.health = true;
  syncHealth();
  logActivity('You connected <b>' + h.provider + '</b> — distance and steps now auto-track', 'heart', 'progress');
  toast(h.provider + ' connected', 'check');
  commit();
  if(after) after();
}
function disconnectHealth(){
  const h = health();
  h.connected = false;
  DB.profile.health = false;
  toast('Health disconnected — distance bets are paused', 'x');
  commit();
}
/* pulls the day's numbers for any Health-tracked bet you're in */
function syncHealth(){
  const h = health();
  if(!h.connected) return 0;
  let touched = 0;
  h.lastSync = now();
  DB.bets.filter(b=>b.status === 'live' && b.participants.includes('me') && metricById(b.metricId).health).forEach(b=>{
    /* Health has the whole day, even if the bet opened mid-morning */
    const floor = startOfDay(b.startedAt);
    const sessions = DB.workouts.filter(w=>w.ts >= floor);
    const perSession = b.metricId === 'distance' ? 2.4 : 3200;
    const val = Math.round(sessions.length * perSession * 10) / 10;
    if(val > (b.myProgress || 0)){ b.myProgress = val; touched++; stampFinish(b, 'me'); }
  });
  return touched;
}

/* ── progress helpers ── */
function progressOf(b, pid){ return pid === 'me' ? (b.myProgress || 0) : (b.progress[pid] || 0); }
function stampFinish(b, pid){
  b.finished = b.finished || {};
  if(!b.finished[pid] && progressOf(b, pid) >= b.target) b.finished[pid] = now();
}
function proofsFor(b, pid){ return (b.proofs || []).filter(p=>p.who === pid && p.ok); }

/* fit score — the tiebreaker when nobody clears the target in time */
function fitScore(b, pid){
  const pct = Math.min(1.4, progressOf(b, pid) / (b.target || 1));
  const verified = Math.min(5, proofsFor(b, pid).length);
  const elapsedDays = Math.max(1, Math.ceil((Math.min(now(), b.endsAt) - b.startedAt) / DAY));
  const consistency = pid === 'me'
    ? Math.min(1, activeDaysSince(b.startedAt, now() + DAY) / elapsedDays)
    : Math.min(1, progressOf(b, pid) / (b.target || 1));
  return Math.round((pct * 70 + verified * 4 + consistency * 10) * 10) / 10;
}
function fitRank(b){
  return b.participants.slice().sort((x,y)=>fitScore(b,y) - fitScore(b,x));
}

/* ── settlement ── */
function settleBetWith(b, winners, reason){
  if(b.status !== 'live') return;
  b.winners = winners;
  b.status = 'settled';
  b.endedAt = now();
  b.settleReason = reason;
  const iWon = winners.includes('me');
  if(b.participants.includes('me')){
    if(iWon){
      const pay = payoutFor(b);
      ledgerAdd('payout', pay, 'Payout · ' + b.title, b.id);
      addXP(XP.win, 'Bet won');
      const rw = rewardById(b.rewardId);
      DB.rewardLog.push({id:uid('rw'), ts:now(), who:'me', rewardId:rw.id, betId:b.id, used:false});
      if(rw.xp) addXP(rw.xp, 'Reward bonus');
      logActivity(`You won <b>${escapeHtml(b.title)}</b> — ${money(pay)} · ${SETTLE_REASON[reason]}`, 'trophy', 'win');
      notify(`You won ${b.title}. ${money(pay)} paid out — ${SETTLE_REASON[reason]}.`, 'trophy', {screen:'betDetail', params:{id:b.id}});
      toast('You won ' + money(pay), 'trophy');
    } else {
      const p = punishmentById(b.punishmentId);
      DB.punishLog.push({id:uid('pn'), ts:now(), who:'me', punishmentId:p.id, betId:b.id, status:'owed', dueAt:now()+DAY});
      logActivity(`You lost <b>${escapeHtml(b.title)}</b> — ${p.name} owed`, p.emoji, 'loss');
      notify(`${escapeHtml(personName(winners[0]))} took ${b.title}. ${p.name} is due within 24h.`, p.emoji, {screen:'punishments'});
      toast('Lost — ' + p.name + ' owed', 'ghost');
    }
  }
  b.participants.filter(p=>p !== 'me' && !winners.includes(p)).forEach(p=>{
    DB.punishLog.push({id:uid('pn'), ts:now(), who:p, punishmentId:b.punishmentId, betId:b.id, status:'owed', dueAt:now()+DAY});
  });
  resolvePredictions(b);
  saveDB();
}
const SETTLE_REASON = {
  'first-to-finish':'first to clear the target',
  'highest-fit-score':'highest fit score when the clock ran out',
  'live-finish':'first across the line in a live session',
  'manual':'settled early',
};

/* the clock: first to the target wins outright, otherwise fit score decides */
function checkAutoSettle(silent){
  let changed = 0;
  DB.bets.filter(b=>b.status === 'live').forEach(b=>{
    b.participants.forEach(p=>stampFinish(b, p));
    const finishers = b.participants.filter(p=>progressOf(b, p) >= b.target);
    if(finishers.length){
      finishers.sort((x,y)=>(b.finished[x] || 0) - (b.finished[y] || 0));
      settleBetWith(b, [finishers[0]], b.liveRoom ? 'live-finish' : 'first-to-finish');
      changed++;
    } else if(now() >= b.endsAt){
      settleBetWith(b, [fitRank(b)[0]], 'highest-fit-score');
      changed++;
    }
  });
  if(changed && !silent) renderApp();
  return changed;
}
setInterval(()=>{ if(DB && step === 'app') checkAutoSettle(); }, 30000);

/* ── video proof: recorded live, or a file whose metadata holds up ── */
let proofStream = null, proofRec = null, proofChunks = [], proofStart = 0, proofTimer = null, proofMotion = 0, motionHandler = null;
const MIN_PROOF_SEC = 8;

function proofChecks(meta, b){
  const win = meta.ts >= b.startedAt && meta.ts <= b.endsAt + DAY;
  const fresh = (now() - meta.ts) < 12 * 3600000;
  return [
    {t:'Recorded during this bet', ok:win, s:new Date(meta.ts).toLocaleString()},
    {t:'Captured in the last 12 hours', ok:fresh, s:fresh ? timeAgo(meta.ts) : 'File is older than the window — rejected'},
    {t:'At least ' + MIN_PROOF_SEC + ' seconds long', ok:meta.duration >= MIN_PROOF_SEC, s:Math.round(meta.duration) + 's'},
    {t:meta.source === 'live-capture' ? 'Captured in-app, not uploaded' : 'File metadata read', ok:true,
     s:meta.source === 'live-capture' ? 'Camera stream recorded just now' : (meta.name || 'video file')},
    {t:'Movement detected while recording', ok:meta.motion > 0 || meta.motion === -1,
     s:meta.motion === -1 ? 'Motion sensor unavailable on this device — skipped' : meta.motion + ' movement events'},
  ];
}
function screenProof({id}){
  const b = DB.bets.find(x=>x.id === id);
  if(!b) return appbar('Proof') + emptyState('search','Bet not found','','');
  const m = metricById(b.metricId);
  const mine = proofsFor(b, 'me').length;
  return `<div class="pane">${appbar('Video proof')}
    <div class="pad">
      <div class="card">
        <div class="row"><div class="row-ic" style="background:${b.color}1F">${G(b.emoji)}</div>
          <div class="row-main"><div class="row-t">${escapeHtml(b.title)}</div>
          <div class="row-s">${m.name} · ${progressOf(b,'me').toLocaleString()} / ${b.target.toLocaleString()} ${m.unit} · ${mine} verified ${plural(mine,'clip')}</div></div></div>
        <p class="tagline" style="margin-top:6px">Record the set. The clip has to be captured here and now — the app reads the timestamps and rejects anything from your camera roll that wasn't filmed inside this bet's window.</p>
      </div>
      <div class="cam-stage" id="camStage">
        <div class="cam-off" id="camOff">Camera preview appears here once you start recording.</div>
      </div>
      <div id="proofActions" style="margin-top:14px">
        <button class="btn btn-primary btn-block press" onclick="startProof('${id}')">${ic('video')} Record proof</button>
        <label class="btn btn-ghost btn-block" style="margin-top:9px;cursor:pointer">${ic('upload')} Upload a clip
          <input type="file" accept="video/*" style="display:none" onchange="uploadProof(event,'${id}')"></label>
        <p class="tagline" style="margin-top:12px">Uploads are checked against the file's own recording date. Nothing is sent anywhere — the clip never leaves this device.</p>
      </div>
      <div id="proofResult"></div>
    </div><div style="height:18px"></div></div>`;
}
async function startProof(id){
  const stage = document.getElementById('camStage');
  const actions = document.getElementById('proofActions');
  proofChunks = []; proofMotion = 0;
  try{
    proofStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}, audio:false});
    const v = document.createElement('video');
    v.autoplay = true; v.muted = true; v.playsInline = true; v.srcObject = proofStream;
    stage.innerHTML = ''; stage.appendChild(v);
  }catch(e){
    stage.innerHTML = '<div class="cam-off">Camera unavailable in this browser, so the recorder is running in timed mode. The same timestamp checks still apply.</div>';
  }
  stage.insertAdjacentHTML('beforeend', '<div class="cam-badge"><span class="blip"></span>REC</div><div class="cam-timer" id="camTimer">0:00</div>');
  proofStart = now();
  try{
    if(proofStream && window.MediaRecorder){
      proofRec = new MediaRecorder(proofStream);
      proofRec.ondataavailable = e=>proofChunks.push(e.data);
      proofRec.start();
    }
  }catch(e){ proofRec = null; }
  motionHandler = e=>{
    const a = e.accelerationIncludingGravity || e.acceleration;
    if(a && Math.abs((a.x||0)) + Math.abs((a.y||0)) + Math.abs((a.z||0)) > 14) proofMotion++;
  };
  if(window.DeviceMotionEvent){
    if(typeof DeviceMotionEvent.requestPermission === 'function'){
      try{ if(await DeviceMotionEvent.requestPermission() === 'granted') window.addEventListener('devicemotion', motionHandler); }catch(e){}
    } else window.addEventListener('devicemotion', motionHandler);
  }
  proofTimer = setInterval(()=>{
    const s = Math.floor((now() - proofStart)/1000);
    const el = document.getElementById('camTimer');
    if(el) el.textContent = Math.floor(s/60) + ':' + String(s%60).padStart(2,'0');
    if(s >= 60) stopProof(id);
  }, 250);
  actions.innerHTML = `<button class="btn btn-dark btn-block press" onclick="stopProof('${id}')">${ic('stop')} Stop &amp; verify</button>
    <p class="tagline" style="margin-top:12px">Keep moving — the app watches the motion sensor while it records.</p>`;
}
function stopProof(id){
  const b = DB.bets.find(x=>x.id === id);
  clearInterval(proofTimer); proofTimer = null;
  if(motionHandler){ window.removeEventListener('devicemotion', motionHandler); }
  const duration = (now() - proofStart) / 1000;
  if(proofRec && proofRec.state === 'recording'){ try{ proofRec.stop(); }catch(e){} }
  if(proofStream){ proofStream.getTracks().forEach(t=>t.stop()); proofStream = null; }
  const stage = document.getElementById('camStage');
  if(stage){ stage.querySelectorAll('.cam-badge,.cam-timer').forEach(e=>e.remove()); }
  const meta = {ts:proofStart, duration, source:'live-capture', motion: window.DeviceMotionEvent ? proofMotion : -1};
  showProofResult(b, meta);
}
function uploadProof(ev, id){
  const b = DB.bets.find(x=>x.id === id);
  const f = ev.target.files && ev.target.files[0];
  if(!f) return;
  const url = URL.createObjectURL(f);
  const v = document.createElement('video');
  v.preload = 'metadata';
  v.onloadedmetadata = ()=>{
    const meta = {ts:f.lastModified || 0, duration:v.duration || 0, source:'upload', name:f.name, size:f.size, motion:-1};
    URL.revokeObjectURL(url);
    showProofResult(b, meta);
  };
  v.onerror = ()=>{ toast('That file could not be read as a video', 'x'); };
  v.src = url;
}
function showProofResult(b, meta){
  const checks = proofChecks(meta, b);
  const ok = checks.every(c=>c.ok);
  const m = metricById(b.metricId);
  const credit = m.id === 'workouts' ? 1 : m.id === 'minutes' ? Math.max(1, Math.round(meta.duration/60)) : Math.round(meta.duration);
  document.getElementById('proofActions').innerHTML = '';
  document.getElementById('proofResult').innerHTML = `
    <div class="card" style="margin-top:14px">
      <div class="card-h">${ok ? 'Verified' : 'Rejected'}</div>
      ${checks.map(c=>`<div class="verify-row">
        <span class="vr-ic ${c.ok?'vr-pass':'vr-fail'}">${ic(c.ok?'check':'x')}</span>
        <span class="row-main"><span class="row-t" style="font-size:13.5px">${c.t}</span><span class="row-s">${escapeHtml(String(c.s))}</span></span>
      </div>`).join('')}
      ${ok
        ? `<button class="btn btn-primary btn-block press" style="margin-top:14px" onclick="acceptProof('${b.id}',${meta.ts},${Math.round(meta.duration)},${credit},'${meta.source}')">Log ${credit} ${m.unit} to the bet</button>`
        : `<p class="tagline" style="margin-top:12px">Nothing was credited. Record the set live and it goes straight through.</p>
           <button class="btn btn-ghost btn-block" style="margin-top:10px" onclick="go('proof',{id:'${b.id}'})">Try again</button>`}
    </div>`;
}
function acceptProof(betId, ts, duration, credit, source){
  const b = DB.bets.find(x=>x.id === betId);
  b.proofs = b.proofs || [];
  b.proofs.push({id:uid('pf'), who:'me', ts, duration, source, ok:true});
  b.myProgress = (b.myProgress || 0) + credit;
  stampFinish(b, 'me');
  addXP(30, 'Verified proof');
  if(metricById(b.metricId).id === 'workouts') logWorkout('Verified session', Math.max(20, duration));
  logActivity(`Verified clip logged on <b>${escapeHtml(b.title)}</b>`, 'video', 'progress');
  toast('Proof verified · ' + credit + ' ' + metricById(b.metricId).unit, 'check');
  back();
  checkAutoSettle();
  commit();
}

/* ── live sessions ── */
let liveState = null, liveTick = null, liveMotion = null;
function canGoLive(b){ return b && b.status === 'live' && b.participants.includes('me'); }
function startLive(betId, group){
  const b = DB.bets.find(x=>x.id === betId);
  if(!b) return;
  liveState = {
    betId, group:!!group, startedAt:now(), reps:0, done:false,
    others:b.participants.filter(p=>p !== 'me').map(p=>({id:p, reps:0, done:false, pace: 0.55 + (friendRecord(p).w % 5) * 0.12})),
  };
  b.liveRoom = true;
  go('live', {id:betId});
}
function liveTargetFor(b){
  const m = metricById(b.metricId);
  return m.id === 'workouts' ? 30 : m.id === 'minutes' ? Math.min(20, b.target) : Math.max(20, Math.round(b.target / 10));
}
function screenLive({id}){
  const b = DB.bets.find(x=>x.id === id);
  if(!b || !liveState) return appbar('Live') + emptyState('live','Session ended','','');
  const m = metricById(b.metricId);
  const target = liveTargetFor(b);
  const cells = [{id:'me', reps:liveState.reps, done:liveState.done}, ...liveState.others]
    .sort((x,y)=>y.reps - x.reps);
  return `<div class="pane" style="padding-bottom:20px">
    <div class="appbar"><button class="icon-btn press" onclick="endLive()">${ic('chevL')}</button>
      <h2>${liveState.group ? 'Group live' : 'Live session'}</h2>
      <span class="pill pill-red">${ic('live')} LIVE</span></div>
    <div class="pad">
      <div class="cam-stage" id="liveStage" style="aspect-ratio:16/10;max-height:32vh">
        <div class="cam-off" id="liveOff">Starting camera…</div>
        <div class="cam-badge"><span class="blip"></span>LIVE</div>
        <div class="cam-timer" id="liveTimer">0:00</div>
      </div>
      <div class="card" style="margin-top:14px;text-align:center">
        <div class="row-s">Reps counted by movement</div>
        <div style="font-size:54px;font-weight:800;letter-spacing:-.04em;line-height:1" id="liveCount">${liveState.reps}</div>
        <div class="row-s">of ${target} to finish · ${escapeHtml(b.title)}</div>
        <div class="bar" style="margin-top:12px"><span id="liveBar" data-w="${Math.min(100, Math.round(liveState.reps/target*100))}" style="background:var(--lime-deep)"></span></div>
        <div class="pace"><span id="liveMode">Motion sensor: checking…</span><span id="livePace">0 / min</span></div>
      </div>
      <button class="big-tap" style="margin-top:14px" onclick="liveRep(true)">Count a rep</button>
      <p class="tagline" style="text-align:center;margin-top:8px">Movement is counted automatically where the sensor allows it. The tap is the fallback so the session still works on a laptop.</p>
      <div class="live-grid" id="liveGrid">
        ${cells.map(c=>`<div class="live-cell ${c.id==='me'?'me':''} ${c.done?'done':''}">
          <div class="lc-top"><img src="${personAvatar(c.id)}" alt=""><span class="lc-n">${escapeHtml(personName(c.id))}${c.id==='me'?' (You)':''}</span></div>
          <div class="lc-v">${c.reps}</div><div class="lc-u">${c.done?'finished':'reps'}</div>
        </div>`).join('')}
      </div>
      ${liveState.group ? '' : `<button class="btn btn-ghost btn-block" style="margin-top:14px" onclick="inviteLive()">${ic('users')} Make it a group session</button>`}
      <button class="btn btn-dark btn-block" style="margin-top:9px" onclick="endLive()">End session</button>
    </div></div>`;
}
async function bootLive(){
  const b = DB.bets.find(x=>x.id === liveState.betId);
  const stage = document.getElementById('liveStage');
  try{
    proofStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}, audio:false});
    const v = document.createElement('video');
    v.autoplay = true; v.muted = true; v.playsInline = true; v.srcObject = proofStream;
    stage.insertBefore(v, stage.firstChild);
    const off = document.getElementById('liveOff'); if(off) off.remove();
  }catch(e){
    const off = document.getElementById('liveOff');
    if(off) off.textContent = 'Camera not available here — the session still counts movement and time.';
  }
  let mode = 'Motion sensor: not available — tap to count';
  liveMotion = e=>{
    const a = e.accelerationIncludingGravity || e.acceleration;
    if(!a) return;
    const mag = Math.abs(a.x||0) + Math.abs(a.y||0) + Math.abs(a.z||0);
    if(mag > 26 && now() - (liveState.lastRep||0) > 600){ liveState.lastRep = now(); liveRep(false); }
  };
  if(window.DeviceMotionEvent){
    if(typeof DeviceMotionEvent.requestPermission === 'function'){
      try{ if(await DeviceMotionEvent.requestPermission() === 'granted'){ window.addEventListener('devicemotion', liveMotion); mode = 'Motion sensor: counting'; } }catch(e){}
    } else { window.addEventListener('devicemotion', liveMotion); mode = 'Motion sensor: counting'; }
  }
  const mEl = document.getElementById('liveMode'); if(mEl) mEl.textContent = mode;
  liveTick = setInterval(()=>{
    const s = Math.floor((now() - liveState.startedAt)/1000);
    const t = document.getElementById('liveTimer');
    if(t) t.textContent = Math.floor(s/60) + ':' + String(s%60).padStart(2,'0');
    const p = document.getElementById('livePace');
    if(p) p.textContent = (s ? Math.round(liveState.reps / (s/60)) : 0) + ' / min';
    /* other people in the room move at their own pace (simulated in this prototype) */
    liveState.others.forEach(o=>{ if(!o.done && Math.random() < o.pace * 0.25) o.reps++; });
    paintLive();
  }, 1000);
}
function liveRep(manual){
  if(!liveState || liveState.done) return;
  liveState.reps++;
  if(manual) tick(8);
  paintLive();
}
function paintLive(){
  const b = DB.bets.find(x=>x.id === liveState.betId);
  const target = liveTargetFor(b);
  const c = document.getElementById('liveCount');
  if(c) c.textContent = liveState.reps;
  const bar = document.getElementById('liveBar');
  if(bar) bar.style.width = Math.min(100, Math.round(liveState.reps/target*100)) + '%';
  const grid = document.getElementById('liveGrid');
  if(grid){
    const cells = [{id:'me', reps:liveState.reps, done:liveState.done}, ...liveState.others].sort((x,y)=>y.reps - x.reps);
    grid.innerHTML = cells.map(cl=>`<div class="live-cell ${cl.id==='me'?'me':''} ${cl.done?'done':''}">
      <div class="lc-top"><img src="${personAvatar(cl.id)}" alt=""><span class="lc-n">${escapeHtml(personName(cl.id))}${cl.id==='me'?' (You)':''}</span></div>
      <div class="lc-v">${cl.reps}</div><div class="lc-u">${cl.done?'finished':'reps'}</div></div>`).join('');
  }
  /* first across the line takes it */
  if(liveState.reps >= target && !liveState.done){ liveFinish('me'); return; }
  const other = liveState.others.find(o=>!o.done && o.reps >= target);
  if(other){ liveFinish(other.id); }
}
function liveFinish(who){
  const b = DB.bets.find(x=>x.id === liveState.betId);
  liveState.done = true;
  const target = liveTargetFor(b);
  if(who === 'me'){ b.myProgress = Math.max(b.target, b.myProgress || 0); }
  else { b.progress[who] = Math.max(b.target, b.progress[who] || 0); }
  b.finished = b.finished || {};
  b.finished[who] = now();
  b.proofs = b.proofs || [];
  b.proofs.push({id:uid('pf'), who, ts:now(), duration:(now()-liveState.startedAt)/1000, source:'live-motion', ok:true});
  stopLiveHardware();
  settleBetWith(b, [who], 'live-finish');
  const mine = who === 'me';
  stack.pop();
  renderApp();
  appSheet(mine ? 'You took it' : escapeHtml(personName(who)) + ' took it', `
    <p>${mine ? 'First across the line' : escapeHtml(personName(who)) + ' hit the target first'} — ${target} reps in ${Math.round((now()-liveState.startedAt)/1000)}s, counted by movement.</p>
    <p style="font-size:13px">The winner was assigned automatically from the tracked count, and <b>${escapeHtml(b.title)}</b> settled on the spot.</p>
    <button class="btn btn-primary btn-block" onclick="closeSheet();go('betDetail',{id:'${b.id}'})">See the result</button>`);
  liveState = null;
}
function stopLiveHardware(){
  if(liveTick){ clearInterval(liveTick); liveTick = null; }
  if(liveMotion){ window.removeEventListener('devicemotion', liveMotion); liveMotion = null; }
  if(proofStream){ proofStream.getTracks().forEach(t=>t.stop()); proofStream = null; }
}
function endLive(){
  stopLiveHardware();
  if(liveState){
    const b = DB.bets.find(x=>x.id === liveState.betId);
    if(b && liveState.reps) logActivity(`Live session on <b>${escapeHtml(b.title)}</b> — ${liveState.reps} reps counted`, 'live', 'progress');
    liveState = null;
  }
  back();
}
function inviteLive(){
  if(!liveState) return;
  liveState.group = true;
  toast('Room opened — friends in this bet can drop in', 'users');
  renderApp();
}
function screenLiveHub(){
  const mine = myLiveBets();
  return `<div class="pane">${appbar('Live')}
    <div class="pad">
      <div class="card"><div class="card-h">How live works</div>
        <p class="tagline">Start a session on any bet you're in. Movement is counted while you go, everyone in the room sees the same count, and the first person to hit the session target wins the bet outright — the winner is assigned from the tracked movement, not a self-report.</p>
      </div>
      ${mine.length ? mine.map(b=>`<div class="card">
        <div class="row"><div class="row-ic" style="background:${b.color}1F">${G(b.emoji)}</div>
          <div class="row-main"><div class="row-t">${escapeHtml(b.title)}</div>
          <div class="row-s">Session target ${liveTargetFor(b)} reps · ${b.participants.length} in the room</div></div></div>
        <div style="display:flex;gap:9px;margin-top:12px">
          <button class="btn btn-ghost press" style="flex:1" onclick="startLive('${b.id}',false)">${ic('play')} Solo</button>
          <button class="btn btn-primary press" style="flex:1" onclick="startLive('${b.id}',true)">${ic('users')} Group live</button>
        </div>
      </div>`).join('') : emptyState('live','No bets to go live on','Join or create a bet first, then start a session from here.',
        `<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}
    </div><div style="height:18px"></div></div>`;
}

/* ── Health hub ── */
function screenHealth(){
  const h = health();
  const tracked = DB.bets.filter(b=>b.status === 'live' && b.participants.includes('me') && metricById(b.metricId).health);
  return `<div class="pane">${appbar('Health')}
    <div class="pad">
      <div class="card">
        <div class="row"><div class="row-ic" style="background:var(--lime-soft)">${ic('heart')}</div>
          <div class="row-main"><div class="row-t">${h.provider}</div>
            <div class="row-s">${h.connected ? 'Connected · last sync ' + timeAgo(h.lastSync) : 'Not connected'}</div></div>
          <span class="pill ${h.connected?'pill-green':'pill-grey'}">${h.connected?'On':'Off'}</span></div>
        <p class="tagline" style="margin-top:10px">Distance and step bets read from Health directly. That is not optional — a run bet cannot be created, joined or scored without it, because miles have to come from the device rather than from whoever is claiming them.</p>
        ${h.connected
          ? `<button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="syncNow()">${ic('refresh')} Sync now</button>
             <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="disconnectHealth()">Disconnect</button>`
          : `<button class="btn btn-primary btn-block" style="margin-top:12px" onclick="connectHealth()">${ic('apple')} Connect ${h.provider}</button>`}
      </div>
      <div class="card"><div class="card-h">Auto-tracked bets — ${tracked.length}</div>
        ${tracked.length ? tracked.map(b=>{
          const m = metricById(b.metricId);
          return `<div class="row tap" onclick="go('betDetail',{id:'${b.id}'})"><div class="row-ic" style="background:${b.color}1F">${G(b.emoji)}</div>
            <div class="row-main"><div class="row-t">${escapeHtml(b.title)}</div>
            <div class="row-s">${progressOf(b,'me').toLocaleString()} / ${b.target.toLocaleString()} ${m.unit} from Health</div></div></div>`;
        }).join('') : '<p class="tagline">No distance or step bets running.</p>'}
      </div>
      <div class="card"><div class="card-h">What a web build can do</div>
        <p class="tagline">A browser can't open HealthKit — that needs the native app. This build stands in for it with the same contract: the connection is required, the numbers arrive from the provider rather than being typed in, and every sync is stamped and shown above.</p>
      </div>
    </div><div style="height:18px"></div></div>`;
}
function syncNow(){
  const n = syncHealth();
  toast(n ? 'Synced — ' + n + ' ' + plural(n,'bet') + ' updated' : 'Synced — nothing new', 'refresh');
  checkAutoSettle();
  commit();
}
function requireHealth(afterLabel, after){
  appSheet('Connect Health first', `
    <p>${afterLabel} tracks miles from your Health data. Sharing it is required for distance bets — self-reported mileage doesn't settle a pot.</p>
    <p style="font-size:13px">Steps, workouts and distance are read; nothing is written back, and nothing leaves this device.</p>
    <button class="btn btn-primary btn-block" onclick="closeSheet();connectHealth(()=>{ if(typeof after==='function') after(); })">${ic('apple')} Connect Apple Health</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Not now</button>`);
}


/* ═══════════════ v4 — theme ═══════════════ */
function themePref(){ return (DB && DB.settings && DB.settings.theme) || 'system'; }
function applyTheme(){
  /* dark mode is parked for now — the palette is still in the stylesheet */
  document.documentElement.setAttribute('data-theme', 'light');
}
function setTheme(t){
  DB.settings.theme = t;
  applyTheme();
  toast(t === 'system' ? 'Following your system theme' : t === 'dark' ? 'Dark mode on' : 'Light mode on', t === 'dark' ? 'moon' : 'sun');
  commit();
}
if(window.matchMedia) try{ window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', ()=>{ if(themePref()==='system') applyTheme(); }); }catch(e){}

/* ═══════════════ v4 — header, hero carousel ═══════════════ */
let heroIdx = 0, heroTimer = null;
/* every slide keeps the same shape so the card never resizes mid-transition */
const HERO_SLIDES = [
  {a:'Bet on effort.',   b:'Win together.',     p:'Challenge friends, hit your goals and earn rewards.', cta:'Find a Bet',  act:"setTab('bets')"},
  {a:'Miss a workout.',  b:'Pay the tab.',      p:'Every bet sets its own punishment and its own reward.', cta:'Set stakes', act:"go('punishRules')"},
  {a:'Every rep counts.',b:'Every skip costs.', p:'Verified clips, tracked miles and live sessions.', cta:'Go live',      act:"go('liveHub')"},
];
function heroInner(){
  const s = HERO_SLIDES[heroIdx];
  return `<h2>${s.a}<em>${s.b}</em></h2>
      <p>${s.p}</p>
      <button class="hero-cta press" onclick="${s.act}">${s.cta} ${ic('arrowR')}</button>
      <div class="hero-dots" id="heroDots">
        ${HERO_SLIDES.map((_,i)=>`<button class="${i===heroIdx?'on':''}" aria-label="Slide ${i+1}" onclick="goHero(${i})"></button>`).join('')}
      </div>`;
}
function heroBanner(){
  return `
  <div class="hero" id="heroCard">
    <img class="hero-art" src="${HERO_BANNER}" alt="" draggable="false">
    <div class="hero-in" id="heroText">${heroInner()}</div>
  </div>`;
}
/* only the copy swaps — the characters never move or re-animate */
function goHero(i){
  heroIdx = ((i % HERO_SLIDES.length) + HERO_SLIDES.length) % HERO_SLIDES.length;
  const txt = document.getElementById('heroText');
  if(txt){
    txt.innerHTML = heroInner();
    txt.classList.remove('swap');
    void txt.offsetWidth;
    txt.classList.add('swap');
  }
  startHeroAuto();
}
function startHeroAuto(){
  stopHeroAuto();
  heroTimer = setInterval(()=>{ if(step === 'app' && tab === 'home' && !stack.length && !document.getElementById('sheetLayer').innerHTML) goHero(heroIdx + 1); }, 6000);
}
function stopHeroAuto(){ if(heroTimer){ clearInterval(heroTimer); heroTimer = null; } }
function wireHero(){
  const el = document.getElementById('heroCard');
  if(!el || el.dataset.sw) return;
  el.dataset.sw = '1';
  let x0 = null;
  el.addEventListener('touchstart', e=>{ x0 = e.changedTouches[0].clientX; }, {passive:true});
  el.addEventListener('touchend', e=>{
    if(x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if(Math.abs(dx) > 40) goHero(heroIdx + (dx < 0 ? 1 : -1));
  }, {passive:true});
}

function levelRing(size){
  const lv = levelInfo();
  const S = 48, r = (S - 5) / 2, c = 2 * Math.PI * r;   /* fixed viewBox, scales to its box */
  return `<svg viewBox="0 0 ${S} ${S}" aria-hidden="true">
    <circle cx="${S/2}" cy="${S/2}" r="${r}" stroke="#EFE1D5" stroke-width="3.4" fill="none"/>
    <circle class="arc" cx="${S/2}" cy="${S/2}" r="${r}" stroke="var(--brand)" stroke-width="3.4" fill="none"
      stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${c}" data-dash="${c - c*lv.pct/100}"/></svg>`;
}
function homeHeader(){
  const s = streakDays();
  const unread = unreadCount();
  return `
  <div class="hdr">
    <button class="avatar-ring press" style="width:52px;height:52px" onclick="setTab('profile')" aria-label="Profile">
      ${levelRing(52)}
      <img src="${personAvatar('me')}" alt="" style="width:42px;height:42px">
    </button>
    <div class="hdr-txt" onclick="setTab('profile')">
      <div class="hdr-hi"><span class="hi-t">Welcome back,</span></div>
      <div class="hdr-row">
        <div class="hdr-name">${escapeHtml(DB.account.name || 'Champ')}</div>
        <button class="streak-chip press" onclick="event.stopPropagation();go('streaks')" aria-label="${s} day streak">
          <span class="fl">${ic('flameS')}</span><span class="lbl">${s}</span>
        </button>
      </div>
    </div>
    <div class="wallet-pill">
      <button class="coin press" onclick="go('wallet')" aria-label="Wallet">${ic('dollar')}</button>
      <span class="amt press" onclick="go('wallet')">${money(balance())}</span>
      <button class="add" onclick="moneySheet('deposit')" aria-label="Add funds">${ic('plus')}</button>
    </div>
    <button class="bell press" onclick="go('notifications')" aria-label="Notifications">${ic('bell')}${unread?'<span class="dot"></span>':''}</button>
  </div>`;
}

function tabbarHTML(){
  const unread = unreadCount();
  const t = (id, icon, label, badge) => `<button class="tab ${tab===id&&!stack.length?'on':''}" onclick="setTab('${id}')">
    <span style="position:relative;display:grid;place-items:center">${ic(icon)}${badge?`<span class="tab-badge">${badge}</span>`:''}</span><span>${label}</span></button>`;
  return t('home','home','Home') + t('bets','trophy','Bets')
    + `<div class="fab-wrap"><button class="fab press" onclick="startCreate()" aria-label="Create a bet">${ic('plus')}</button><span class="fab-lbl">Create Bet</span></div>`
    + t('activity','bolt','Activity', unread) + t('profile','user','Profile');
}

/* ═══════════════ v4 — home ═══════════════ */
function makeCard(){
  return `<button class="make-card press" onclick="startCreate()">
    <span class="mk">${ic('plus')}</span><span>Create your own challenge</span></button>`;
}
function betCard(b){
  const joined = b.participants.includes('me');
  const dl = daysLeft(b.endsAt);
  const total = Math.min(7, b.days || 7);
  const elapsed = Math.max(0, Math.min(total, total - dl));
  const o = betOdds(b);
  const m = metricById(b.metricId);
  return `<div class="bet-card">
    <div class="bet-top">
      <div class="bet-emoji" style="background:${b.color}1F;color:${b.color}">${G(b.emoji)}</div>
      ${avStack(b.participants)}
    </div>
    <div onclick="go('betDetail',{id:'${b.id}'})">
      <div class="bet-title">${escapeHtml(b.title)}</div>
      <div class="bet-meta">${money(betPot(b))} Pot &nbsp;•&nbsp; ${dl} ${plural(dl,'day')} left</div>
    </div>
    <div class="bet-odds">
      <span class="lbl">Your odds</span>
      <button class="pill ${o.favorite?'pill-red':'pill-brand'} press" onclick="go('smartOdds')">${o.text}</button>
    </div>
    <div class="pdots">${Array.from({length:total},(_,i)=>`<span class="pdot ${i<elapsed?'on':''}" style="${i<elapsed?`background:${b.color}`:''}"></span>`).join('')}</div>
    ${joined
      ? `<button class="btn-join done neon press" onclick="go('betDetail',{id:'${b.id}'})">${ic('check')} Joined</button>`
      : `<button class="btn-join neon press" onclick="joinSheet('${b.id}')">Join</button>`}
  </div>`;
}
function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  const banners = [];
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    banners.push(`<div class="banner banner-red">
      <div class="b-ic" style="background:#FDECEA;color:#C1341C">${G(p.emoji)}</div>
      <div class="b-main"><div class="b-t">You owe a ${p.name}</div><div class="b-s">${escapeHtml((DB.bets.find(b=>b.id===owed[0].betId)||{}).title||'a bet')} · ${owed[0].dueAt < now() ? 'overdue' : 'due within 24h'}</div></div>
      <button class="b-go press" onclick="go('punishments')">Settle up</button>
    </div>`);
  }
  if(!healthOn() && DB.bets.some(b=>b.status==='live' && metricById(b.metricId).health)){
    banners.push(`<div class="banner banner-info">
      <div class="b-ic" style="background:var(--lime-soft);color:#3F6300">${ic('heart')}</div>
      <div class="b-main"><div class="b-t">Connect Health to run distance bets</div><div class="b-s">Miles have to come from the device, not a self-report.</div></div>
      <button class="b-go press" onclick="go('health')">Connect</button>
    </div>`);
  }
  if(DB.demoSeeded && !DB.demoNoticeSeen){
    banners.push(`<div class="banner banner-info slim">
      <div class="b-ic" style="background:var(--surface-2)">${ic('sparkle')}</div>
      <div class="b-main"><div class="b-t">Demo data loaded — every figure adds up from it</div></div>
      <button class="b-x press" onclick="DB.demoNoticeSeen=true;commit()" aria-label="Dismiss">${ic('x')}</button>
    </div>`);
  }
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${banners.join('')}

    <div class="sec"><h3>Your Overview</h3><button class="link" onclick="go('overview')">View all ${ic('arrowR')}</button></div>
    ${homeStats()}
    <div style="height:12px"></div>
    ${oddsRow()}

    <div class="sec"><h3>Live Bets</h3><button class="link" onclick="setTab('bets')">View all ${ic('arrowR')}</button></div>
    <div class="rail stagger">${live.slice(0,6).map(betCard).join('')}${makeCard()}</div>

    <div class="sec"><h3>This Week</h3><button class="link" onclick="go('challenges')">All challenges</button></div>
    ${weekFeature()}

    <div class="sec"><h3>Your Friends</h3><button class="link" onclick="inviteSheet()">Invite</button></div>
    ${DB.friends.length ? `<div class="rail stagger">
        ${DB.friends.map(friendTile).join('')}
        <button class="friend invite-tile press" onclick="inviteSheet()">
          <div class="friend-av">${ic('userplus')}</div><div class="friend-name">Invite<br>more</div>
        </button>
      </div>`
      : emptyState('users','No friends yet','Bets are better with someone to beat.',`<button class="btn btn-primary" onclick="inviteSheet()">Invite a friend</button>`)}

    <div class="sec"><h3>Explore</h3></div>
    ${hubTiles()}
    <div style="height:14px"></div>
  </div>`;
}
function hubTiles(){
  const lb = leaderboard();
  const rank = lb.findIndex(r=>r.id === 'me') + 1;
  const rec = recovery();
  const preds = openPredictions().length;
  const owed = owedPunishments().length;
  const t = o => `<button class="tile press" onclick="${o.go}">
      <span class="t-ic" style="background:${o.bg};color:${o.fg||'var(--ink)'}">${ic(o.ic)}</span>
      <span class="t-l">${o.label}</span><span class="t-v ${o.hot?'hot':''}">${o.value}</span></button>`;
  return `<div class="tiles stagger">
    ${t({ic:'flameS',   bg:'var(--lime-soft)', fg:'#4C6B00', label:'Streaks',     value:streakDays()+'d', go:"go('streaks')", hot:streakDays()>0})}
    ${t({ic:'live',    bg:'#FDECEA', fg:'#C1341C', label:'Live',        value:myLiveBets().length+' bets', go:"go('liveHub')"})}
    ${t({ic:'dice',    bg:'#F1ECFE', fg:'#6D3FD6', label:'Predictions', value:preds?preds+' open':'Bet now', go:"go('predictions')"})}
    ${t({ic:'crown',   bg:'#FEF3E2', fg:'#9A6212', label:'Leaderboard', value:rank?'#'+rank:'—', go:"go('leaderboard')"})}
    ${t({ic:'brain',   bg:'#EFE9FD', fg:'#6D3FD6', label:'Insights',    value:insights().length+' tips', go:"go('insights')"})}
    ${t({ic:owed?'ghost':'heart', bg:owed?'#FDECEA':'#EAF7EE', fg:owed?'#C1341C':'#2E7D4F',
         label:owed?'Punishments':'Health', value:owed?owed+' owed':(healthOn()?'Synced':'Connect'), go:owed?"go('punishments')":"go('health')", hot:!!owed})}
  </div>`;
}

/* ═══════════════ v4 — bet detail with verification, lock and live ═══════════════ */
function screenBetDetail({id}){
  const b = DB.bets.find(x=>x.id === id);
  if(!b) return appbar('Bet') + emptyState('search','Bet not found','It may have been cleared with the demo data.','');
  const m = metricById(b.metricId);
  const pun = punishmentById(b.punishmentId), rew = rewardById(b.rewardId);
  const joined = b.participants.includes('me');
  const settled = b.status === 'settled';
  const iWon = settled && b.winners.includes('me');
  const dl = daysLeft(b.endsAt);
  const needsHealth = m.health && !healthOn();
  const rows = fitRank(b).map(pid=>{
    const prog = progressOf(b, pid);
    const pct = Math.min(100, Math.round(prog / b.target * 100));
    const won = settled && b.winners.includes(pid);
    const fin = b.finished && b.finished[pid];
    return `<div class="row"><img class="av" src="${personAvatar(pid)}" style="width:38px;height:38px;border-radius:50%">
      <div class="row-main"><div class="row-t">${escapeHtml(personName(pid))}${pid==='me'?' (You)':''}
        ${won?'<span class="pill pill-green" style="margin-left:6px">Won</span>':''}
        ${fin&&!settled?'<span class="pill pill-green" style="margin-left:6px">Finished</span>':''}</div>
      <div class="bar" style="margin-top:7px"><span data-w="${pct}" style="background:${b.color}"></span></div>
      <div class="row-s">${prog.toLocaleString()} / ${b.target.toLocaleString()} ${m.unit} · fit score ${fitScore(b,pid)}</div></div></div>`;
  }).join('');
  return `<div class="pane">
    ${appbar(escapeHtml(b.title))}
    <div class="pad">
      <div class="card">
        <div style="display:flex;gap:14px;align-items:center">
          <div class="bet-emoji" style="background:${b.color}1F;color:${b.color};width:56px;height:56px">${G(b.emoji)}</div>
          <div style="flex:1">
            <div style="font-size:26px;font-weight:800;letter-spacing:-.03em">${money(betPot(b))}</div>
            <div class="row-s">Pot · ${money(b.stake)} each · ${b.participants.length} ${plural(b.participants.length,'player')}</div>
          </div>
          ${settled ? `<span class="pill ${iWon?'pill-green':'pill-red'}">${iWon?'You won':'You lost'}</span>`
                    : `<span class="pill pill-amber">${dl} ${plural(dl,'day')} left</span>`}
        </div>
        <div class="row" style="margin-top:14px"><div class="row-ic" style="background:${b.color}1F;color:${b.color}">${G(m.emoji)}</div>
          <div class="row-main"><div class="row-t">${m.name}</div><div class="row-s">First to ${b.target.toLocaleString()} ${m.unit} wins it outright</div></div></div>
        <div class="row"><div class="row-ic" style="background:var(--surface-2)">${ic(m.verify==='health'?'heart':m.verify==='video'?'video':'check')}</div>
          <div class="row-main"><div class="row-t">Scored by ${VERIFY_LABEL[m.verify]}</div>
          <div class="row-s">${m.verify==='health'?'Distance and steps read from Health — self-reporting is off':m.verify==='video'?'Every log needs a clip recorded inside the bet window':'One check-in a day, backed by your workout log'}</div></div></div>
        <div class="row"><div class="row-ic" style="background:var(--surface-2)">${ic('lock')}</div>
          <div class="row-main"><div class="row-t">Runs ${b.days} days · locked</div>
          <div class="row-s">Ends ${new Date(b.endsAt).toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'})}. The length was fixed when the bet was created and can't be changed.</div></div></div>
        <div class="row"><div class="row-ic" style="background:#FDECEA;color:#C1341C">${G(pun.emoji)}</div>
          <div class="row-main"><div class="row-t">Lose · ${pun.name}</div><div class="row-s">${pun.desc}</div></div></div>
        <div class="row"><div class="row-ic" style="background:var(--lime-soft);color:#3F6300">${G(rew.emoji)}</div>
          <div class="row-main"><div class="row-t">Win · ${rew.name}</div><div class="row-s">${rew.desc}</div></div></div>
      </div>

      <div class="card"><div class="card-h">Standings — by fit score</div>${rows}
        <p class="tagline" style="margin-top:10px">Clear the target first and the bet settles on the spot. If the clock runs out with nobody there, the highest fit score takes the pot — progress, verified clips and how consistently you showed up.</p>
      </div>

      ${!settled ? `<div class="card">
        <div class="card-h">Your move</div>
        ${needsHealth ? `<div class="gate"><div class="g-ic">${ic('heart')}</div>
            <div><div class="g-t">Health connection required</div>
            <div class="g-s">This bet is scored on ${m.unit}. Connect Apple Health and it tracks itself.</div></div></div>
          <button class="btn btn-primary btn-block press" style="margin-top:12px" onclick="connectHealth()">${ic('apple')} Connect Health</button>`
        : joined ? `
          ${m.verify === 'video'
            ? `<button class="btn btn-primary btn-block press" onclick="go('proof',{id:'${b.id}'})">${ic('video')} Log with video proof</button>`
            : m.verify === 'health'
            ? `<button class="btn btn-primary btn-block press" onclick="syncNow()">${ic('refresh')} Sync Health now</button>`
            : `<button class="btn btn-primary btn-block press" onclick="logSheet('${b.id}')">${ic('check')} Daily check-in</button>`}
          <button class="btn btn-dark btn-block press" style="margin-top:9px" onclick="startLive('${b.id}',false)">${ic('live')} Start a live session</button>
          <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="leaveBet('${b.id}')">Leave &amp; refund my ${money(b.stake)}</button>`
        : `<button class="btn btn-primary btn-block press" onclick="joinSheet('${b.id}')">Join for ${money(b.stake)}</button>`}
      </div>

      ${(b.proofs||[]).length ? `<div class="card"><div class="card-h">Verified activity</div>
        ${b.proofs.slice().reverse().map(p=>`<div class="verify-row">
          <span class="vr-ic vr-pass">${ic(p.source==='live-motion'?'live':'video')}</span>
          <span class="row-main"><span class="row-t" style="font-size:13.5px">${escapeHtml(personName(p.who))} · ${Math.round(p.duration)}s</span>
          <span class="row-s">${p.source==='live-motion'?'Counted by movement in a live session':'Clip verified'} · ${timeAgo(p.ts)}</span></span></div>`).join('')}
      </div>` : ''}`
      : `<div class="card"><div class="card-h">Result</div>
        <p class="tagline">${b.winners.map(w=>escapeHtml(personName(w))).join(', ')} took ${money(payoutFor(b))} — ${SETTLE_REASON[b.settleReason] || 'settled'}. ${iWon ? `You banked ${money(payoutFor(b) - b.stake)} on top of your stake.` : `You owed a ${pun.name}.`}</p></div>`}
    </div>
    <div style="height:18px"></div>
  </div>`;
}

/* health gate on joining */
function joinSheet(id){
  const b = DB.bets.find(x=>x.id === id);
  const m = metricById(b.metricId);
  if(m.health && !healthOn()) return requireHealth(escapeHtml(b.title), ()=>joinSheet(id));
  appSheet('Join ' + escapeHtml(b.title), `
    <p>${m.name}: first to <b>${b.target.toLocaleString()} ${m.unit}</b> inside ${daysLeft(b.endsAt)} days takes the pot. Lose and you owe <b>${punishmentById(b.punishmentId).name}</b>.</p>
    <div class="gate"><div class="g-ic">${ic(m.verify==='health'?'heart':m.verify==='video'?'video':'check')}</div>
      <div><div class="g-t">Scored by ${VERIFY_LABEL[m.verify]}</div>
      <div class="g-s">${m.verify==='video'?'Each log needs a clip recorded inside the bet window.':m.verify==='health'?'Miles come from Health — nothing self-reported.':'One check-in a day against your workout log.'}</div></div></div>
    <div class="field"><label>Your stake</label>
      <div class="money-wrap"><span class="cur">$</span><input class="inp" id="joinStake" type="number" inputmode="decimal" min="1" value="${b.stake}" oninput="syncJoin('${id}')"></div>
      <div class="hint" id="joinHint">Pot becomes ${money(betPot(b) + b.stake)} · you have ${money(balance())}</div>
    </div>
    <button class="btn btn-primary btn-block" id="joinGo" style="margin-top:16px" onclick="doJoin('${id}')">Put ${money(b.stake)} in</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Cancel</button>`);
}

/* create flow: health gate + the duration lock */
function createTarget(){
  const m = metricById(draft.metricId);
  return `<div class="field"><label>Target — ${m.unit}</label>
      <input class="inp" id="cTarget" type="number" inputmode="numeric" value="${draft.target}" oninput="draft.target=parseInt(this.value)||0">
      <div class="hint">First person to clear this wins the pot outright.</div>
    </div>
    <div class="field"><label>How long?</label>
      <div class="seg">${[3,7,14,30].map(n=>`<button class="${draft.days===n?'on':''}" onclick="draft.days=${n};renderApp()">${n} days</button>`).join('')}</div>
      <div class="locked-note">${ic('lock')} Locked once the bet is created — nobody can move the finish line.</div>
      <div class="hint">Ends ${new Date(now()+draft.days*DAY).toLocaleDateString(undefined,{weekday:'long', month:'short', day:'numeric'})}. If nobody clears the target by then, the highest fit score wins.</div>
    </div>
    ${m.health ? `<div class="gate"><div class="g-ic">${ic('heart')}</div>
      <div><div class="g-t">${healthOn()?'Health connected':'Health connection required'}</div>
      <div class="g-s">${m.name} is tracked from Apple Health. ${healthOn()?'Miles will sync automatically.':'You have to connect it before this bet can be created.'}</div></div></div>
      ${healthOn()?'':`<button class="btn btn-primary btn-block press" style="margin-top:10px" onclick="connectHealth()">${ic('apple')} Connect Health</button>`}` : ''}`;
}
function submitCreate(){
  const m = metricById(draft.metricId);
  if(m.health && !healthOn()) return requireHealth(m.name + ' bets', ()=>submitCreate());
  if(draft.stake > balance()){ toast('Not enough in your wallet for that stake', 'x'); return; }
  const bet = createBet(draft);
  bet.locked = true;
  bet.verify = m.verify;
  bet.finished = {};
  bet.proofs = [];
  saveDB();
  stack = [];
  tab = 'home';
  go('betDetail', {id:bet.id});
}
function logSheet(id){
  const b = DB.bets.find(x=>x.id === id);
  const m = metricById(b.metricId);
  if(m.verify === 'video') return go('proof', {id});
  if(m.verify === 'health'){ syncNow(); return; }
  appSheet('Daily check-in', `
    <p>${escapeHtml(b.title)} · day ${Math.max(1, Math.ceil((now()-b.startedAt)/DAY))} of ${b.days}. Checking in logs a workout against your streak too.</p>
    <button class="btn btn-primary btn-block" onclick="closeSheet();checkIn('${id}')">${ic('check')} I did it today</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Not yet</button>`);
}
function checkIn(id){
  const b = DB.bets.find(x=>x.id === id);
  b.myProgress = (b.myProgress || 0) + 1;
  stampFinish(b, 'me');
  logWorkout('Check-in', 40);
  logActivity(`Checked in on <b>${escapeHtml(b.title)}</b>`, 'check', 'progress');
  toast('Checked in', 'check');
  checkAutoSettle();
  commit();
}

/* appearance controls live in Settings */
function appearanceCard(){ return ''; }
function appearanceCardOff(){
  const p = themePref();
  return `<div class="card"><div class="card-h">Appearance</div>
    <div class="seg">${[['light','Light'],['dark','Dark'],['system','System']].map(([k,l])=>
      `<button class="${p===k?'on':''}" onclick="setTheme('${k}')">${l}</button>`).join('')}</div>
    <p class="tagline" style="margin-top:10px">Dark mode repaints the whole app, onboarding included. System follows your phone.</p>
  </div>`;
}


/* ═════════ v5 home — the mockup, section for section ═════════ */
function homeHeader(){
  const s = streakDays();
  const unread = unreadCount();
  return `
  <div class="hdr">
    <button class="avatar-ring press" style="width:48px;height:48px" onclick="setTab('profile')" aria-label="Profile">
      ${levelRing(48)}<img src="${personAvatar('me')}" alt="" style="width:39px;height:39px">
    </button>
    <div class="hdr-txt" onclick="setTab('profile')">
      <div class="hdr-hi"><span class="hi-t">Welcome back,</span></div>
      <div class="hdr-row">
        <div class="hdr-name">${escapeHtml(DB.account.name || 'Champ')}</div>
        <button class="streak-chip press" onclick="event.stopPropagation();go('streaks')" aria-label="${s} day streak">
          <span class="fl">${ic('flameS')}</span><span class="lbl">${s}</span><span class="lbl-long"> day streak</span>
        </button>
      </div>
    </div>
    <div class="wallet-pill">
      <button class="coin press" onclick="go('wallet')" aria-label="Wallet">${ic('dollar')}</button>
      <span class="amt press" onclick="go('wallet')">${money(balance())}</span>
      <button class="add" onclick="moneySheet('deposit')" aria-label="Add funds">${ic('plus')}</button>
    </div>
    <button class="bell press" onclick="go('notifications')" aria-label="Notifications">${ic('bell')}${unread?'<span class="dot"></span>':''}</button>
  </div>`;
}

function oddsCard(){
  const tier = myTier();
  const rate = settledMine().length ? winRate() : 50;
  return `<div class="odds-card">
    <div class="odds-head">
      <div style="flex:1;min-width:0">
        <h4>Your Smart Odds <button class="help-dot press" onclick="event.stopPropagation();oddsHelp()" aria-label="How odds work">?</button></h4>
        <p>Odds adjust based on your performance and consistency.</p>
      </div>
      <span class="pill pill-green odds-rate">Win rate: ${rate}% ${ic('trendS')}</span>
    </div>
    <div class="odds-strip">
      ${ODDS_TIERS.map(t=>`<button class="odds-tier ${t.id===tier.id?'on':''} press" onclick="go('smartOdds')">
        <div class="t-name">${t.name}</div>
        <div class="t-range">${t.lo} - ${t.hi}${t.hi===100?'%+':'%'}</div>
        <div class="t-odds" style="color:${t.color}">${t.odds}</div>
        <div class="t-note" style="color:${t.id===tier.id?'var(--brand)':'var(--ink-faint)'}">${t.id===tier.id?(t.note||'You are here'):t.note}</div>
      </button>`).join('')}
    </div>
    <div class="odds-foot">${ic('star')} Keep winning to improve your odds and unlock bigger challenges!</div>
  </div>`;
}

function friendsPanel(){
  return `<div class="panel">
    <div class="panel-h"><h4>Friends</h4><button class="link press" onclick="inviteSheet()">Invite</button></div>
    <div class="friends-strip">
      ${DB.friends.map(friendTile).join('')}
      <button class="friend invite-tile press" onclick="inviteSheet()">
        <div class="friend-av">${ic('plus')}</div><div class="friend-name" style="color:var(--brand)">Invite<br>more</div>
      </button>
    </div>
  </div>`;
}
function leaderboardPanel(){
  const rows = leaderboard().slice(0,3);
  return `<div class="panel lb-mini">
    <div class="panel-h"><h4>Leaderboard</h4>
      <button class="pill pill-grey press" onclick="go('leaderboard')">This ${lbRange==='week'?'week':lbRange==='month'?'month':'season'} ${ic('chevR')}</button></div>
    ${rows.length ? rows.map((r,i)=>lbRow(r,i)).join('') : '<p class="tagline">Settle a bet to get on the board.</p>'}
    <button class="hub-cta press" style="margin-top:10px" onclick="go('leaderboard')">View full leaderboard</button>
  </div>`;
}


function insightPanel(){
  const list = insights();
  const top = list[0];
  return `<div class="card" style="margin:0 16px">
    <div class="panel-h" style="margin-bottom:6px">
      <h4>AI Insights</h4>
      <button class="link press" onclick="go('insights')">View all ${ic('arrowR')}</button>
    </div>
    <div class="hub-s" style="margin:0 0 12px">Patterns pulled from your own log.</div>
    <div class="insight-box">
      <div class="txt">${top.tag?`<div class="insight-tag">${top.tag}</div>`:''}${top.text}</div>
      <div class="brain">${ic('brain')}</div>
    </div>
    <button class="hub-cta press" onclick="${top.cta.action}">${top.cta.label}</button>
    <div class="row-s" style="text-align:center;margin-top:9px">${list.length} ${plural(list.length,'insight')} waiting</div>
  </div>`;
}


function botArt(){
  return `<img class="coach-bot" src="${COACH_BOT}" alt="" draggable="false">`;
}
function aiCoachCard(){
  const list = insights();
  const top = list[0];
  return `<div class="card">
    <div class="hub-t">AI Coach</div>
    <div class="hub-s">Personalized tips to help you win.</div>
    <div class="coach-art">
      <div class="coach-copy">${top.tag ? '<span class="insight-tag">'+top.tag+'</span><br>' : ''}${top.text.replace(/<[^>]+>/g,'').slice(0,72)}…</div>
      ${botArt()}
    </div>
    <button class="hub-cta press" onclick="go('insights')">View Insights</button>
  </div>`;
}
function recoveryCard(){
  const r = recovery();
  return `<div class="card">
    <div class="hub-t">Recovery Score</div>
    <div class="hub-s">Ready to perform?</div>
    <div class="rec-grid">
      <div class="ring" style="width:76px;height:76px">${ringSVG(r.score, r.color, 76, 8)}
        <div class="rv"><b>${r.score}</b><span>${r.label}</span></div></div>
      <div class="rec-vits">
        <div class="vit-row"><span class="k">Sleep</span><span class="v">${r.sleep}</span></div>
        <div class="vit-row"><span class="k">Fatigue</span><span class="v" style="color:${fatigueColor(r.fatigue)}">${r.fatigue}</span></div>
        <div class="vit-row"><span class="k">HRV</span><span class="v">${r.hrv}</span></div>
      </div>
    </div>
    <button class="hub-cta press" onclick="go('recovery')">Tips to improve</button>
  </div>`;
}
function communityCard(){
  const ev = communityEvents(2);
  return `<div class="card">
    <div class="hub-t">Community Feed</div>
    <div class="hub-s">See what's happening.</div>
    <div style="flex:1">
      ${ev.length ? ev.map(e=>{
        const rc = reactionOf(e.id);
        return `<div class="feed2"><img src="${personAvatar(e.who)}" alt="">
          <div class="f2m"><div class="f2t">${e.text}</div><div class="f2s">${timeAgo(e.ts)}</div></div>
          <div class="f2c">
            <button class="f2chip press" onclick="go('community')">${ic('comment')} ${(e.id.length%9)+4}</button>
            <button class="f2chip ${rc.mine?'hot':''} press" onclick="react('${e.id}')">${ic('flameS')} ${rc.n}</button>
          </div></div>`;
      }).join('') : '<p class="tagline">Invite a friend and the feed fills up.</p>'}
    </div>
    <button class="hub-cta press" onclick="go('community')">View Calendar</button>
  </div>`;
}



function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  const banners = [];
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    banners.push(`<div class="banner banner-red">
      <div class="b-ic" style="background:#FDECEA;color:#C1341C">${G(p.emoji)}</div>
      <div class="b-main"><div class="b-t">You owe a ${p.name}</div><div class="b-s">${escapeHtml((DB.bets.find(b=>b.id===owed[0].betId)||{}).title||'a bet')} · ${owed[0].dueAt < now() ? 'overdue' : 'due within 24h'}</div></div>
      <button class="b-go press" onclick="go('punishments')">Settle up</button></div>`);
  }
  if(!healthOn() && DB.bets.some(b=>b.status==='live' && metricById(b.metricId).health)){
    banners.push(`<div class="banner banner-info slim">
      <div class="b-ic" style="background:var(--lime-soft);color:#3F6300">${ic('heart')}</div>
      <div class="b-main"><div class="b-t">Connect Health to score distance bets</div></div>
      <button class="b-go press" onclick="go('health')">Connect</button></div>`);
  }
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${banners.join('')}

    <div class="sec"><h3>Your Overview</h3><button class="link press" onclick="go('overview')">View all ${ic('arrowR')}</button></div>
    ${homeStats()}

    <div style="height:14px"></div>
    ${oddsCard()}

    <div class="sec"><h3>Live Bets</h3><button class="link press" onclick="setTab('bets')">View all ${ic('arrowR')}</button></div>
    <div class="rail stagger">${live.slice(0,6).map(betCard).join('')}${makeCard()}</div>

    <div class="rail stagger" style="margin-top:12px;align-items:stretch">
      ${challengeHubCard()}
      ${streakHubCard()}
      ${predictionHubCard()}
    </div>

    <div class="pair stagger" style="margin-top:12px">
      ${friendsPanel()}
      ${leaderboardPanel()}
    </div>


    <div class="trio stagger" style="margin-top:12px">
      ${aiCoachCard()}
      ${recoveryCard()}
      ${communityCard()}
    </div>
    <div style="height:6px"></div>
  </div>`;
}

/* ═════════ home, grouped into framed sections ═════════ */
function frameHead(title, sub, linkLabel, linkAction){
  return `<div class="frame-h">
    <div><h3>${title}</h3>${sub?`<div class="sub">${sub}</div>`:''}</div>
    ${linkLabel?`<button class="link press" onclick="${linkAction}">${linkLabel} ${ic('arrowR')}</button>`:''}
  </div>`;
}
function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  /* only the single most urgent thing gets space up top */
  let alert = '';
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    alert = `<button class="alert-strip press" onclick="go('punishments')">
      <span class="a-ic">${G(p.emoji)}</span>
      <span class="a-t">${p.name} owed${owed[0].dueAt < now() ? ' · overdue' : ''}</span>
      <span class="a-go">Settle up ${ic('arrowR')}</span></button>`;
  } else if(!healthOn() && DB.bets.some(b=>b.status==='live' && metricById(b.metricId).health)){
    alert = `<button class="alert-strip info press" onclick="go('health')">
      <span class="a-ic">${ic('heart')}</span>
      <span class="a-t">Connect Health for distance bets</span>
      <span class="a-go">Connect ${ic('arrowR')}</span></button>`;
  }
  const alerts = [alert];
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${alerts.join('')}

    <section class="frame">
      ${frameHead('Your Overview', 'Everything you have on the board', 'View all', "go('overview')")}
      ${homeStats()}
      <div class="frame-divider"></div>
      ${oddsCard()}
    </section>

    <section class="frame">
      ${frameHead('Live Bets', live.length + ' running now', 'View all', "setTab('bets')")}
      <div class="rail stagger">${live.slice(0,6).map(betCard).join('')}${makeCard()}</div>
    </section>

    <section class="frame">
      ${frameHead('Compete', 'This week’s challenge, your streak and open calls', 'Challenges', "go('challenges')")}
      <div class="rail stagger" style="align-items:stretch">
        ${challengeHubCard()}
        ${streakHubCard()}
        ${predictionHubCard()}
      </div>
    </section>

    <section class="frame">
      ${frameHead('Your Crew', DB.friends.length + ' friends · you are #' + (leaderboard().findIndex(r=>r.id==='me')+1), 'Invite', 'inviteSheet()')}
      <div class="pair stagger">
        ${friendsPanel()}
        ${leaderboardPanel()}
      </div>
    </section>

    <section class="frame">
      ${frameHead('Coaching', 'Read from your own log', 'Insights', "go('insights')")}
      <div class="trio stagger">
        ${aiCoachCard()}
        ${recoveryCard()}
        ${communityCard()}
      </div>
    </section>
    <div style="height:6px"></div>
  </div>`;
}

/* ═════════ Profile — laid out to the design ═════════ */
function pStat(o){
  return `<button class="p-stat press" onclick="${o.go}">
    <span class="p-stat-ic" style="background:${o.bg};color:${o.fg}">${ic(o.icon)}</span>
    <span class="p-stat-main">
      <span class="p-stat-v">${o.value}</span>
      <span class="p-stat-l">${o.label}</span>
      ${o.note ? `<span class="p-stat-n" style="color:${o.noteColor||'var(--brand)'}">${o.note}</span>` : ''}
    </span>
  </button>`;
}
function pRow(o){
  return `<button class="p-row press" onclick="${o.go}">
    <span class="p-row-ic" style="background:${o.bg};color:${o.fg}">${ic(o.icon)}</span>
    <span class="p-row-main"><span class="p-row-t">${o.title}</span><span class="p-row-s">${o.sub}</span></span>
    ${ic('chevR','p-chev')}
  </button>`;
}
function screenProfile(){
  const lv = levelInfo();
  const s = streakDays();
  const joined = new Date(DB.createdAt).toLocaleDateString(undefined,{month:'short', year:'numeric'});
  const acct = DB.account.provider ? DB.account.provider + ' account' : (DB.account.email || 'this device');
  return `<div class="pane p-page">
    <div class="p-head">
      <div><h1 class="p-title">Profile</h1><span class="p-rule"></span></div>
      <button class="p-gear press" onclick="go('settings')" aria-label="Settings">${ic('settings')}</button>
    </div>

    <div class="p-id">
      <img class="p-avatar" src="${personAvatar('me')}" alt="">
      <div class="p-id-main">
        <h2>${escapeHtml(DB.account.name || 'You')}</h2>
        <div class="p-sub">${escapeHtml(acct)} · joined ${joined}</div>
        <button class="p-streak press" onclick="go('streaks')">${ic('flameS')} ${s} day streak</button>
      </div>
    </div>

    <button class="p-level press" onclick="go('overview')">
      <div class="p-level-top">
        <span class="p-level-t">Level ${lv.level} <span class="dotsep">·</span> ${lv.title}</span>
        <span class="p-level-xp">${lv.into} / ${lv.span} XP</span>
      </div>
      <div class="p-level-bar"><span data-w="${lv.pct}"></span></div>
      <span class="p-badge"><img src="${RUNNER_MARK}" alt="" class="p-badge-mark"></span>
    </button>

    <div class="p-grid">
      ${pStat({icon:'trendS', bg:'#FFEDE1', fg:'#F2620F', value:`${betsWon()}–${betsLost()}`, label:'Record',
               note:`${winRate()}% wins`, go:"go('betHistory')"})}
      ${pStat({icon:'dollarS', bg:'#E8F7E4', fg:'#1F8A3B', value:money(winningsNet()), label:'Net winnings', go:"go('wallet')"})}
      ${pStat({icon:'flameS', bg:'#F1EAFE', fg:'#7C3AED', value:s, label:'Day streak',
               note:`${workoutsThisWeek()} workouts this week`, noteColor:'var(--ink-muted)', go:"go('streaks')"})}
      ${pStat({icon:'shield', bg:'#E6F0FE', fg:'#2563EB', value:servedPunishments().length, label:'Punishments served', go:"go('punishments')"})}
    </div>

    <div class="p-menu">
      ${pRow({icon:'chart', bg:'#FFEDE1', fg:'#F2620F', title:'Your Overview', sub:'Metrics, punishments and rewards', go:"go('overview')"})}
      ${pRow({icon:'ghost', bg:'#F1EAFE', fg:'#7C3AED', title:'Punishment rules', sub:'What friends can use against you', go:"go('punishRules')"})}
      ${pRow({icon:'wallet', bg:'#E8F7E4', fg:'#1F8A3B', title:'Wallet', sub:money(balance()) + ' available', go:"go('wallet')"})}
      ${pRow({icon:'dumbbellS', bg:'#E6F0FE', fg:'#2563EB', title:'Fitness profile', sub:'Goal, workouts and interests', go:"go('editProfile')"})}
      ${pRow({icon:'bell', bg:'#FEF3E0', fg:'#D9880B', title:'Notifications', sub:'Choose what pings you', go:"go('settings')"})}
      ${pRow({icon:'heart', bg:'#FDE9EC', fg:'#D93E5C', title:'Health', sub:healthOn() ? 'Connected' : 'Not connected', go:"go('health')"})}
      ${pRow({icon:'live', bg:'#FFE9E4', fg:'#E2571B', title:'Live sessions', sub:'Start or join a live workout', go:"go('liveHub')"})}
      ${pRow({icon:'sparkle', bg:'#EFEFF4', fg:'#5B5B66', title:'Demo data', sub:DB.demoSeeded ? 'Loaded' : 'Not loaded', go:"go('demoData')"})}
      ${pRow({icon:'logout', bg:'#EFEFF4', fg:'#5B5B66', title:'Sign out', sub:'Keeps your account and history', go:'signOut()'})}
    </div>
    <p class="tagline" style="margin:12px 18px 0;text-align:center">Avatars are generated from initials — no stock photos of real people.</p>
    <div style="height:10px"></div>
  </div>`;
}

/* ═══════════════════════════════════════════════════════════
   Motion system — modelled on Apple's UI conventions:
   real damped springs rather than bezier easing, SF Symbol-style
   effects (bounce / pulse / wiggle / replace / breathe), and the
   press-scale feedback iOS uses instead of a Material ripple.
   ═══════════════════════════════════════════════════════════ */

/* A spring solved and sampled into a CSS linear() easing, the same
   response / damping-ratio parameters SwiftUI exposes. */
function springEasing(response, damping, steps){
  steps = steps || 44;
  const w0 = 2 * Math.PI / response;
  const z = damping;
  const wd = w0 * Math.sqrt(Math.max(0.0001, 1 - z*z));
  /* sample only as long as the spring needs to settle — iOS motion is quick */
  const dur = response * (z < 1 ? 1.55 : 1.05);
  const pts = [];
  for(let i = 0; i <= steps; i++){
    const t = (i / steps) * dur;
    let y;
    if(z < 1) y = 1 - Math.exp(-z*w0*t) * (Math.cos(wd*t) + (z*w0/wd) * Math.sin(wd*t));
    else      y = 1 - Math.exp(-w0*t) * (1 + w0*t);
    pts.push(Math.round(y * 10000) / 10000);
  }
  pts[pts.length-1] = 1;
  return {easing:'linear(' + pts.join(',') + ')', duration:Math.round(dur * 1000)};
}

const SPRING = {
  /* response / damping-ratio pairs matching SwiftUI's built-in springs */
  smooth: springEasing(0.36, 1.00),   /* no overshoot — layout, bars, rings   */
  snappy: springEasing(0.30, 0.86),   /* slight overshoot — presses and taps  */
  bouncy: springEasing(0.34, 0.72),   /* visible overshoot — symbol effects   */
};
const REDUCED = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

(function installSprings(){
  const ok = window.CSS && CSS.supports && CSS.supports('animation-timing-function', 'linear(0,1)');
  const r = document.documentElement.style;
  if(ok){
    r.setProperty('--ios-smooth', SPRING.smooth.easing);
    r.setProperty('--ios-snappy', SPRING.snappy.easing);
    r.setProperty('--ios-bouncy', SPRING.bouncy.easing);
  } else {                       /* closest fixed curves where linear() is unsupported */
    r.setProperty('--ios-smooth', 'cubic-bezier(.32,.72,0,1)');
    r.setProperty('--ios-snappy', 'cubic-bezier(.25,.9,.25,1.06)');
    r.setProperty('--ios-bouncy', 'cubic-bezier(.2,1.24,.34,1)');
  }
  r.setProperty('--ios-smooth-ms', SPRING.smooth.duration + 'ms');
  r.setProperty('--ios-snappy-ms', SPRING.snappy.duration + 'ms');
  r.setProperty('--ios-bouncy-ms', SPRING.bouncy.duration + 'ms');
})();

/* ── SF Symbol-style effects ───────────────────────────────── */
function symbolEffect(el, kind){
  if(!el || REDUCED || !el.animate) return;
  const s = SPRING.bouncy;
  const opts = {duration:s.duration, easing:s.easing, fill:'none'};
  if(kind === 'bounce'){
    el.animate([{transform:'scale(1)'}, {transform:'scale(1.24)', offset:.32}, {transform:'scale(1)'}], opts);
  } else if(kind === 'pulse'){
    el.animate([{opacity:1}, {opacity:.35, offset:.4}, {opacity:1}], {duration:520, easing:'ease-in-out'});
  } else if(kind === 'wiggle'){
    el.animate([{transform:'rotate(0deg)'}, {transform:'rotate(-11deg)', offset:.25},
                {transform:'rotate(9deg)', offset:.6}, {transform:'rotate(0deg)'}], opts);
  } else if(kind === 'breathe'){
    el.animate([{transform:'scale(1)', opacity:1}, {transform:'scale(1.07)', opacity:.82, offset:.5},
                {transform:'scale(1)', opacity:1}], {duration:2600, easing:'ease-in-out', iterations:Infinity});
  } else if(kind === 'jump'){
    el.animate([{transform:'translateY(0) scale(1)'}, {transform:'translateY(-4px) scale(1.14)', offset:.35},
                {transform:'translateY(0) scale(1)'}], opts);
  }
}
/* icon swap, the way SF Symbols .replace crossfades one glyph for another */
function symbolReplace(el, nextSVG){
  if(!el) return;
  if(REDUCED || !el.animate){ el.innerHTML = nextSVG; return; }
  const s = SPRING.snappy;
  el.animate([{opacity:1, transform:'scale(1)'}, {opacity:0, transform:'scale(.72)'}],
             {duration:130, easing:'ease-in', fill:'forwards'}).onfinish = () => {
    el.innerHTML = nextSVG;
    el.animate([{opacity:0, transform:'scale(1.3)'}, {opacity:1, transform:'scale(1)'}],
               {duration:s.duration, easing:s.easing, fill:'none'});
    el.style.opacity = ''; el.style.transform = '';
  };
}

/* ── press feedback: scale in on touch, spring back on release ── */
const PRESSABLE = '.press,.btn,.hub-cta,.btn-join,.tab,.fab,.chip-x,.opt,.quick button,.seg button,.b-go,.link,' +
  '.icon-btn,.react,.odds-tier,.row.tap,.lb-row,.wallet-pill .add,.friend,.stat,.bet-card,.card[onclick],' +
  '.help-dot,.w-btn,.w-dot-hit,.cta,.chip,.chip-single,.back-btn,.ob-back,.p-row,.p-stat,.p-gear,.p-streak,' +
  '.chal-cta,.chal-panel,.make-card,.alert-strip,.hero-cta,.f2chip,.tile,.avatar-ring,.bell,.coin,.amt';

let pressed = null;
function pressDown(el){
  if(!el || REDUCED || !el.animate) return;
  pressed = el;
  const small = el.classList.contains('tab') || el.classList.contains('icon-btn') ? .9 : .965;
  el.__pressAnim = el.animate([{transform:'scale(1)'}, {transform:`scale(${small})`}],
    {duration:110, easing:SPRING.snappy.easing, fill:'forwards'});
}
function pressUp(el){
  if(!el || REDUCED || !el.animate) return;
  const s = SPRING.bouncy;
  if(el.__pressAnim){ try{ el.__pressAnim.cancel(); }catch(e){} el.__pressAnim = null; }
  const from = getComputedStyle(el).transform;
  el.animate([{transform:from === 'none' ? 'scale(.965)' : from}, {transform:'scale(1)'}],
             {duration:s.duration, easing:s.easing, fill:'none'});
  el.style.transform = '';
}
document.addEventListener('pointerdown', e=>{
  const t = e.target.closest(PRESSABLE);
  if(!t || t.classList.contains('disabled')) return;
  pressDown(t);
  tick(5);
}, {passive:true});
['pointerup','pointercancel','pointerleave'].forEach(ev=>{
  document.addEventListener(ev, ()=>{ if(pressed){ pressUp(pressed); pressed = null; } }, {passive:true});
});

/* ── wire the effects to app events ───────────────────────── */
function animateTabChange(id){
  const bar = document.getElementById('tabbar');
  if(!bar) return;
  const btn = [...bar.querySelectorAll('.tab')].find(b=>(b.getAttribute('onclick')||'').includes("'" + id + "'"));
  const icon = btn && btn.querySelector('.ico');
  if(icon) symbolEffect(icon, 'jump');
}
function pulseBell(){
  const b = document.querySelector('.bell .ico');
  if(b) symbolEffect(b, 'wiggle');
}
let breathing = null;
function bellBreathe(){
  const dot = document.querySelector('.bell .dot');
  if(breathing){ try{ breathing.cancel(); }catch(e){} breathing = null; }
  if(dot && !REDUCED && dot.animate){
    breathing = dot.animate([{transform:'scale(1)'}, {transform:'scale(1.28)', offset:.5}, {transform:'scale(1)'}],
      {duration:2400, easing:'ease-in-out', iterations:Infinity});
  }
}

const TABS = {home:screenHome, bets:screenBets, activity:screenActivity, profile:screenProfile};
const SCREENS = {
  overview:screenProgress, progress:screenProgress, betDetail:screenBetDetail,
  notifications:screenNotifications, wallet:screenWallet, create:screenCreate,
  challenges:screenChallenges, challengeDetail:screenChallengeDetail,
  punishments:screenPunishments, faceReveal:screenFaceReveal, settings:screenSettings,
  punishRules:screenPunishRules, editProfile:screenEditProfile, demoData:screenDemoData,
  betHistory:screenBetHistory, smartOdds:screenSmartOdds, streaks:screenStreaks,
  predictions:screenPredictions, leaderboard:screenLeaderboard, insights:screenInsights,
  recovery:screenRecovery, community:screenCommunity,
  proof:screenProof, live:screenLive, liveHub:screenLiveHub, health:screenHealth,
};

/* ═══════════ session ═══════════ */
function signOut(){
  DB.session = false;
  saveDB();
  stopReveal();
  toast('Signed out — your history is safe', 'users');
  step = 'welcome';
  render();
}
function deleteAccount(){
  wipeDB();
  stopReveal();
  userName = ''; goal = null; workouts = new Set(); interests = new Set();
  punishOk = new Set(); offLimitsSel = new Set(); occupation = null;
  authEmail = ''; authProvider = null;
  step = 'welcome';
  render();
  toast('Account deleted', 'refresh');
}


/* ═══════════ account, onboarding hand-off, boot ═══════════ */

const CAT_LABELS = {media:'photos & video', money:'money', dares:'public dares', social:'social media', food:'food', work:'work or school', family:'family'};
const catLabel = id => CAT_LABELS[id] || id;

function defaultProfile(){
  return {goal:null, workouts:[], frequency:4, competitiveness:3, interests:[], occupation:null,
          punishAllowed:[], offLimits:[], faceReveal:true, health:false, notifs:false};
}

function ensureAccount(provider, email){
  if(!DB){
    DB = blankDB({name:'', email:email||'', provider:provider||'', hue:18}, defaultProfile());
    DB.createdAt = now();
  }
  if(provider) DB.account.provider = provider;
  if(email) DB.account.email = email;
  DB.session = true;
  saveDB();
}

function finishOnboarding(){
  ensureAccount(authProvider, authEmail);
  const name = (userName||'').trim() || 'Champ';
  DB.account.name = name;
  DB.account.hue = Math.abs(hashStr(name)) % 360;
  const offCats = [...offLimitsSel].filter(x=>x!=='__NONE__')
    .map(l=>{ const o = OFFLIMIT_OPTIONS.find(x=>x.label===l); return o ? o.cat : null; })
    .filter(Boolean);
  DB.profile = {
    goal, workouts:[...workouts], frequency:workoutFrequency, competitiveness,
    interests:[...interests], occupation,
    punishAllowed:[...punishOk].filter(x=>x!=='__NONE__'),
    offLimits:offCats,
    faceReveal: !offCats.includes('media') && !punishOk.has('__NONE__'),
    health:healthConnected, notifs:notifsEnabled,
  };
  DB.onboarded = true;
  DB.health = DB.health || {provider:'Apple Health', grantedAt:null, lastSync:null};
  DB.health.connected = !!healthConnected;
  if(healthConnected){ DB.health.grantedAt = now(); DB.health.lastSync = now(); }
  if(!DB.demoSeeded) seedDemo();
  saveDB();
  enterApp();
}

function enterApp(){
  stack = []; tab = 'home';
  step = 'app';
  render();
  toast('Welcome in, ' + (DB.account.name||'champ') + ' check');
}

/* restore the onboarding answers if someone quit halfway through */
function restoreOnboarding(){
  const p = DB.profile || {};
  userName = DB.account.name || '';
  goal = p.goal || null;
  workouts = new Set(p.workouts || []);
  interests = new Set(p.interests || []);
  workoutFrequency = p.frequency || 4;
  competitiveness = p.competitiveness || 3;
  occupation = p.occupation || null;
  authEmail = DB.account.email || '';
  authProvider = DB.account.provider || null;
}

/* ── onboarding back navigation ── */
const ONB_BACK = {
  name:'intro', goal:'name', fact1:'goal', workouts:'fact1', workoutFreq:'workouts',
  competitive:'workoutFreq', odds:'competitive', interests:'odds', occupation:'interests',
  fact2:'occupation', punishOk:'fact2', offLimits:'punishOk', punishLogic:'offLimits',
  health:'punishLogic', notifs:'health', ready:'notifs',
};
function obBack(){ const prev = ONB_BACK[step]; if(prev) nav(prev); }

function boot(){
  /* open index.html?reset to wipe the saved account and start at sign-in */
  if(/reset/i.test(location.search) || /reset/i.test(location.hash)){
    wipeDB();
    try{ history.replaceState(null, '', location.pathname); }catch(e){}
  }
  DB = loadDB();
  if(DB){
    DB.predictions = DB.predictions || []; DB.reactions = DB.reactions || {}; DB.challengeJoins = DB.challengeJoins || {};
    DB.settings = DB.settings || {}; if(!DB.settings.theme) DB.settings.theme = 'system';
    DB.health = DB.health || {connected:!!(DB.profile && DB.profile.health), provider:'Apple Health', grantedAt:null, lastSync:null};
    DB.bets.forEach(b=>{ b.finished = b.finished || {}; b.proofs = b.proofs || []; if(b.locked === undefined) b.locked = true; });
  }
  applyTheme();
  if(DB && DB.account && DB.session && DB.onboarded){
    restoreOnboarding();
    step = 'app';
  } else if(DB && DB.account && DB.session){
    restoreOnboarding();
    step = 'intro';
  } else {
    step = 'welcome';
  }
  render();
}

boot();
</script>
