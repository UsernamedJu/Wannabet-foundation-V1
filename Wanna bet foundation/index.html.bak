        <div class="metric"><b>${winRate()}%</b><span>Win rate</span></div>
      </div>
      <div class="stagger">${list.length ? list.map(betRow).join('') : emptyState('history','No settled bets yet','Finish one and the receipts show up here.','')}</div>
    </div>
