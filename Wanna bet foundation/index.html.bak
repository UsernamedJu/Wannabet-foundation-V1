/* ── router ── */
let tab = 'home';
let stack = [];
let draft = null;
let revealStream = null;
const FULLSCREEN = new Set(['create','faceReveal','live','proof']);

function go(screen, params){ stopReveal(); stack.push({screen, params:params||{}}); renderApp(); }
function back(){ stopReveal(); stack.pop(); renderApp(); }
function setTab(t){ stopReveal(); tab = t; stack = []; renderApp(); animateTabChange(t); }
function resetTo(t){ stack = []; tab = t; renderApp(); }

function renderApp(){
  if(step !== 'app') return;
  const scroll = document.getElementById('appScroll');
  const bar = document.getElementById('tabbar');
  const top = stack[stack.length-1];
  let html = '', showTabs = true;
  if(top){
    const fn = SCREENS[top.screen];
    html = fn ? fn(top.params) : '<div class="empty"><h4>Coming soon</h4></div>';
    showTabs = !FULLSCREEN.has(top.screen);
  } else {
    html = TABS[tab]();
  }
  scroll.innerHTML = html;
  scroll.scrollTop = 0;
  bar.innerHTML = tabbarHTML();
  bar.style.display = showTabs ? '' : 'none';
  afterAppRender();
}

function afterAppRender(){
  requestAnimationFrame(()=>{
    document.querySelectorAll('[data-w]').forEach(el=>{ el.style.width = el.dataset.w + '%'; });
    document.querySelectorAll('[data-count]').forEach(el=>countUp(el));
  });
}
function countUp(el){
  const to = parseFloat(el.dataset.count) || 0;
  const pre = el.dataset.pre || '', post = el.dataset.post || '';
  const dur = 700, t0 = performance.now();
  const dec = to % 1 !== 0 ? 2 : 0;
  function tick(t){
    const k = Math.min(1, (t - t0)/dur);
    const v = to * (1 - Math.pow(1-k, 3));
    el.textContent = pre + (dec ? v.toFixed(2) : Math.round(v).toLocaleString()) + post;
    if(k < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

function tabbarHTML(){
  const t = (id, icon, label) => `<button class="tab ${tab===id&&!stack.length?'on':''}" onclick="setTab('${id}')">${icon}<span>${label}</span></button>`;
  return t('home', I.home, 'Home') + t('bets', I.trophy, 'Bets')
    + `<div class="fab-wrap"><button class="fab" onclick="startCreate()" aria-label="Create a bet">${I.plus}</button><span class="fab-lbl">Create Bet</span></div>`
    + t('activity', I.bolt, 'Activity') + t('profile', I.user, 'Profile');
}

function appbar(title, right){
  return `<div class="appbar"><button class="icon-btn" onclick="back()" aria-label="Back">${I.chevL}</button><h2>${title}</h2>${right||''}</div>`;
}
function appSheet(title, body){
  showOverlay(`<div class="sheet" onclick="event.stopPropagation()"><div class="sheet-grip"></div><h2>${title}</h2>${body}</div>`);
}

/* ═══════════ HOME ═══════════ */
function homeHeader(){
  const s = streakDays();
  const unread = unreadCount();
  return `
  <div class="hdr">
    <img class="hdr-av press" src="${personAvatar('me')}" alt="" onclick="setTab('profile')">
    <div class="hdr-txt" onclick="setTab('profile')">
      <div class="hdr-hi">Welcome back,</div>
      <div class="hdr-row">
        <div class="hdr-name">${escapeHtml(DB.account.name || 'Champ')}</div>
        <button class="streak-chip press" onclick="event.stopPropagation();streakSheet()" aria-label="Streak details"><span class="fl">${ic('flameS')}</span>${s}</button>
      </div>
    </div>
    <button class="bell press" onclick="go('notifications')" aria-label="Notifications">${I.bell}${unread?'<span class="dot"></span>':''}</button>
  </div>`;
}

function heroBanner(){
  return `
  <div class="hero">
    <img class="hero-art" src="${HERO_BANNER}" alt="" draggable="false">
    <div class="hero-in">
      <h2>Bet on effort.<em>Win together.</em></h2>
      <p>Challenge friends, hit your goals and earn rewards.</p>
      <button class="hero-cta press" onclick="setTab('bets')">Find a Bet ${I.chevR}</button>
    </div>
  </div>`;
}

function statCard(o){
  return `<button class="stat press" onclick="${o.onclick}">
    <div class="stat-top"><div class="stat-ic" style="background:${o.color}">${o.icon}</div><div class="stat-lbl">${o.label}</div></div>
    <div class="stat-num" data-count="${o.value}" ${o.pre?`data-pre="${o.pre}"`:''}>0</div>
    <div class="stat-sub">${o.sub}</div>
    ${o.foot}
  </button>`;
}

function homeStats(){
  const lv = levelInfo();
  const s = streakDays();
  return `<div class="rail stagger">
    ${statCard({label:'Workouts', color:'transparent', icon:mockIcon('ov_workouts'), value:workoutsThisWeek(), sub:'This week',
      onclick:"go('progress')",
      foot:`<div class="stat-foot"><span class="fic" style="color:#E2571B">${ic('flameS')}</span>${s} day streak</div>`})}
    ${statCard({label:'Bets Won', color:'transparent', icon:mockIcon('ov_wins'), value:betsWon(), sub:'Total wins',
      onclick:"go('betHistory')",
      foot:`<div class="stat-foot" style="color:var(--green)"><span class="fic">${I.trend}</span>${winRate()}% win rate</div>`})}
    ${statCard({label:'Winnings', color:'transparent', icon:mockIcon('ov_money'), value:winningsNet(), pre:'$', sub:'Total earned',
      onclick:"go('wallet')",
      foot:`<div class="stat-foot">${I.wallet}<span style="margin-left:2px">${money(balance())} balance</span></div>`})}
    <button class="stat press" onclick="go('progress')">
      <div class="stat-top"><div class="stat-ic" style="background:transparent">${mockIcon('ov_level')}</div><div class="stat-lbl">Level</div></div>
      <div class="stat-num" data-count="${lv.level}">0</div>
      <div class="stat-sub">${lv.title}</div>
      <div class="stat-foot" style="display:block;border-top:none;padding-top:12px">
        <div class="xp-track"><div class="xp-fill" data-w="${lv.pct}"></div></div>
        <span style="font-weight:600;color:var(--ink-muted)">${lv.into} / ${lv.span} XP</span>
      </div>
    </button>
  </div>`;
}

function avStack(ids, max){
  const shown = ids.slice(0, max||3);
  const rest = ids.length - shown.length;
  return `<div class="av-stack">${shown.map(id=>`<img class="av" src="${personAvatar(id)}" alt="">`).join('')}${rest>0?`<span class="av-more">+${rest}</span>`:''}</div>`;
}

function betCard(b){
  const m = metricById(b.metricId);
  const joined = b.participants.includes('me');
  const dl = daysLeft(b.endsAt);
  const total = Math.min(7, b.days || 7);
  const elapsed = Math.max(0, Math.min(total, total - dl));
  return `<div class="bet-card">
    <div class="bet-top">
      <div class="bet-emoji" style="background:${b.color}1F">${G(b.emoji)}</div>
      ${avStack(b.participants)}
    </div>
    <div onclick="go('betDetail',{id:'${b.id}'})">
      <div class="bet-title">${escapeHtml(b.title)}</div>
      <div class="bet-meta">${money(betPot(b))} Pot &nbsp;•&nbsp; ${dl} ${plural(dl,'day')} left</div>
    </div>
    <div class="pdots">${Array.from({length:total},(_,i)=>`<span class="pdot ${i<elapsed?'on':''}" style="${i<elapsed?`background:${b.color}`:''}"></span>`).join('')}</div>
    ${joined
      ? `<button class="btn-join done press" onclick="go('betDetail',{id:'${b.id}'})">Joined check</button>`
      : `<button class="btn-join neon press" onclick="joinSheet('${b.id}')">Join</button>`}
  </div>`;
}

function friendTile(f){
  const r = friendRecord(f.id);
  return `<button class="friend press" onclick="friendSheet('${f.id}')">
    <div class="friend-av"><img src="${avatarURI(f.name,f.hue)}" alt=""><span class="presence ${f.online?'on':''}"></span></div>
    <div class="friend-name">${escapeHtml(f.name)}</div>
    <div class="friend-rec">${r.w} - ${r.l} <span class="${r.trend==='up'?'trend-up':'trend-down'}">${ic(r.trend==='up'?'arrowUp':'arrowDown')}</span></div>
  </button>`;
}

function challengeCard(c){
  const done = activeDaysInWindow(c.window);
  const pct = Math.min(100, Math.round(done/c.goal*100));
  return `<div class="chal">
    <div class="chal-main">
      <div class="chal-head">
        <div class="chal-ic" style="background:${c.color}">${G(c.emoji)}</div>
        <div style="flex:1;min-width:0">
          <div class="chal-title">${escapeHtml(c.title)}</div>
          <div class="chal-sub">${escapeHtml(c.sub)}</div>
        </div>
      </div>
      <div class="chal-prog">
        <div class="chal-bar"><span data-w="${pct}" style="background:${c.color}"></span></div>
        <b style="color:${c.color}">${done} / ${c.goal}</b>
      </div>
      <div class="chal-people">
        ${(DB.friends.slice(0,3)).map(f=>`<img class="av" src="${avatarURI(f.name,f.hue)}" alt="">`).join('')}
        <span>+ ${c.participants.toLocaleString()} participating</span>
      </div>
    </div>
    <div class="chal-side">
      <div class="chal-prize">${money(c.prize)}</div>
      <div class="chal-prize-lbl">Prize Pool</div>
      <button class="chal-go press" onclick="go('challengeDetail',{id:'${c.id}'})" aria-label="Open challenge">${I.chevR}</button>
    </div>
  </div>`;
}

function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  const banners = [];
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    banners.push(`<div class="banner banner-red">
      <div class="b-ic">${G(p.emoji)}</div>
      <div class="b-main"><div class="b-t">You owe a ${p.name}</div><div class="b-s">From ${escapeHtml((DB.bets.find(b=>b.id===owed[0].betId)||{}).title||'a bet')} · ${owed[0].dueAt < now() ? 'overdue' : 'due within 24h'}</div></div>
      <button class="b-go press" onclick="go('punishments')">Settle up</button>
    </div>`);
  }
  if(DB.demoSeeded && !DB.demoNoticeSeen){
    banners.push(`<div class="banner banner-info">
      <div class="b-ic">${ic('sparkle')}</div>
      <div class="b-main"><div class="b-t">Demo data loaded</div><div class="b-s">${DB.friends.length} friends and ${DB.bets.filter(b=>b.mine).length} past bets were seeded so the app has real numbers to add up. Clear it in Profile → Demo data.</div></div>
      <button class="b-x press" onclick="DB.demoNoticeSeen=true;commit()" aria-label="Dismiss">${ic('x')}</button>
    </div>`);
  }
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${banners.join('')}
    <div class="sec"><h3>Your Progress</h3><button class="link" onclick="go('progress')">View all</button></div>
    ${homeStats()}
    <div class="sec"><h3>Live Bets</h3><button class="link" onclick="setTab('bets')">View all</button></div>
    ${live.length ? `<div class="rail stagger">${live.slice(0,6).map(betCard).join('')}</div>`
      : emptyState('dice','No live bets','Start one and put something on the line.',`<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}
    <div class="sec"><h3>Your Friends</h3><button class="link" onclick="inviteSheet()">Invite</button></div>
    ${DB.friends.length ? `<div class="rail stagger">
        ${DB.friends.map(friendTile).join('')}
        <button class="friend invite-tile press" onclick="inviteSheet()">
          <div class="friend-av">${I.userplus}</div><div class="friend-name">Invite<br>more</div>
        </button>
      </div>`
      : emptyState('users','No friends yet','Bets are better with someone to beat.',`<button class="btn btn-primary" onclick="inviteSheet()">Invite a friend</button>`)}
    <div class="sec"><h3>Challenges</h3><button class="link" onclick="go('challenges')">View all</button></div>
    ${DB.challenges.length ? challengeCard(DB.challenges[0])
      : emptyState('flag','No challenges running','Group challenges show up here each season.','')}
    <div style="height:14px"></div>
  </div>`;
}

function emptyState(icon, title, text, cta){
  return `<div class="empty"><div class="e-ic">${G(icon)}</div><h4>${title}</h4><p>${text}</p>${cta||''}</div>`;
}

/* ═══════════ BETS TAB ═══════════ */
let betFilter = 'live', betQuery = '';
function screenBets(){
  const all = DB.bets.filter(b=>b.mine || b.status==='live');
  let list = all.filter(b=>{
    if(betFilter === 'live') return b.status === 'live';
    if(betFilter === 'mine') return b.status === 'live' && b.participants.includes('me');
    return b.status === 'settled' && b.mine;
  });
  if(betQuery.trim()){
    const q = betQuery.trim().toLowerCase();
    list = list.filter(b=>b.title.toLowerCase().includes(q));
  }
  return `<div class="pane">
    <div class="appbar"><h2>Bets</h2><button class="icon-btn press" onclick="startCreate()" aria-label="New bet">${I.plus}</button></div>
    <div class="pad">
      <input class="inp" id="betSearch" placeholder="Search bets…" value="${escapeHtml(betQuery)}"
        oninput="betQuery=this.value;liveFilterBets()" autocomplete="off">
      <div class="seg" style="margin-top:12px">
        ${[['live','Live'],['mine','Mine'],['past','Past']].map(([k,l])=>
          `<button class="${betFilter===k?'on':''}" onclick="betFilter='${k}';renderApp()">${l}</button>`).join('')}
      </div>
    </div>
    <div class="pad stagger" id="betList" style="margin-top:14px">
      ${list.length ? list.map(betRow).join('') : emptyState('eye','Nothing here yet',
        betFilter==='past' ? 'Settled bets will show up here with the receipts.' : 'No bets match. Start your own and invite the crew.',
        `<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}
    </div>
    <div style="height:6px"></div>
  </div>`;
}
function liveFilterBets(){
  const q = betQuery.trim().toLowerCase();
  document.querySelectorAll('#betList [data-title]').forEach(el=>{
    el.style.display = el.dataset.title.includes(q) ? '' : 'none';
  });
}
function betRow(b){
  const m = metricById(b.metricId);
  const joined = b.participants.includes('me');
  const settled = b.status === 'settled';
  const iWon = settled && b.winners.includes('me');
  const dl = daysLeft(b.endsAt);
  const pct = Math.min(100, Math.round((b.myProgress||0)/b.target*100));
  return `<div class="card" data-title="${escapeHtml(b.title.toLowerCase())}" style="margin-bottom:12px">
    <div style="display:flex;gap:13px;align-items:center" onclick="go('betDetail',{id:'${b.id}'})">
      <div class="bet-emoji" style="background:${b.color}1F">${G(b.emoji)}</div>
      <div style="flex:1;min-width:0">
        <div class="bet-title">${escapeHtml(b.title)}</div>
        <div class="bet-meta">${money(betPot(b))} pot · ${b.participants.length} ${plural(b.participants.length,'player')} ${settled ? '· ended ' + timeAgo(b.endedAt) : '· ' + dl + ' ' + plural(dl,'day') + ' left'}</div>
      </div>
      ${settled ? `<span class="pill ${iWon?'pill-green':'pill-red'}">${iWon?'Won':'Lost'}</span>` : ''}
    </div>
    ${joined && !settled ? `<div style="margin-top:12px"><div class="bar"><span data-w="${pct}" style="background:${b.color}"></span></div>
      <div class="bet-meta" style="margin-top:7px">${(b.myProgress||0).toLocaleString()} / ${b.target.toLocaleString()} ${m.unit}</div></div>` : ''}
    ${!joined && !settled ? `<button class="btn-join neon press" style="margin-top:12px" onclick="joinSheet('${b.id}')">Join for ${money(b.stake)}</button>` : ''}
  </div>`;
}

/* ═══════════ ACTIVITY ═══════════ */
let feedFilter = 'all';
function screenActivity(){
  const kinds = {all:'All', bet:'Bets', win:'Results', punishment:'Punishments', wallet:'Wallet'};
  let items = DB.activity.slice();
  if(feedFilter === 'win') items = items.filter(a=>a.kind==='win'||a.kind==='loss');
  else if(feedFilter !== 'all') items = items.filter(a=>a.kind===feedFilter);
  return `<div class="pane">
    <div class="appbar"><h2>Activity</h2></div>
    <div class="pad"><div class="chips">
      ${Object.entries(kinds).map(([k,l])=>`<button class="chip-x ${feedFilter===k?'on':''}" onclick="feedFilter='${k}';renderApp()">${l}</button>`).join('')}
    </div></div>
    <div class="pad" style="margin-top:14px">
      ${items.length ? `<div class="card">${items.slice(0,60).map(a=>`
        <div class="feed-item"><div class="feed-ic" style="background:#F5F1ED">${G(a.emoji)}</div>
        <div class="feed-main"><div class="feed-t">${a.text}</div><div class="feed-time">${timeAgo(a.ts)}</div></div></div>`).join('')}</div>`
        : emptyState('bolt','Nothing yet','Join a bet or log a workout and it shows up here.',`<button class="btn btn-primary" onclick="setTab('bets')">Find a bet</button>`)}
    </div>
    <div style="height:6px"></div>
  </div>`;
}

/* ═══════════ PROFILE ═══════════ */
function screenProfile(){
  const lv = levelInfo();
  const s = streakDays();
  return `<div class="pane">
    <div class="appbar"><h2>Profile</h2><button class="icon-btn press" onclick="go('settings')" aria-label="Settings">${ic('settings')}</button></div>
    <div class="profile-hero">
      <img src="${personAvatar('me')}" alt="">
      <h2>${escapeHtml(DB.account.name||'You')}</h2>
      <div class="sub2">${escapeHtml(DB.account.email || (DB.account.provider ? DB.account.provider + ' account' : ''))} · joined ${new Date(DB.createdAt).toLocaleDateString(undefined,{month:'short',year:'numeric'})}</div>
      <div class="lvl-wrap">
        <div class="lvl-top"><span>Level ${lv.level} · ${lv.title}</span><span style="color:var(--ink-muted)">${lv.into} / ${lv.span} XP</span></div>
        <div class="xp-track"><div class="xp-fill" data-w="${lv.pct}"></div></div>
      </div>
    </div>
    <div class="pad" style="margin-top:18px">
      <div class="metric-grid stagger">
        <div class="metric"><b>${betsWon()}-${betsLost()}</b><span>Record · ${winRate()}% wins</span></div>
        <div class="metric"><b>${money(winningsNet())}</b><span>Net winnings</span></div>
        <div class="metric"><b>${s}</b><span>Day streak · ${workoutsThisWeek()} workouts this week</span></div>
        <div class="metric"><b>${servedPunishments().length}</b><span>Punishments served</span></div>
      </div>
    </div>
    <div class="pad" style="margin-top:14px">
      <div class="card">
        ${profRow('chart','Your Overview','Metrics, punishments and rewards',"go('overview')")}
        ${profRow('ghost','Punishment rules','What friends can use against you',"go('punishRules')")}
        ${profRow('dollar','Wallet',money(balance()) + ' available',"go('wallet')")}
        ${profRow('dumbbell','Fitness profile','Goal, workouts and interests',"go('editProfile')")}
        ${profRow('bell','Notifications','Choose what pings you',"go('settings')")}
      </div>
      <div class="card">
        ${profRow('heart','Health', healthOn()?'Connected':'Not connected', "go('health')")}
        ${profRow('live','Live sessions','Start or join a live workout', "go('liveHub')")}
        ${profRow('sparkle','Demo data', DB.demoSeeded ? 'Loaded — clear it for a true empty account' : 'Not loaded', "go('demoData')")}
        ${profRow('logout','Sign out','Keeps your account and history',"signOut()")}
      </div>
      <p class="tagline" style="margin:14px 4px 0">Avatars are generated from initials — no stock photos of real people are used anywhere in this prototype.</p>
    </div>
    <div style="height:6px"></div>
  </div>`;
}
function profRow(icon, t, s, onclick){
  return `<div class="row tap" onclick="${onclick}"><div class="row-ic" style="background:var(--surface-2)">${G(icon)}</div>
    <div class="row-main"><div class="row-t">${t}</div><div class="row-s">${s}</div></div>${I.chevR.replace('<svg','<svg class="chev"')}</div>`;
}

/* ═══════════ PROGRESS / METRICS ═══════════ */
function screenProgress(){
  const lv = levelInfo();
  const served = servedPunishments(), owed = owedPunishments(), waived = waivedPunishments();
  const fr = myFaceReveals();
  const frDone = fr.filter(p=>p.status==='served').length;
  const rewards = DB.rewardLog.filter(r=>r.who==='me');
  const rewardCounts = {};
  rewards.forEach(r=>{ rewardCounts[r.rewardId] = (rewardCounts[r.rewardId]||0)+1; });
  return `<div class="pane">
    ${appbar('Your Overview')}
    <div class="pad">
      <div class="card">
        <div class="card-h">Performance</div>
        <div class="metric-grid">
          <div class="metric"><b data-count="${workoutsThisWeek()}">0</b><span>Workouts this week</span></div>
          <div class="metric"><b data-count="${streakDays()}">0</b><span>Day streak</span></div>
          <div class="metric"><b data-count="${betsWon()}">0</b><span>Bets won</span></div>
          <div class="metric"><b data-count="${betsLost()}">0</b><span>Bets lost</span></div>
          <div class="metric"><b>${winRate()}%</b><span>Win rate</span></div>
          <div class="metric"><b data-count="${activeDaysInWindow(30)}">0</b><span>Active days · 30d</span></div>
        </div>
      </div>
      <div class="card">
        <div class="card-h">Money</div>
        <div class="row"><div class="row-main"><div class="row-t">Net winnings</div><div class="row-s">Payouts minus the stakes that won them</div></div><div class="row-v" style="color:var(--green)">${money(winningsNet())}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Wallet balance</div><div class="row-s">${DB.ledger.length} ${plural(DB.ledger.length,'transaction')}</div></div><div class="row-v">${money(balance())}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Biggest single payout</div><div class="row-s">Across ${betsWon()} ${plural(betsWon(),'win')}</div></div><div class="row-v">${money(biggestPayout())}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">At stake right now</div><div class="row-s">${myLiveBets().length} live ${plural(myLiveBets().length,'bet')}</div></div><div class="row-v">${money(myLiveBets().reduce((s,b)=>s+b.stake,0))}</div></div>
      </div>
      <div class="card">
        <div class="card-h">Punishment metrics</div>
        <div class="metric-grid">
          <div class="metric"><b data-count="${served.length}">0</b><span>Served</span></div>
          <div class="metric"><b data-count="${owed.length}">0</b><span>Owed right now</span><i class="${owed.length?'trend-down':'trend-up'}">${owed.length?'settle up':'all clear'}</i></div>
          <div class="metric"><b>${severityIndex()}</b><span>Avg severity taken (1–5)</span></div>
          <div class="metric"><b data-count="${waived.length}">0</b><span>Waived by friends</span></div>
          <div class="metric"><b>${frDone} / ${fr.length}</b><span>Face reveals completed</span></div>
          <div class="metric"><b>${betsLost() ? Math.round(served.length/betsLost()*100) : 0}%</b><span>Debts paid on time</span></div>
        </div>
        <button class="btn btn-ghost btn-block" style="margin-top:14px" onclick="go('punishments')">Open punishment centre</button>
      </div>
      <div class="card">
        <div class="card-h">Reward metrics</div>
        <div class="metric-grid">
          <div class="metric"><b data-count="${rewards.length}">0</b><span>Rewards earned</span></div>
          <div class="metric"><b data-count="${trophies()}">0</b><span>Trophies</span></div>
          <div class="metric"><b data-count="${shields()}">0</b><span>Streak shields banked</span></div>
          <div class="metric"><b data-count="${lv.total}">0</b><span>Lifetime XP</span></div>
        </div>
        ${rewards.length ? `<div style="margin-top:14px">${Object.entries(rewardCounts).map(([rid,n])=>{
          const r = rewardById(rid);
          return `<div class="row"><div class="row-ic" style="background:#FDEDE3">${G(r.emoji)}</div><div class="row-main"><div class="row-t">${r.name}</div><div class="row-s">${r.desc}</div></div><div class="row-v">×${n}</div></div>`;
        }).join('')}</div>` : '<p class="tagline" style="margin-top:12px">Win a bet to start collecting rewards.</p>'}
      </div>
      <div class="card">
        <div class="card-h">Level ${lv.level} · ${lv.title}</div>
        <div class="xp-track"><div class="xp-fill" data-w="${lv.pct}"></div></div>
        <p class="tagline" style="margin-top:10px">${lv.into} / ${lv.span} XP toward level ${lv.level+1}. Every workout is +${XP.workout} XP, joining a bet +${XP.join}, winning one +${XP.win}, serving a punishment +${XP.punishmentServed}.</p>
      </div>
    </div>
    <div style="height:18px"></div>
  </div>`;
}

/* ═══════════ PUNISHMENT CENTRE ═══════════ */
function screenPunishments(){
  const owed = owedPunishments();
  const served = servedPunishments().sort((a,b)=>b.servedAt-a.servedAt);
  const reveals = faceReveals().filter(p=>p.status==='served');
  return `<div class="pane">
    ${appbar('Punishment centre')}
    <div class="pad">
      ${owed.length ? `<div class="card">
        <div class="card-h">Owed — ${owed.length}</div>
        ${owed.map(p=>{
          const c = punishmentById(p.punishmentId);
          const b = DB.bets.find(x=>x.id===p.betId) || {title:'a bet'};
          return `<div class="row"><div class="row-ic" style="background:#FDECEA;font-size:19px">${G(c.emoji)}</div>
            <div class="row-main"><div class="row-t">${c.name}</div><div class="row-s">Lost ${escapeHtml(b.title)} · severity ${c.sev}/5</div></div>
            <button class="btn btn-primary press" style="padding:11px 16px;font-size:13.5px" onclick="${c.id==='faceReveal'?`go('faceReveal',{id:'${p.id}'})`:`confirmServe('${p.id}')`}">Serve</button></div>`;
        }).join('')}
      </div>` : `<div class="card"><div class="card-h">Owed</div><p class="tagline">Nothing outstanding. Your record is clean.</p></div>`}

      <div class="card">
        <div class="card-h">Your rules</div>
        <p class="tagline">Face reveal is <b>${DB.profile.faceReveal ? 'switched on' : 'switched off'}</b> for your bets${DB.profile.offLimits.length ? `, and ${DB.profile.offLimits.map(catLabel).join(', ')} ${DB.profile.offLimits.length===1?'is':'are'} off limits` : ''}.</p>
        <button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="go('punishRules')">Edit punishment rules</button>
      </div>

      <div class="card">
        <div class="card-h">Face reveals — ${reveals.length} completed</div>
        ${reveals.length ? `<div class="reveal-grid">${reveals.map((p,i)=>`
          <button class="reveal-tile ${p.who==='me'?'':'open'}" onclick="this.classList.toggle('open')">
            <img src="${personAvatar(p.who)}" alt=""><span class="lock">${ic('lock')}</span><span class="who">${escapeHtml(personName(p.who))}</span>
          </button>`).join('')}</div>
          <p class="tagline" style="margin-top:12px">Tap a tile to reveal it. Nothing is uploaded anywhere — reveals live only on this device.</p>`
          : '<p class="tagline">No face reveals yet. Lose a bet with that punishment attached and it lands here.</p>'}
      </div>

      <div class="card">
        <div class="card-h">Served — ${served.length}</div>
        ${served.length ? served.map(p=>{
          const c = punishmentById(p.punishmentId);
          const b = DB.bets.find(x=>x.id===p.betId) || {title:'a bet'};
          return `<div class="row"><div class="row-ic" style="background:#E8F8EE">${G(c.emoji)}</div>
            <div class="row-main"><div class="row-t">${c.name}</div><div class="row-s">${escapeHtml(b.title)} · ${timeAgo(p.servedAt||p.ts)}</div></div>
            <span class="pill pill-green">Paid</span></div>`;
        }).join('') : '<p class="tagline">Nothing served yet.</p>'}
      </div>
    </div>
    <div style="height:18px"></div>
  </div>`;
}

function confirmServe(pid){
  const p = DB.punishLog.find(x=>x.id===pid);
  const c = punishmentById(p.punishmentId);
  appSheet(c.name, `
    <p>${c.desc}</p>
    <p style="font-size:13px">Marking this done tells the group you paid up. Worth +${XP.punishmentServed} XP.</p>
    <button class="btn btn-primary btn-block" onclick="closeSheet();servePunishment('${pid}')">I did it — mark as served</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Not yet</button>`);
}

/* ═══════════ FACE REVEAL ═══════════ */
function screenFaceReveal({id}){
  const p = DB.punishLog.find(x=>x.id===id);
  if(!p) return emptyState('eye','Nothing to reveal','That punishment is already settled.','');
  const b = DB.bets.find(x=>x.id===p.betId) || {title:'a bet'};
  return `<div class="pane" style="padding:0 0 20px">
    <div class="appbar" style="background:transparent"><button class="icon-btn press" onclick="back()">${I.chevL}</button><h2>Face Reveal</h2></div>
    <div class="pad">
      <p class="tagline" style="margin-bottom:14px">You lost <b>${escapeHtml(b.title)}</b>. The deal was an unfiltered face reveal to the group — no filters, no angles, no do-overs.</p>
      <div class="reveal-stage" id="revealStage">
        <div class="fallback"><img src="${personAvatar('me')}" alt=""></div>
        <div class="reveal-count" id="revealCount" style="display:none"></div>
      </div>
      <div id="revealActions" style="margin-top:16px">
        <button class="btn btn-primary btn-block press" onclick="startReveal('${id}')">${I.camera} Start 3-second countdown</button>
        <p class="tagline" style="margin-top:12px">Uses your camera if the browser allows it, otherwise it plays out the reveal with your avatar. Either way nothing is uploaded, saved, or sent anywhere.</p>
      </div>
    </div>
  </div>`;
}

async function startReveal(pid){
  const stage = document.getElementById('revealStage');
  const countEl = document.getElementById('revealCount');
  const actions = document.getElementById('revealActions');
  actions.innerHTML = '<p class="tagline" style="text-align:center">Hold still…</p>';
  try{
    if(navigator.mediaDevices && navigator.mediaDevices.getUserMedia){
      revealStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}, audio:false});
      const v = document.createElement('video');
      v.autoplay = true; v.playsInline = true; v.muted = true; v.srcObject = revealStream;
      stage.insertBefore(v, stage.firstChild);
      stage.querySelector('.fallback').style.display = 'none';
    }
  }catch(e){ /* camera denied or unavailable — fall back to the avatar reveal */ }
  countEl.style.display = '';
  let n = 3;
  countEl.textContent = n;
  const iv = setInterval(()=>{
    n--;
    if(n > 0){
      countEl.textContent = n;
      countEl.style.animation = 'none'; void countEl.offsetWidth; countEl.style.animation = '';
    } else {
      clearInterval(iv);
      countEl.style.display = 'none';
      stage.classList.add('revealed');
      stage.insertAdjacentHTML('beforeend', '<div class="reveal-stamp">Revealed</div>');
      actions.innerHTML = `<button class="btn btn-primary btn-block press" onclick="finishReveal('${pid}')">Send it to the group</button>
        <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="back()">Chicken out</button>`;
    }
  }, 900);
}
function finishReveal(pid){
  stopReveal();
  servePunishment(pid, 'revealed');
  stack.pop();
  renderApp();
}
function stopReveal(){
  if(revealStream){ revealStream.getTracks().forEach(t=>t.stop()); revealStream = null; }
}

/* ═══════════ BET DETAIL ═══════════ */
function screenBetDetail({id}){
  const b = DB.bets.find(x=>x.id===id);
  if(!b) return appbar('Bet') + emptyState('eye','Bet not found','It may have been cleared with the demo data.','');
  const m = metricById(b.metricId);
  const pun = punishmentById(b.punishmentId), rew = rewardById(b.rewardId);
  const joined = b.participants.includes('me');
  const settled = b.status === 'settled';
  const iWon = settled && b.winners.includes('me');
  const dl = daysLeft(b.endsAt);
  const rows = b.participants.map(pid=>{
    const prog = pid === 'me' ? (b.myProgress||0) : (b.progress[pid]||0);
    const pct = Math.min(100, Math.round(prog/b.target*100));
    const won = settled && b.winners.includes(pid);
    return `<div class="row"><img class="av" src="${personAvatar(pid)}" style="width:38px;height:38px;border-radius:50%">
      <div class="row-main"><div class="row-t">${escapeHtml(personName(pid))} ${won?'<span class="pill pill-green" style="margin-left:6px">Won</span>':''}</div>
      <div class="bar" style="margin-top:7px"><span data-w="${pct}" style="background:${b.color}"></span></div>
      <div class="row-s">${prog.toLocaleString()} / ${b.target.toLocaleString()} ${m.unit}</div></div></div>`;
  }).join('');
  return `<div class="pane">
    ${appbar(b.emoji + ' ' + escapeHtml(b.title))}
    <div class="pad">
      <div class="card">
        <div style="display:flex;gap:14px;align-items:center">
          <div class="bet-emoji" style="background:${b.color}1F;width:56px;height:56px;font-size:26px">${G(b.emoji)}</div>
          <div style="flex:1">
            <div style="font-size:26px;font-weight:800;letter-spacing:-.03em">${money(betPot(b))}</div>
            <div class="row-s">Pot · ${money(b.stake)} each · ${b.participants.length} ${plural(b.participants.length,'player')}</div>
          </div>
          ${settled ? `<span class="pill ${iWon?'pill-green':'pill-red'}">${iWon?'You won':'You lost'}</span>`
                    : `<span class="pill pill-amber">${dl} ${plural(dl,'day')} left</span>`}
        </div>
        <div class="row" style="margin-top:14px"><div class="row-ic" style="background:${b.color}1F">${G(m.emoji)}</div>
          <div class="row-main"><div class="row-t">${m.name}</div><div class="row-s">Hit ${b.target.toLocaleString()} ${m.unit} before it closes</div></div></div>
        <div class="row"><div class="row-ic" style="background:#FDECEA">${pun.emoji}</div>
          <div class="row-main"><div class="row-t">Punishment · ${pun.name}</div><div class="row-s">${pun.desc}</div></div></div>
        <div class="row"><div class="row-ic" style="background:#E8F8EE">${rew.emoji}</div>
          <div class="row-main"><div class="row-t">Reward · ${rew.name}</div><div class="row-s">${rew.desc}</div></div></div>
      </div>

      <div class="card"><div class="card-h">Leaderboard</div>${rows}</div>

      ${!settled ? `<div class="card">
        <div class="card-h">Your move</div>
        ${joined ? `
          <button class="btn btn-primary btn-block press" onclick="logSheet('${b.id}')">Log progress</button>
          <button class="btn btn-dark btn-block press" style="margin-top:9px" onclick="settleSheet('${b.id}')">Settle bet now</button>
          <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="leaveBet('${b.id}')">Leave & refund my ${money(b.stake)}</button>`
        : `<button class="btn btn-primary btn-block press" onclick="joinSheet('${b.id}')">Join for ${money(b.stake)}</button>`}
      </div>` : `<div class="card"><div class="card-h">Result</div>
        <p class="tagline">${b.winners.map(w=>escapeHtml(personName(w))).join(', ')} took ${money(payoutFor(b))} each. ${iWon ? `You banked ${money(payoutFor(b) - b.stake)} on top of your stake.` : `You owed a ${pun.name}.`}</p></div>`}
    </div>
    <div style="height:18px"></div>
  </div>`;
}

function joinSheet(id){
  const b = DB.bets.find(x=>x.id===id);
  const m = metricById(b.metricId);
  appSheet('Join ' + escapeHtml(b.title), `
    <p>${m.name}: hit <b>${b.target.toLocaleString()} ${m.unit}</b> in ${daysLeft(b.endsAt)} days. Lose and you owe <b>${punishmentById(b.punishmentId).name}</b>.</p>
    <div class="field"><label>Your stake</label>
      <div class="money-wrap"><span class="cur">$</span><input class="inp" id="joinStake" type="number" inputmode="decimal" min="1" value="${b.stake}" oninput="syncJoin('${id}')"></div>
      <div class="hint" id="joinHint">Pot becomes ${money(betPot(b) + b.stake)} · you have ${money(balance())}</div>
    </div>
    <button class="btn btn-primary btn-block" id="joinGo" style="margin-top:16px" onclick="doJoin('${id}')">Put ${money(b.stake)} in</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Cancel</button>`);
}
function syncJoin(id){
  const b = DB.bets.find(x=>x.id===id);
  const v = parseFloat(document.getElementById('joinStake').value) || 0;
  const ok = v > 0 && v <= balance();
  document.getElementById('joinHint').textContent = ok
    ? `Pot becomes ${money(b.stake*b.participants.length + v)} · you have ${money(balance())}`
    : `Enter between $1 and ${money(balance())}`;
  document.getElementById('joinGo').classList.toggle('disabled', !ok);
  document.getElementById('joinGo').textContent = 'Put ' + money(v) + ' in';
}
function doJoin(id){
  const v = parseFloat(document.getElementById('joinStake').value) || 0;
  if(v <= 0 || v > balance()) return;
  closeSheet();
  joinBet(id, v);
}
function logSheet(id){
  const b = DB.bets.find(x=>x.id===id);
  const m = metricById(b.metricId);
  const quick = m.id === 'steps' ? [1000,2500,5000,10000] : m.id === 'workouts' ? [1,2,3] : m.id === 'calories' ? [200,400,600] : [15,30,60];
  appSheet('Log progress', `
    <p>${escapeHtml(b.title)} · ${(b.myProgress||0).toLocaleString()} of ${b.target.toLocaleString()} ${m.unit} so far.</p>
    <div class="field"><label>Add ${m.unit}</label>
      <input class="inp" id="logAmt" type="number" inputmode="numeric" placeholder="0" oninput="document.getElementById('logGo').classList.toggle('disabled', !(parseFloat(this.value)>0))">
      <div class="quick">${quick.map(q=>`<button onclick="document.getElementById('logAmt').value=${q};document.getElementById('logGo').classList.remove('disabled')">+${q.toLocaleString()}</button>`).join('')}</div>
    </div>
    <button class="btn btn-primary btn-block disabled" id="logGo" style="margin-top:16px" onclick="doLog('${id}')">Log it</button>`);
}
function doLog(id){
  const v = parseFloat(document.getElementById('logAmt').value) || 0;
  if(v <= 0) return;
  closeSheet();
  logProgress(id, v);
}
function settleSheet(id){
  const b = DB.bets.find(x=>x.id===id);
  const hit = (b.myProgress||0) >= b.target;
  appSheet('Settle now?', `
    <p>Bets normally settle when the clock runs out. Settling early scores it on the numbers logged so far.</p>
    <p style="font-size:13px">You're at <b>${(b.myProgress||0).toLocaleString()} / ${b.target.toLocaleString()}</b> — ${hit ? 'that clears the target, so you win a share of the pot.' : `that's short, so you'd owe <b>${punishmentById(b.punishmentId).name}</b>.`}</p>
    <button class="btn btn-dark btn-block" onclick="closeSheet();settleBet('${id}')">Settle it</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Keep going</button>`);
}

/* ═══════════ CREATE BET ═══════════ */
function startCreate(){
  draft = {stepIdx:0, title:'', metricId:'steps', target:METRICS[0].target, days:7, stake:10,
           friends:[], punishmentId:'funnyPhoto', rewardId:'pot', emoji:'steps'};
  go('create');
}
const CREATE_STEPS = ['Basics','Target','Stake','Crew','Stakes'];
function screenCreate(){
  if(!draft) draft = {stepIdx:0, title:'', metricId:'steps', target:METRICS[0].target, days:7, stake:10,
                      friends:[], punishmentId:'funnyPhoto', rewardId:'pot', emoji:'steps'};
  const d = draft;
  const bodies = [createBasics, createTarget, createStake, createCrew, createStakes];
  const canNext = [
    () => d.title.trim().length > 1,
    () => d.target > 0 && d.days > 0,
    () => d.stake > 0 && d.stake <= balance(),
    () => true,
    () => true,
  ];
  const last = d.stepIdx === CREATE_STEPS.length - 1;
  return `<div class="pane">
    <div class="appbar"><button class="icon-btn press" onclick="${d.stepIdx?'createBack()':'back()'}">${I.chevL}</button>
      <h2>${CREATE_STEPS[d.stepIdx]}</h2>
      <button class="icon-btn plain press" onclick="back()" aria-label="Close">${I.x}</button></div>
    <div class="steps-dots">${CREATE_STEPS.map((_,i)=>`<i class="${i<=d.stepIdx?'on':''}"></i>`).join('')}</div>
    <div class="pad" style="margin-top:8px">${bodies[d.stepIdx]()}</div>
    <div class="pad" style="margin-top:22px">
      <button class="btn btn-primary btn-block ${canNext[d.stepIdx]()?'':'disabled'}" onclick="${last?'submitCreate()':'createNext()'}">${last?'Create the bet':'Continue'}</button>
    </div>
    <div style="height:20px"></div>
  </div>`;
}
function createNext(){ draft.stepIdx++; renderApp(); }
function createBack(){ draft.stepIdx--; renderApp(); }
function createBasics(){
  return `<div class="field"><label>What's the bet?</label>
      <input class="inp" id="cTitle" placeholder="e.g. 10K steps every day" value="${escapeHtml(draft.title)}"
        oninput="draft.title=this.value;document.querySelector('.pad .btn-primary').classList.toggle('disabled', this.value.trim().length<2)">
      <div class="hint">Give it a name your friends will recognise in the group chat.</div>
    </div>
    <div class="field"><label>What are we measuring?</label>
      ${METRICS.map(m=>`<button class="opt ${draft.metricId===m.id?'on':''}" onclick="pickMetric('${m.id}')">
        <div class="opt-ic" style="background:${m.color}1F">${G(m.emoji)}</div>
        <div class="opt-main"><div class="opt-t">${m.name}</div><div class="opt-s">Counted in ${m.unit}</div></div>
        <div class="opt-check"></div></button>`).join('')}
    </div>`;
}
function pickMetric(id){ const m = metricById(id); draft.metricId = id; draft.target = m.target; draft.emoji = m.emoji; renderApp(); }
function createTarget(){
  const m = metricById(draft.metricId);
  return `<div class="field"><label>Target — ${m.unit}</label>
      <input class="inp" id="cTarget" type="number" inputmode="numeric" value="${draft.target}" oninput="draft.target=parseInt(this.value)||0">
      <div class="hint">Everyone has to clear this to win.</div>
    </div>
    <div class="field"><label>How long?</label>
      <div class="seg">${[3,7,14,30].map(n=>`<button class="${draft.days===n?'on':''}" onclick="draft.days=${n};renderApp()">${n} days</button>`).join('')}</div>
      <div class="hint">Ends ${new Date(now()+draft.days*DAY).toLocaleDateString(undefined,{weekday:'long', month:'short', day:'numeric'})}.</div>
    </div>`;
}
function createStake(){
  return `<div class="field"><label>Stake per person</label>
      <div class="money-wrap"><span class="cur">$</span>
        <input class="inp" id="cStake" type="number" inputmode="decimal" value="${draft.stake}" oninput="draft.stake=parseFloat(this.value)||0;syncStakeHint()"></div>
      <div class="quick">${[5,10,20,25].map(n=>`<button class="${draft.stake===n?'on':''}" onclick="draft.stake=${n};renderApp()">$${n}</button>`).join('')}</div>
      <div class="hint" id="stakeHint">${stakeHintText()}</div>
    </div>`;
}
function stakeHintText(){
  const total = draft.stake * (draft.friends.length + 1);
  const ok = draft.stake > 0 && draft.stake <= balance();
  return ok ? `Pot starts at ${money(total)} with ${draft.friends.length+1} in. Your wallet: ${money(balance())}.`
            : `You have ${money(balance())} available — add funds in Wallet or lower the stake.`;
}
function syncStakeHint(){
  const el = document.getElementById('stakeHint');
  if(el) el.textContent = stakeHintText();
  const btn = document.querySelector('.pad .btn-primary');
  if(btn) btn.classList.toggle('disabled', !(draft.stake > 0 && draft.stake <= balance()));
}
function createCrew(){
  if(!DB.friends.length) return `${emptyState('users','No friends yet','Invite someone first — a bet needs an opponent.',`<button class="btn btn-primary" onclick="inviteSheet()">Invite a friend</button>`)}
    <p class="tagline" style="text-align:center">You can also create it solo and invite people later.</p>`;
  return `<div class="field"><label>Who's in?</label>
    ${DB.friends.map(f=>{
      const on = draft.friends.includes(f.id);
      const r = friendRecord(f.id);
      return `<button class="opt ${on?'on':''}" onclick="toggleCrew('${f.id}')">
        <img src="${avatarURI(f.name,f.hue)}" style="width:40px;height:40px;border-radius:50%">
        <div class="opt-main"><div class="opt-t">${escapeHtml(f.name)}</div><div class="opt-s">${r.w}-${r.l} record · ${f.online?'online now':'offline'}</div></div>
        <div class="opt-check"></div></button>`;
    }).join('')}
    <div class="hint">${draft.friends.length} invited · pot starts at ${money(draft.stake*(draft.friends.length+1))}</div>
  </div>`;
}
function toggleCrew(id){
  const i = draft.friends.indexOf(id);
  if(i >= 0) draft.friends.splice(i,1); else draft.friends.push(id);
  renderApp();
}
function createStakes(){
  return `<div class="field"><label>Punishment for losing</label>
    ${PUNISHMENTS.map(p=>{
      const allowed = punishmentAllowed(p.id);
      const on = draft.punishmentId === p.id;
      return `<button class="opt ${on?'on':''} ${allowed?'':'off'}" ${allowed?`onclick="draft.punishmentId='${p.id}';renderApp()"`:`onclick="toast('${p.id==='faceReveal'?'Turn face reveal on in Profile → Punishment rules first.':'You marked that category off limits during onboarding.'}','x')"`}>
        <div class="opt-ic" style="background:#FDECEA">${G(p.emoji)}</div>
        <div class="opt-main"><div class="opt-t">${p.name} ${allowed?'':'· blocked by your rules'}</div><div class="opt-s">${p.desc}</div></div>
        <div class="opt-check"></div></button>`;
    }).join('')}
  </div>
  <div class="field"><label>Reward for winning</label>
    ${REWARDS.map(r=>`<button class="opt ${draft.rewardId===r.id?'on':''}" onclick="draft.rewardId='${r.id}';renderApp()">
      <div class="opt-ic" style="background:#E8F8EE">${G(r.emoji)}</div>
      <div class="opt-main"><div class="opt-t">${r.name}</div><div class="opt-s">${r.desc}</div></div>
      <div class="opt-check"></div></button>`).join('')}
  </div>
  <div class="card" style="margin-top:18px">
    <div class="card-h">Review</div>
    <div class="row"><div class="row-main"><div class="row-t">${escapeHtml(draft.title||'Untitled bet')}</div>
      <div class="row-s">${draft.target.toLocaleString()} ${metricById(draft.metricId).unit} in ${draft.days} days</div></div></div>
    <div class="row"><div class="row-main"><div class="row-t">Pot</div><div class="row-s">${money(draft.stake)} each · ${draft.friends.length+1} in</div></div>
      <div class="row-v">${money(draft.stake*(draft.friends.length+1))}</div></div>
    <div class="row"><div class="row-main"><div class="row-t">Lose</div><div class="row-s">${punishmentById(draft.punishmentId).name}</div></div></div>
    <div class="row"><div class="row-main"><div class="row-t">Win</div><div class="row-s">${rewardById(draft.rewardId).name}</div></div></div>
  </div>`;
}
function submitCreate(){
  if(draft.stake > balance()){ toast('Not enough in your wallet for that stake', 'x'); return; }
  const bet = createBet(draft);
  stack = [];
  tab = 'home';
  go('betDetail', {id:bet.id});
}

/* ═══════════ CHALLENGES ═══════════ */
function screenChallenges(){
  return `<div class="pane">${appbar('Challenges')}
    <div class="pad stagger">${DB.challenges.length ? DB.challenges.map(c=>{
      const done = activeDaysInWindow(c.window);
      const pct = Math.min(100, Math.round(done/c.goal*100));
      return `<button class="card" style="display:block;width:100%;text-align:left;margin-bottom:12px" onclick="go('challengeDetail',{id:'${c.id}'})">
        <div style="display:flex;gap:13px;align-items:center">
          <div class="row-ic" style="background:${c.color}1F;width:46px;height:46px;font-size:20px">${G(c.emoji)}</div>
          <div style="flex:1"><div class="bet-title">${escapeHtml(c.title)}</div><div class="bet-meta">${escapeHtml(c.sub)}</div></div>
          <div style="text-align:right"><div style="font-weight:800;color:var(--green)">${money(c.prize)}</div><div class="row-s">prize</div></div>
        </div>
        <div class="bar" style="margin-top:13px"><span data-w="${pct}" style="background:${c.color}"></span></div>
        <div class="row-s" style="margin-top:7px">${done} / ${c.goal} days · ${c.participants.toLocaleString()} in ${c.joined?'· you’re entered':''}</div>
      </button>`;
    }).join('') : emptyState('flag','No challenges','Seasonal challenges appear here.','')}</div>
  </div>`;
}
function screenChallengeDetail({id}){
  const c = DB.challenges.find(x=>x.id===id);
  if(!c) return appbar('Challenge') + emptyState('eye','Not found','','');
  const done = activeDaysInWindow(c.window);
  const pct = Math.min(100, Math.round(done/c.goal*100));
  const left = Math.max(0, c.goal - done);
  return `<div class="pane">${appbar(escapeHtml(c.title))}
    <div class="pad">
      <div class="card">
        <div style="display:flex;gap:14px;align-items:center">
          <div class="row-ic" style="background:${c.color}1F;width:56px;height:56px;font-size:26px">${G(c.emoji)}</div>
          <div style="flex:1"><div style="font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--green)">${money(c.prize)}</div><div class="row-s">Prize pool · ${c.participants.toLocaleString()} participating</div></div>
        </div>
        <p class="tagline" style="margin-top:14px">${escapeHtml(c.sub)}. Your workout log is the scorecard — every day with at least one logged session counts once.</p>
        <div class="bar" style="margin-top:14px"><span data-w="${pct}" style="background:${c.color}"></span></div>
        <div class="row-s" style="margin-top:8px">${done} of ${c.goal} days · ${left ? left + ' to go' : 'target cleared'}</div>
      </div>
      <div class="card">
        <div class="card-h">Your last 30 days</div>
        <div style="display:flex;flex-wrap:wrap;gap:5px">
          ${Array.from({length:30},(_,i)=>{
            const d = startOfDay(now()) - (29-i)*DAY;
            const hit = workoutDays().includes(d);
            return `<span title="${new Date(d).toLocaleDateString()}" style="width:calc(10% - 5px);aspect-ratio:1;border-radius:6px;background:${hit?c.color:'#EDE8E3'}"></span>`;
          }).join('')}
        </div>
      </div>
      <button class="btn ${c.joined?'btn-ghost':'btn-primary'} btn-block" style="margin-top:14px" onclick="joinChallenge('${c.id}')">${c.joined?'Leave challenge':'Join challenge'}</button>
    </div>
    <div style="height:18px"></div>
  </div>`;
}

/* ═══════════ NOTIFICATIONS ═══════════ */
function screenNotifications(){
  const n = DB.notifications;
  return `<div class="pane">
    ${appbar('Notifications', n.some(x=>!x.read) ? `<button class="link" style="color:var(--brand);font-weight:700;font-size:13.5px" onclick="markAllRead()">Mark all read</button>` : '')}
    <div class="pad">${n.length ? `<div class="card">${n.map(x=>`
      <div class="feed-item" ${x.action?`onclick="openNotif('${x.id}')"`:''} style="cursor:pointer">
        <div class="feed-ic" style="background:${x.read?'#F5F1ED':'#FDEDE3'}">${G(x.emoji)}</div>
        <div class="feed-main"><div class="feed-t" style="${x.read?'':'font-weight:700'}">${x.text}</div><div class="feed-time">${timeAgo(x.ts)}</div></div>
        ${x.read?'':'<span style="width:9px;height:9px;border-radius:50%;background:var(--brand);align-self:center;flex-shrink:0"></span>'}
      </div>`).join('')}</div>` : emptyState('bell','All quiet','Bet updates and friend results land here.','')}</div>
  </div>`;
}
function openNotif(id){
  const n = DB.notifications.find(x=>x.id===id);
  if(!n) return;
  n.read = true;
  saveDB();
  if(n.action) go(n.action.screen, n.action.params);
  else renderApp();
}

/* ═══════════ WALLET ═══════════ */
function screenWallet(){
  const tx = DB.ledger.slice().sort((a,b)=>b.ts-a.ts);
  return `<div class="pane">${appbar('Wallet')}
    <div class="pad">
      <div class="card" style="text-align:center;padding:24px 16px">
        <div class="row-s">Available balance</div>
        <div style="font-size:44px;font-weight:800;letter-spacing:-.04em;margin:4px 0 2px" data-count="${balance()}" data-pre="$">$0</div>
        <div class="row-s">${money(winningsNet())} net winnings · ${money(myLiveBets().reduce((s,b)=>s+b.stake,0))} at stake</div>
        <div style="display:flex;gap:10px;margin-top:18px">
          <button class="btn btn-primary" style="flex:1" onclick="moneySheet('deposit')">Add funds</button>
          <button class="btn btn-ghost" style="flex:1" onclick="moneySheet('withdraw')">Withdraw</button>
        </div>
      </div>
      <div class="card"><div class="card-h">Transactions — ${tx.length}</div>
        ${tx.length ? tx.slice(0,40).map(t=>`<div class="row">
          <div class="row-ic" style="background:${t.amount>0?'var(--lime-soft)':'var(--surface-2)'};color:${t.amount>0?'#3F6300':'var(--ink-muted)'}">${ic(t.type==='payout'?'trophyS':t.type==='deposit'?'wallet':t.type==='withdraw'?'logout':t.type==='refund'?'refresh':'dice')}</div>
          <div class="row-main"><div class="row-t">${escapeHtml(t.note||t.type)}</div><div class="row-s">${new Date(t.ts).toLocaleDateString(undefined,{month:'short',day:'numeric'})} · ${timeAgo(t.ts)}</div></div>
          <div class="row-v" style="color:${t.amount>0?'var(--green)':'var(--ink)'}">${t.amount>0?'+':''}${money(t.amount)}</div></div>`).join('')
        : '<p class="tagline">No transactions yet.</p>'}
      </div>
    </div>
    <div style="height:18px"></div>
  </div>`;
}
function moneySheet(kind){
  const isW = kind === 'withdraw';
  appSheet(isW ? 'Withdraw' : 'Add funds', `
    <p>${isW ? `You can take out up to ${money(balance())}. Money in live bets stays locked until they settle.` : 'Demo wallet — no card is charged and nothing leaves this device.'}</p>
    <div class="field"><label>Amount</label>
      <div class="money-wrap"><span class="cur">$</span><input class="inp" id="mAmt" type="number" inputmode="decimal" placeholder="0" oninput="syncMoney(${isW})"></div>
      <div class="quick">${(isW?[10,25,50]:[10,25,50,100]).map(n=>`<button onclick="document.getElementById('mAmt').value=${n};syncMoney(${isW})">$${n}</button>`).join('')}</div>
      <div class="hint" id="mHint">${isW ? 'Available: ' + money(balance()) : 'Added instantly in this prototype.'}</div>
    </div>
    <button class="btn btn-primary btn-block disabled" id="mGo" style="margin-top:16px" onclick="doMoney(${isW})">${isW?'Withdraw':'Add'}</button>`);
}
function syncMoney(isW){
  const v = parseFloat(document.getElementById('mAmt').value) || 0;
  const ok = v > 0 && (!isW || v <= balance());
  document.getElementById('mGo').classList.toggle('disabled', !ok);
  document.getElementById('mHint').textContent = ok ? (isW ? `${money(balance()-v)} left after this` : `New balance ${money(balance()+v)}`)
    : (isW ? `Enter between $1 and ${money(balance())}` : 'Enter an amount');
}
function doMoney(isW){
  const v = parseFloat(document.getElementById('mAmt').value) || 0;
  closeSheet();
  isW ? withdraw(v) : deposit(v);
}

/* ═══════════ SHEETS: streak, friend, invite ═══════════ */
function streakSheet(){
  const s = streakDays();
  const days = workoutDays().slice(0,14);
  appSheet(s + ' day ' + plural(s,'streak'), `
    <p>A day counts once you log any workout. Miss a day and it resets — unless you spend a streak shield.</p>
    <div style="display:flex;gap:6px;margin:16px 0">
      ${Array.from({length:14},(_,i)=>{
        const d = startOfDay(now()) - (13-i)*DAY;
        const hit = days.includes(d);
        return `<span style="flex:1;aspect-ratio:1;border-radius:8px;background:${hit?'var(--brand)':'#EDE8E3'}"></span>`;
      }).join('')}
    </div>
    <div class="row"><div class="row-main"><div class="row-t">Workouts this week</div></div><div class="row-v">${workoutsThisWeek()}</div></div>
    <div class="row"><div class="row-main"><div class="row-t">Active days · last 30</div></div><div class="row-v">${activeDaysInWindow(30)}</div></div>
    <div class="row"><div class="row-main"><div class="row-t">Streak shields banked</div></div><div class="row-v">${shields()}</div></div>
    <button class="btn btn-primary btn-block" style="margin-top:16px" onclick="closeSheet();quickWorkout()">Log a workout</button>`);
}
function quickWorkout(){
  logWorkout('Workout', 45);
  logActivity('You logged a <b>workout</b> — streak safe', 'dumbbell', 'progress');
  toast('Workout logged · streak ' + streakDays() + ' days', 'dumbbell');
  commit();
}
function friendSheet(fid){
  const f = DB.friends.find(x=>x.id===fid);
  const r = friendRecord(fid), h = headToHead(fid);
  const shared = DB.bets.filter(b=>b.mine && b.participants.includes(fid)).length;
  appSheet(escapeHtml(f.name), `
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:6px">
      <img src="${avatarURI(f.name,f.hue)}" style="width:60px;height:60px;border-radius:50%">
      <div><div style="font-weight:800;font-size:17px">${r.w} - ${r.l}</div>
      <div class="row-s">${f.online?'Online now':'Offline'} · friends since ${new Date(f.since).toLocaleDateString(undefined,{month:'short',year:'numeric'})}</div></div>
    </div>
    <div class="h2h">
      <div class="side"><div class="big">${h.mine}</div><div class="lbl">You</div></div>
      <div class="vs">HEAD TO HEAD</div>
      <div class="side"><div class="big">${h.theirs}</div><div class="lbl">${escapeHtml(f.name)}</div></div>
    </div>
    <p class="tagline">${shared} ${plural(shared,'bet')} together. ${h.mine>h.theirs?'You’re up.':h.mine<h.theirs?'They’re up — do something about it.':'Dead even.'}</p>
    <button class="btn btn-primary btn-block" style="margin-top:16px" onclick="closeSheet();challengeFriend('${fid}')">Challenge ${escapeHtml(f.name)}</button>`);
}
function challengeFriend(fid){
  startCreate();
  draft.friends = [fid];
  renderApp();
  toast(personName(fid) + ' added to the bet', 'boxing');
}
function inviteSheet(){
  const code = (DB.account.name||'YOU').slice(0,4).toUpperCase().replace(/[^A-Z]/g,'') + '-' + String(Math.abs(hashStr(DB.account.email||DB.account.name||'x'))%9000+1000);
  appSheet('Invite friends', `
    <p>Send someone your code — they land straight into a bet with you.</p>
    <div class="card" style="text-align:center;box-shadow:none;border:1.5px dashed var(--line);margin:14px 0">
      <div class="row-s">Your invite code</div>
      <div style="font-size:26px;font-weight:800;letter-spacing:2px;margin-top:4px">${code}</div>
    </div>
    <button class="btn btn-ghost btn-block" onclick="copyInvite('${code}')">Copy code</button>
    <div class="field"><label>Or send by email</label>
      <input class="inp" id="invEmail" type="email" inputmode="email" placeholder="friend@example.com" autocapitalize="off" spellcheck="false"
        oninput="document.getElementById('invGo').classList.toggle('disabled', !isEmail(this.value))">
      <div class="hint">They'll get a link to join your crew. Nothing is sent from this prototype.</div>
    </div>
    <button class="btn btn-primary btn-block disabled" id="invGo" style="margin-top:14px" onclick="doInvite()">Send invite</button>`);
}
function hashStr(s){ let h = 0; for(let i=0;i<s.length;i++){ h = (h*31 + s.charCodeAt(i))|0; } return h; }
function copyInvite(code){
  if(navigator.clipboard) navigator.clipboard.writeText('Join me on WannaBet — code ' + code).then(()=>toast('Invite code copied','link'), ()=>toast('Code: ' + code,'link'));
  else toast('Code: ' + code, 'link');
}
function doInvite(){
  const v = document.getElementById('invEmail').value.trim();
  if(!isEmail(v)) return;
  closeSheet();
  sendInvite(v);
}

/* ═══════════ SETTINGS / RULES / PROFILE EDIT ═══════════ */
function screenSettings(){
  const s = DB.settings;
  const sw = (key, t, sub) => `<div class="row tap" onclick="DB.settings.${key}=!DB.settings.${key};commit()">
    <div class="row-main"><div class="row-t">${t}</div><div class="row-s">${sub}</div></div><div class="sw ${s[key]?'on':''}"></div></div>`;
  return `<div class="pane">${appbar('Settings')}
    <div class="pad">
      <div class="card"><div class="card-h">Notifications</div>
        ${sw('notifBets','Bet updates','Someone joins, logs progress or settles')}
        ${sw('notifFriends','Friend activity','Wins, losses and challenges from your crew')}
        ${sw('notifStreak','Streak reminders','A nudge before your streak breaks')}
      </div>
      ${appearanceCard()}
      <div class="card"><div class="card-h">Connected</div>
        ${profRow('heart','Apple Health', healthOn() ? 'Connected · powers distance and step bets' : 'Not connected — required for distance bets', "go('health')")}
      </div>
      <div class="card"><div class="card-h">Account</div>
        <div class="row"><div class="row-main"><div class="row-t">Signed in with</div><div class="row-s">${escapeHtml(DB.account.email || DB.account.provider || 'this device')}</div></div></div>
        <div class="row"><div class="row-main"><div class="row-t">Member since</div><div class="row-s">${new Date(DB.createdAt).toLocaleDateString()}</div></div></div>
      </div>
      <div class="card"><div class="card-h">Danger zone</div>
        <button class="btn btn-ghost btn-block" onclick="signOut()">Sign out</button>
        <button class="btn btn-danger btn-block" style="margin-top:9px" onclick="confirmDelete()">Delete account & start over</button>
        <p class="tagline" style="margin-top:12px">Deleting clears everything on this device and drops you back at the sign-in screen.</p>
      </div>
    </div>
  </div>`;
}
function confirmDelete(){
  appSheet('Delete everything?', `
    <p>This wipes your account, history, wallet and friends from this device. It cannot be undone.</p>
    <button class="btn btn-danger btn-block" onclick="closeSheet();deleteAccount()">Yes, delete it all</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Keep my account</button>`);
}
function screenPunishRules(){
  const cats = [['media','Photos & video'],['money','Money'],['dares','Public dares'],['social','Social media'],['food','Food'],['work','Work or school']];
  return `<div class="pane">${appbar('Punishment rules')}
    <div class="pad">
      <div class="card">
        <div class="card-h">Face reveal</div>
        <div class="row tap" onclick="toggleFaceReveal()">
          <div class="row-ic" style="background:#FDECEA;color:#C1341C">${G(punishmentById('faceReveal').emoji)}</div>
          <div class="row-main"><div class="row-t">Allow face reveals</div><div class="row-s">Lose a bet and you post an unfiltered selfie to the group within 24h.</div></div>
          <div class="sw ${DB.profile.faceReveal?'on':''}"></div>
        </div>
        <p class="tagline" style="margin-top:8px">${DB.profile.faceReveal ? 'On — friends can attach it to any bet you join.' : 'Off — the option is blocked everywhere in the app, including bets other people create.'}</p>
      </div>
      <div class="card"><div class="card-h">Off limits</div>
        <div class="chips">${cats.map(([id,label])=>`<button class="chip-x ${DB.profile.offLimits.includes(id)?'on':''}" onclick="toggleOffLimit('${id}')">${label}</button>`).join('')}</div>
        <p class="tagline" style="margin-top:12px">Anything selected here is greyed out when a bet is created.</p>
      </div>
      <div class="card"><div class="card-h">What friends can use — ${PUNISHMENTS.filter(p=>punishmentAllowed(p.id)).length} of ${PUNISHMENTS.length}</div>
        ${PUNISHMENTS.map(p=>{
          const ok = punishmentAllowed(p.id);
          return `<div class="row"><div class="row-ic" style="background:${ok?'#F5F1ED':'#FAF7F5'};${ok?'':'opacity:.5'}">${G(p.emoji)}</div>
            <div class="row-main"><div class="row-t" style="${ok?'':'opacity:.5'}">${p.name}</div><div class="row-s">Severity ${p.sev}/5 · ${p.desc}</div></div>
            <span class="pill ${ok?'pill-green':'pill-grey'}">${ok?'Allowed':'Blocked'}</span></div>`;
        }).join('')}
      </div>
    </div>
    <div style="height:18px"></div>
  </div>`;
}
function toggleFaceReveal(){ DB.profile.faceReveal = !DB.profile.faceReveal; toast(DB.profile.faceReveal?'Face reveal is on — brave':'Face reveal blocked everywhere', 'ghost'); commit(); }
function toggleOffLimit(cat){
  const i = DB.profile.offLimits.indexOf(cat);
  if(i>=0) DB.profile.offLimits.splice(i,1); else DB.profile.offLimits.push(cat);
  commit();
}
function screenEditProfile(){
  const p = DB.profile;
  return `<div class="pane">${appbar('Fitness profile')}
    <div class="pad">
      <div class="card"><div class="card-h">Name</div>
        <input class="inp" value="${escapeHtml(DB.account.name)}" oninput="DB.account.name=this.value;saveDB()" onchange="commit()">
        <p class="tagline" style="margin-top:10px">Shows on your profile, the home screen and every bet you join.</p>
      </div>
      <div class="card"><div class="card-h">Goal</div>
        <div class="chips">${GOALS.map(g=>`<button class="chip-x ${p.goal===g?'on':''}" onclick="DB.profile.goal='${g.replace(/'/g,"\\'")}';commit()">${g}</button>`).join('')}</div>
      </div>
      <div class="card"><div class="card-h">Workouts you enjoy</div>
        <div class="chips">${WORKOUTS.map(w=>`<button class="chip-x ${p.workouts.includes(w)?'on':''}" onclick="toggleProfileList('workouts','${w.replace(/'/g,"\\'")}')">${w}</button>`).join('')}</div>
      </div>
      <div class="card"><div class="card-h">Interests</div>
        <div class="chips">${INTERESTS.map(w=>`<button class="chip-x ${p.interests.includes(w)?'on':''}" onclick="toggleProfileList('interests','${w}')">${w}</button>`).join('')}</div>
        <p class="tagline" style="margin-top:12px">Used to suggest punishments and challenges that actually sting.</p>
      </div>
    </div>
    <div style="height:18px"></div>
  </div>`;
}
function toggleProfileList(key, val){
  const arr = DB.profile[key];
  const i = arr.indexOf(val);
  if(i>=0) arr.splice(i,1); else arr.push(val);
  commit();
}
function screenDemoData(){
  return `<div class="pane">${appbar('Demo data')}
    <div class="pad">
      <div class="card">
        <p class="tagline">Every figure in the app is computed from the records below — clear them and the home screen honestly reads zero.</p>
        <div class="row"><div class="row-main"><div class="row-t">Friends</div></div><div class="row-v">${DB.friends.length}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Bets on record</div><div class="row-s">${myBets().length} of them yours</div></div><div class="row-v">${DB.bets.length}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Workouts logged</div></div><div class="row-v">${DB.workouts.length}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Wallet transactions</div></div><div class="row-v">${DB.ledger.length}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">XP events</div></div><div class="row-v">${DB.xpEvents.length}</div></div>
      </div>
      ${DB.demoSeeded
        ? `<button class="btn btn-danger btn-block" onclick="clearDemo()">Clear demo data</button>`
        : `<button class="btn btn-primary btn-block" onclick="reloadDemo()">Load demo data</button>`}
      <p class="tagline" style="margin-top:12px">Your account, name and punishment rules are kept either way.</p>
    </div>
  </div>`;
}
function reloadDemo(){
  DB.friends=[];DB.bets=[];DB.ledger=[];DB.xpEvents=[];DB.workouts=[];DB.punishLog=[];DB.rewardLog=[];
  DB.notifications=[];DB.activity=[];DB.challenges=[];
  seedDemo();
  DB.demoNoticeSeen = false;
  toast('Demo data loaded', 'sparkle');
  commit();
}
function screenBetHistory(){
