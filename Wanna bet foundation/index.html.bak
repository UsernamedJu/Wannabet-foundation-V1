  {id:'funnyPhoto', name:'Funny photo',        emoji:'camera', sev:2, cat:'media',  desc:'Loser sends the group one deeply unflattering photo of their choosing.'},
  {id:'videoMsg',   name:'Video apology',      emoji:'video', sev:3, cat:'media',  desc:'A 15-second video explaining exactly what went wrong.'},
  {id:'coffee',     name:'Buy the coffee',     emoji:'cup', sev:2, cat:'money',  desc:'Loser covers the winner’s next coffee or lunch.'},
  {id:'doubleUp',   name:'Double the stake',   emoji:'dollar', sev:3, cat:'money',  desc:'Loser pays double their stake into the winner’s pot.'},
  {id:'extraWork',  name:'Extra workout',      emoji:'dumbbell', sev:2, cat:null,     desc:'One bonus session, scheduled by the winner.'},
  {id:'karaoke',    name:'Karaoke clip',       emoji:'mic', sev:4, cat:'dares',  desc:'One chorus, filmed, sent to the group. No lip-syncing.'},
  {id:'outfit',     name:'Silly outfit',       emoji:'shirt', sev:3, cat:'dares',  desc:'Winner picks the outfit for the loser’s next workout.'},
  {id:'postTheL',   name:'Post the L',         emoji:'megaphone', sev:5, cat:'social', desc:'Loser posts the result publicly. Screenshot required.'},
  {id:'earlyAlarm', name:'6am wake-up call',   emoji:'⏰', sev:3, cat:null,     desc:'Winner gets to call the loser at 6am. Once.'},
];
const REWARDS = [
  {id:'pot',      name:'Winner takes the pot', emoji:'dollar', desc:'Whole pot goes to whoever finishes on top.'},
  {id:'split',    name:'Split the pot',        emoji:'users', desc:'Everyone who hits the target splits the pot evenly.'},
  {id:'xpBoost',  name:'Double XP',            emoji:'bolt', desc:'Winner earns double XP on top of their payout.', xp:150},
  {id:'trophy',   name:'Trophy + badge',       emoji:'trophy', desc:'A permanent badge on the winner’s profile.'},
  {id:'shield',   name:'Streak shield',        emoji:'shield', desc:'Winner banks one rest day that won’t break their streak.'},
  {id:'pickNext', name:'Winner picks next',    emoji:'target', desc:'Winner sets the terms of the group’s next bet.'},
];
const METRICS = [
  {id:'steps',    name:'Daily steps',     unit:'steps',    emoji:'steps', color:'#22C55E', target:10000},
  {id:'workouts', name:'Workouts',        unit:'workouts', emoji:'flame', color:'#F2620F', target:5},
  {id:'minutes',  name:'Active minutes',  unit:'min',      emoji:'⏱️', color:'#2563EB', target:150},
  {id:'calories', name:'Calories burned', unit:'kcal',     emoji:'bolt', color:'#F59E0B', target:3500},
  {id:'habit',    name:'Habit streak',    unit:'days',     emoji:'dumbbell', color:'#8B5CF6', target:7},
];
const metricById = id => METRICS.find(m=>m.id===id) || METRICS[0];
const punishmentById = id => PUNISHMENTS.find(p=>p.id===id) || PUNISHMENTS[0];
const rewardById = id => REWARDS.find(r=>r.id===id) || REWARDS[0];

const XP = {join:40, win:150, workout:25, streakDay:15, punishmentServed:60, challengeDay:20, onboard:100, invite:30};
const LEVEL_SPAN = 1000;
const LEVEL_TITLES = ['Rookie','Contender','Challenger','Rising Contender','Sharpshooter','Heavyweight','Ringleader','Legend'];

/* ── persistence ── */
function saveDB(){ try{ localStorage.setItem(DB_KEY, JSON.stringify(DB)); }catch(e){ /* private mode */ } }
function loadDB(){
  try{
    const raw = localStorage.getItem(DB_KEY);
    if(!raw) return null;
    const d = JSON.parse(raw);
    return d && d.v === 1 ? d : null;
  }catch(e){ return null; }
}
function wipeDB(){ try{ localStorage.removeItem(DB_KEY); }catch(e){} DB = null; }

function blankDB(account, profile){
  return {
    v:1, session:true, onboarded:false, createdAt:now(), demoSeeded:false, demoNoticeSeen:false,
    account, profile,
    settings:{notifBets:true, notifFriends:true, notifStreak:true, theme:'system'},
    friends:[], bets:[], ledger:[], xpEvents:[], workouts:[], punishLog:[], rewardLog:[],
    challenges:[], notifications:[], activity:[], invites:[],
    predictions:[], reactions:{}, challengeJoins:{},
    health:{connected:false, provider:'Apple Health', grantedAt:null, lastSync:null},
  };
}

/* ── XP / level ── */
function addXP(amount, reason, ts){ DB.xpEvents.push({ts:ts||now(), amount, reason}); }
function xpTotal(){ return DB.xpEvents.reduce((s,e)=>s+e.amount, 0); }
function levelInfo(){
  const total = xpTotal();
  const level = Math.floor(total / LEVEL_SPAN) + 1;
  return {
    total, level,
    into: total % LEVEL_SPAN,
    span: LEVEL_SPAN,
    pct: Math.round((total % LEVEL_SPAN) / LEVEL_SPAN * 100),
    title: LEVEL_TITLES[Math.min(level-1, LEVEL_TITLES.length-1)],
  };
}

/* ── wallet ── */
function ledgerAdd(type, amount, note, betId, ts){ DB.ledger.push({id:uid('tx'), ts:ts||now(), type, amount, note, betId}); }
function balance(){ return DB.ledger.reduce((s,t)=>s+t.amount, 0); }
function totalWinnings(){ return DB.ledger.filter(t=>t.type==='payout').reduce((s,t)=>s+t.amount,0)
                              - DB.ledger.filter(t=>t.type==='stake' && t.betId && betWon(t.betId)).reduce((s,t)=>s-t.amount,0)*0; }
function betWon(betId){ const b = DB.bets.find(x=>x.id===betId); return !!(b && b.status==='settled' && b.winners.includes('me')); }
/* profit on won bets = payouts received minus the stakes that bought them */
function winningsNet(){
  let sum = 0;
  DB.bets.filter(b=>b.mine && b.status==='settled' && b.winners.includes('me')).forEach(b=>{
    sum += payoutFor(b) - b.stake;
  });
  return sum;
}
function payoutFor(b){
  const pot = betPot(b);
  const winners = b.winners.length || 1;
  return Math.round((pot / winners) * 100) / 100;
}
function betPot(b){ return b.stake * b.participants.length; }

/* ── bets ── */
function myBets(){ return DB.bets.filter(b=>b.mine); }
function liveBets(){ return DB.bets.filter(b=>b.status==='live'); }
function myLiveBets(){ return liveBets().filter(b=>b.participants.includes('me')); }
function settledMine(){ return DB.bets.filter(b=>b.mine && b.status==='settled').sort((a,b)=>b.endedAt-a.endedAt); }
function betsWon(){ return settledMine().filter(b=>b.winners.includes('me')).length; }
function betsLost(){ return settledMine().filter(b=>!b.winners.includes('me')).length; }
function winRate(){ const w = betsWon(), l = betsLost(); return w+l ? Math.round(w/(w+l)*100) : 0; }

function friendRecord(fid){
  let w = 0, l = 0, lastWin = null;
  DB.bets.filter(b=>b.status==='settled' && b.participants.includes(fid))
    .sort((a,b)=>a.endedAt-b.endedAt)
    .forEach(b=>{ const won = b.winners.includes(fid); if(won) w++; else l++; lastWin = won; });
  return {w, l, trend: lastWin === null ? null : (lastWin ? 'up' : 'down')};
}
function headToHead(fid){
  let mine = 0, theirs = 0;
  DB.bets.filter(b=>b.status==='settled' && b.mine && b.participants.includes(fid)).forEach(b=>{
    const iWon = b.winners.includes('me'), theyWon = b.winners.includes(fid);
    if(iWon && !theyWon) mine++;
    else if(theyWon && !iWon) theirs++;
  });
  return {mine, theirs};
}

/* ── workouts / streak ── */
function logWorkout(type, minutes, ts){
  DB.workouts.push({id:uid('w'), ts:ts||now(), type:type||'Workout', minutes:minutes||45});
  addXP(XP.workout, 'Workout logged', ts);
}
function workoutsInLastDays(n){ const cut = startOfDay(now()) - (n-1)*DAY; return DB.workouts.filter(w=>w.ts >= cut).length; }
function workoutsThisWeek(){ return workoutsInLastDays(7); }
function workoutDays(){ return [...new Set(DB.workouts.map(w=>dayKey(w.ts)))].sort((a,b)=>b-a); }
function streakDays(){
  const days = workoutDays();
  if(!days.length) return 0;
  const today = startOfDay(now());
  if(days[0] !== today && days[0] !== today - DAY) return 0;
  let streak = 1, cursor = days[0];
  for(let i=1;i<days.length;i++){
    if(days[i] === cursor - DAY){ streak++; cursor = days[i]; } else break;
  }
  return streak;
}
function activeDaysInWindow(n){ const cut = startOfDay(now()) - (n-1)*DAY; return workoutDays().filter(d=>d>=cut).length; }

/* ── punishments & rewards ── */
function owedPunishments(){ return DB.punishLog.filter(p=>p.who==='me' && p.status==='owed'); }
function servedPunishments(){ return DB.punishLog.filter(p=>p.who==='me' && p.status==='served'); }
function waivedPunishments(){ return DB.punishLog.filter(p=>p.who==='me' && p.status==='waived'); }
function faceReveals(){ return DB.punishLog.filter(p=>p.punishmentId==='faceReveal'); }
function myFaceReveals(){ return faceReveals().filter(p=>p.who==='me'); }
function severityIndex(){
  const served = servedPunishments();
  if(!served.length) return 0;
  return Math.round(served.reduce((s,p)=>s+punishmentById(p.punishmentId).sev, 0) / served.length * 10) / 10;
}
function rewardPoints(){ return DB.rewardLog.filter(r=>r.who==='me').length * 25 + DB.xpEvents.filter(e=>e.reason==='Reward bonus').reduce((s,e)=>s+e.amount,0); }
function trophies(){ return DB.rewardLog.filter(r=>r.who==='me' && r.rewardId==='trophy').length; }
function shields(){ return DB.rewardLog.filter(r=>r.who==='me' && r.rewardId==='shield' && !r.used).length; }
function biggestPayout(){
  const wins = DB.bets.filter(b=>b.mine && b.status==='settled' && b.winners.includes('me'));
  return wins.length ? Math.max(...wins.map(payoutFor)) : 0;
}
function punishmentAllowed(pid){
  const p = punishmentById(pid);
  if(pid === 'faceReveal' && !DB.profile.faceReveal) return false;
  if(p.cat && DB.profile.offLimits.includes(p.cat)) return false;
  return true;
}

/* ── notifications & activity ── */
function notify(text, emoji, action){
  DB.notifications.unshift({id:uid('n'), ts:now(), text, emoji:emoji||'bell', read:false, action:action||null});
  if(typeof pulseBell === 'function') setTimeout(pulseBell, 60);
}
function logActivity(text, emoji, kind){
  DB.activity.unshift({id:uid('a'), ts:now(), text, emoji:emoji||'check', kind:kind||'bet'});
}
function unreadCount(){ return DB.notifications.filter(n=>!n.read).length; }

/* ═══════════ actions (all persist + re-render) ═══════════ */
function commit(){ saveDB(); renderApp(); }

function joinBet(betId, stake){
  const b = DB.bets.find(x=>x.id===betId);
  if(!b || b.participants.includes('me')) return;
  const amount = stake || b.stake;
  if(amount > balance()){ toast('Not enough in your wallet — you have ' + money(balance()) + '.', 'x'); return; }
  b.participants.push('me');
  b.mine = true;
  b.myProgress = b.myProgress || 0;
  ledgerAdd('stake', -amount, 'Stake · ' + b.title, b.id);
  addXP(XP.join, 'Joined a bet');
  logActivity(`You joined <b>${b.title}</b> for ${money(amount)}`, b.emoji, 'bet');
  notify(`You're in on ${b.title}. Pot is now ${money(betPot(b))}.`, b.emoji, {screen:'betDetail', params:{id:b.id}});
  toast(`Joined ${b.title} · ${money(amount)} staked`, 'users');
  commit();
}

function leaveBet(betId){
  const b = DB.bets.find(x=>x.id===betId);
  if(!b) return;
  b.participants = b.participants.filter(p=>p!=='me');
  b.mine = false;
  ledgerAdd('refund', b.stake, 'Refund · ' + b.title, b.id);
  logActivity(`You left <b>${b.title}</b> and got your stake back`, 'dot', 'bet');
  toast('Left the bet — stake refunded', 'dot');
  commit();
}

function createBet(data){
  const m = metricById(data.metricId);
  const bet = {
    id:uid('bet'), title:data.title, emoji:data.emoji || m.emoji, color:data.color || m.color,
    metricId:data.metricId, target:data.target, stake:data.stake,
    startedAt:now(), endsAt:now() + data.days*DAY, days:data.days,
    participants:['me', ...data.friends], progress:{}, myProgress:0,
    punishmentId:data.punishmentId, rewardId:data.rewardId,
    status:'live', mine:true, createdBy:'me', winners:[],
  };
  data.friends.forEach(f=>{ bet.progress[f] = 0; });
  DB.bets.unshift(bet);
  ledgerAdd('stake', -data.stake, 'Stake · ' + bet.title, bet.id);
  addXP(XP.join, 'Created a bet');
  logActivity(`You started <b>${bet.title}</b> — ${money(betPot(bet))} pot`, bet.emoji, 'bet');
  data.friends.forEach(f=>notify(`${personName(f)} was invited to ${bet.title}.`, 'link', {screen:'betDetail', params:{id:bet.id}}));
  toast('Bet created — friends invited', 'star');
  saveDB();
  return bet;
}

function logProgress(betId, amount){
  const b = DB.bets.find(x=>x.id===betId);
  if(!b) return;
  b.myProgress = Math.max(0, (b.myProgress||0) + amount);
  const m = metricById(b.metricId);
  if(m.id === 'workouts') logWorkout('Bet workout', 45);
  else addXP(10, 'Progress logged');
  logActivity(`You logged ${amount.toLocaleString()} ${m.unit} on <b>${b.title}</b>`, 'chart', 'progress');
  toast(`+${amount.toLocaleString()} ${m.unit} logged`, 'chart');
  commit();
}

function settleBet(betId){
  const b = DB.bets.find(x=>x.id===betId);
  if(!b || b.status !== 'live') return;
  if(typeof settleBetWith === 'function'){
    b.participants.forEach(p=>stampFinish(b, p));
    const done = b.participants.filter(p=>progressOf(b,p) >= b.target)
      .sort((x,y)=>(b.finished[x]||0)-(b.finished[y]||0));
    settleBetWith(b, done.length ? [done[0]] : [fitRank(b)[0]], done.length ? 'first-to-finish' : 'manual');
    renderApp();
    return;
  }
  const iHit = (b.myProgress||0) >= b.target;
  const winners = [];
  if(b.participants.includes('me') && iHit) winners.push('me');
  b.participants.filter(p=>p!=='me').forEach(p=>{
    if((b.progress[p]||0) >= b.target) winners.push(p);
  });
  if(!winners.length) winners.push(b.participants[Math.floor(Math.random()*b.participants.length)]);
  b.winners = winners;
  b.status = 'settled';
  b.endedAt = now();

  const iWon = winners.includes('me');
  if(b.participants.includes('me')){
    if(iWon){
      const pay = payoutFor(b);
      ledgerAdd('payout', pay, 'Payout · ' + b.title, b.id);
      addXP(XP.win, 'Bet won');
      const rw = rewardById(b.rewardId);
      DB.rewardLog.push({id:uid('rw'), ts:now(), who:'me', rewardId:rw.id, betId:b.id, used:false});
      if(rw.xp) addXP(rw.xp, 'Reward bonus');
      logActivity(`You won <b>${b.title}</b> — ${money(pay)} and ${rw.name}`, 'trophy', 'win');
      notify(`You won ${b.title}! ${money(pay)} landed in your wallet.`, 'trophy', {screen:'betDetail', params:{id:b.id}});
      toast(`You won ${money(pay)}!`, 'trophy');
    } else {
      const p = punishmentById(b.punishmentId);
      DB.punishLog.push({id:uid('pn'), ts:now(), who:'me', punishmentId:p.id, betId:b.id, status:'owed', dueAt:now()+DAY});
      logActivity(`You lost <b>${b.title}</b> — ${p.name} owed`, p.emoji, 'loss');
      notify(`You lost ${b.title}. ${p.name} is due within 24h.`, p.emoji, {screen:'punishments'});
      toast(`Lost — ${p.name} owed`, p.emoji);
    }
  }
  b.participants.filter(p=>p!=='me' && !winners.includes(p)).forEach(p=>{
    DB.punishLog.push({id:uid('pn'), ts:now(), who:p, punishmentId:b.punishmentId, betId:b.id, status:'owed', dueAt:now()+DAY});
  });
  resolvePredictions(b);
  commit();
}

function servePunishment(pid, proof){
  const p = DB.punishLog.find(x=>x.id===pid);
  if(!p) return;
  p.status = 'served';
  p.servedAt = now();
  if(proof) p.proof = proof;
  addXP(XP.punishmentServed, 'Punishment served');
  const cat = punishmentById(p.punishmentId);
  logActivity(`You served your <b>${cat.name}</b> — debt cleared`, cat.emoji, 'punishment');
  toast('Punishment served — respect', 'check');
  commit();
}

function withdraw(amount){
  if(amount <= 0 || amount > balance()) return false;
  ledgerAdd('withdraw', -amount, 'Withdrawal to bank');
  logActivity(`You withdrew ${money(amount)}`, 'wallet', 'wallet');
  toast(`${money(amount)} on the way to your bank`, 'wallet');
  commit();
  return true;
}
function deposit(amount){
  if(amount <= 0) return false;
  ledgerAdd('deposit', amount, 'Added funds');
  logActivity(`You added ${money(amount)} to your wallet`, 'wallet', 'wallet');
  toast(`${money(amount)} added`, 'wallet');
  commit();
  return true;
}

function sendInvite(email){
  DB.invites.push({email, ts:now()});
  addXP(XP.invite, 'Invite sent');
  logActivity(`You invited <b>${email}</b> to WannaBet`, 'link', 'friend');
  toast('Invite sent to ' + email, 'link');
  commit();
  return true;
}

function joinChallenge(cid){
  const c = DB.challenges.find(x=>x.id===cid);
  if(!c) return;
  c.joined = !c.joined;
  if(c.joined){
    c.participants++;
    addXP(XP.challengeDay, 'Joined a challenge');
    logActivity(`You joined <b>${c.title}</b>`, 'flag', 'challenge');
    toast('You’re in the challenge', 'flag');
  } else {
    c.participants--;
    toast('Left the challenge', 'users');
  }
  commit();
}

function markAllRead(){ DB.notifications.forEach(n=>n.read = true); commit(); }

/* ═══════════ demo seed ═══════════
   Builds a real history — settled bets with participants and
   winners — so every headline number on Home is computed, not
   hardcoded. Clearing it drops the app to genuine zeros.        */
function seedDemo(){
  const rnd = mulberry32(20260801);
  const T = now();
  const friendDefs = [
    {name:'Jay',   hue:16,  online:true,  target:[12,3]},
    {name:'Tasha', hue:330, online:true,  target:[9,2]},
    {name:'Dre',   hue:200, online:true,  target:[7,4]},
    {name:'Mina',  hue:268, online:true,  target:[6,1]},
    {name:'Chris', hue:142, online:false, target:[5,3]},
  ];
  DB.friends = friendDefs.map((f,i)=>({id:'f'+(i+1), name:f.name, hue:f.hue, online:f.online, since:T - (60+i*11)*DAY}));

  /* — my settled bets: 7 wins / 3 losses, profit exactly $120 — */
  const mySettled = [
    {t:'10K Steps Daily',        e:'steps', m:'steps',    tgt:10000, stake:5,  n:3, w:1, win:true,  d:64, pun:'funnyPhoto', rew:'pot'},
    {t:'Leg Day Showdown',       e:'dumbbell', m:'workouts', tgt:4,     stake:10, n:4, w:2, win:true,  d:57, pun:'coffee',     rew:'split'},
    {t:'Sunrise Run Week',       e:'sun', m:'minutes',  tgt:150,   stake:15, n:4, w:1, win:true,  d:49, pun:'earlyAlarm', rew:'pot'},
    {t:'No Junk Food',           e:'salad', m:'habit',    tgt:7,     stake:10, n:3, w:0, win:false, d:42, pun:'faceReveal', rew:'pot'},
    {t:'Weekend Warrior',        e:'bolt', m:'calories', tgt:3500,  stake:5,  n:4, w:2, win:true,  d:35, pun:'extraWork',  rew:'split'},
    {t:'Plank Off',              e:'yoga', m:'minutes',  tgt:60,    stake:5,  n:3, w:0, win:false, d:28, pun:'karaoke',    rew:'trophy'},
    {t:'Stair Climb Challenge',  e:'stairs', m:'steps',    tgt:12000, stake:20, n:3, w:2, win:true,  d:21, pun:'outfit',     rew:'pot'},
    {t:'5K Under 30',            e:'run', m:'minutes',  tgt:30,    stake:10, n:5, w:2, win:true,  d:14, pun:'videoMsg',   rew:'xpBoost'},
    {t:'Hydration Streak',       e:'drop', m:'habit',    tgt:7,     stake:10, n:4, w:0, win:false, d:9,  pun:'faceReveal', rew:'pot'},
    {t:'Gym Consistency Duel',   e:'dumbbell', m:'workouts', tgt:5,     stake:25, n:4, w:2, win:true,  d:4,  pun:'doubleUp',   rew:'trophy'},
  ];
  ledgerAdd('deposit', 50, 'Starting balance', null, T - 70*DAY);

  mySettled.forEach((s,i)=>{
    /* rotate who's in each bet so wins and losses spread across the crew
       instead of piling onto whoever happens to be first in the list */
    const pool = DB.friends.map(f=>f.id);
    const others = [];
    for(let k=0;k<s.n-1;k++) others.push(pool[(i*2 + k) % pool.length]);
    const rot = others.slice(i % others.length).concat(others.slice(0, i % others.length));
    const ended = T - s.d*DAY;
    const winners = s.win
      ? ['me', ...rot.slice(0, Math.max(0, s.w-1))]
      : rot.slice(0, Math.max(1, s.w || 1));
    const bet = {
      id:'seed_'+i, title:s.t, emoji:s.e, color:metricById(s.m).color, metricId:s.m, target:s.tgt,
      stake:s.stake, startedAt:ended - 7*DAY, endsAt:ended, endedAt:ended, days:7,
      participants:['me', ...others], progress:{}, myProgress: s.win ? s.tgt : Math.round(s.tgt*0.72),
      punishmentId:s.pun, rewardId:s.rew, status:'settled', mine:true, createdBy: i%3===0 ? 'me' : others[0], winners,
    };
    others.forEach(o=>{ bet.progress[o] = winners.includes(o) ? s.tgt : Math.round(s.tgt*(0.5+rnd()*0.4)); });
    DB.bets.push(bet);
    ledgerAdd('stake', -s.stake, 'Stake · ' + s.t, bet.id, bet.startedAt);
    addXP(XP.join, 'Joined a bet', bet.startedAt);
    if(s.win){
      ledgerAdd('payout', payoutFor(bet), 'Payout · ' + s.t, bet.id, ended);
      addXP(XP.win, 'Bet won', ended);
      DB.rewardLog.push({id:uid('rw'), ts:ended, who:'me', rewardId:s.rew, betId:bet.id, used:false});
      const rw = rewardById(s.rew);
      if(rw.xp) addXP(rw.xp, 'Reward bonus', ended);
    } else {
      const status = i === 8 ? 'owed' : 'served';
      DB.punishLog.push({id:'pn_'+i, ts:ended, who:'me', punishmentId:s.pun, betId:bet.id, status,
        servedAt: status==='served' ? ended + 2*3600000 : undefined, dueAt: ended + DAY,
        proof: status==='served' && s.pun==='faceReveal' ? 'revealed' : undefined});
      if(status === 'served') addXP(XP.punishmentServed, 'Punishment served', ended);
    }
  });

  /* — friend-only history so their records are real, not decoration — */
  let fb = 0;
  DB.friends.forEach((f,i)=>{
    const rec = friendRecord(f.id);
    const [tw, tl] = friendDefs[i].target;
    const needW = Math.max(0, tw - rec.w), needL = Math.max(0, tl - rec.l);
    for(let k=0;k<needW+needL;k++){
      const won = k < needW;
      /* opponent is someone outside your friends list, so one friend's
         result never quietly rewrites another friend's record */
      const outsider = 'ext_' + i + '_' + k;
      const ended = T - Math.floor(5 + rnd()*80)*DAY;
      DB.bets.push({
        id:'fseed_'+(fb++), title:'Friends-only bet', emoji:'boxing', color:'#8B5CF6', metricId:'workouts', target:4,
        stake:5, startedAt:ended-7*DAY, endsAt:ended, endedAt:ended, days:7,
        participants:[f.id, outsider],
        progress:{}, punishmentId:'funnyPhoto', rewardId:'pot', status:'settled', mine:false,
        createdBy:f.id, winners: won ? [f.id] : [outsider],
      });
    }
  });

  /* — live bets (the three on the mockup) — */
  const live = [
    {id:'live1', t:'10K Steps Daily',      e:'shoe', m:'steps',    tgt:10000, stake:5,  days:4, others:['f1','f2','f3'], joined:false},
    {id:'live2', t:'5 Workouts This Week', e:'flameS', m:'workouts', tgt:5,     stake:5,  days:2, others:['f1','f4','f5'], joined:false},
    {id:'live3', t:'No Junk Food',         e:'dumbbellS', m:'habit',    tgt:7,     stake:5,  days:5, others:['f2','f3','f4','f5'], joined:false},
  ];
  live.forEach(l=>{
    const bet = {
      id:l.id, title:l.t, emoji:l.e, color:metricById(l.m).color, metricId:l.m, target:l.tgt, stake:l.stake,
      startedAt:T - (7-l.days)*DAY, endsAt:T + l.days*DAY, days:7,
      participants:[...l.others], progress:{}, myProgress:0,
      punishmentId: l.id==='live2' ? 'faceReveal' : (l.id==='live1' ? 'coffee' : 'outfit'),
      rewardId: l.id==='live3' ? 'trophy' : 'pot',
      status:'live', mine:false, createdBy:l.others[0], winners:[],
    };
    l.others.forEach(o=>{ bet.progress[o] = Math.round(l.tgt * (0.3 + rnd()*0.5)); });
    DB.bets.push(bet);
  });

  /* — workout log: real days behind "14 this week" and the streak — */
  const pattern = [3,3,3,0,2,3,0,2,3,0,3,2,3,0,2,3,2,0,3,2,3,0,2,3,2,3,0,2,3,2];
  pattern.forEach((count, back)=>{
    for(let k=0;k<count;k++){
      const ts = startOfDay(T) - back*DAY + (7 + k*3)*3600000;
      DB.workouts.push({id:uid('w'), ts, type:['Gym','Run','Walk','Cycle','Yoga'][Math.floor(rnd()*5)], minutes:30 + Math.floor(rnd()*45)});
      addXP(XP.workout, 'Workout logged', ts);
    }
  });
  for(let d=0; d<streakDays(); d++) addXP(XP.streakDay, 'Streak day', T - d*DAY);
  addXP(XP.onboard, 'Profile complete', DB.createdAt);

  /* — this week's challenge is generated, not stored — just enter it — */
  DB.challenges = [];
  DB.challengeJoins = {};
  DB.challengeJoins[weeklyChallenge(0).id] = true;

  /* — notifications & feed built from what actually happened — */
  const lastWin = settledMine().find(b=>b.winners.includes('me'));
  const owed = owedPunishments()[0];
  if(owed){
    const p = punishmentById(owed.punishmentId);
    DB.notifications.push({id:uid('n'), ts:owed.ts, read:false, emoji:p.emoji,
      text:`You owe a ${p.name} from ${DB.bets.find(b=>b.id===owed.betId).title}.`, action:{screen:'punishments'}});
  }
  if(lastWin){
    DB.notifications.push({id:uid('n'), ts:lastWin.endedAt, read:false, emoji:'trophy',
      text:`You won ${lastWin.title} — ${money(payoutFor(lastWin))} paid out.`, action:{screen:'betDetail', params:{id:lastWin.id}}});
  }
  DB.notifications.push({id:uid('n'), ts:T - 5*3600000, read:false, emoji:'steps',
    text:`${personName('f1')} is 2,400 steps ahead of the pack in 10K Steps Daily.`, action:{screen:'betDetail', params:{id:'live1'}}});
  const wkc = weeklyChallenge(0);
  DB.notifications.push({id:uid('n'), ts:T - 26*3600000, read:true, emoji:wkc.glyph,
    text:`${wkc.title} is live — ${Math.max(0, wkc.goal - challengeProgress(wkc))} more active ${plural(Math.max(0, wkc.goal - challengeProgress(wkc)),'day')} for the ${money(wkc.prize)} pot.`,
    action:{screen:'challengeDetail', params:{id:wkc.id}}});
  DB.notifications.sort((a,b)=>b.ts-a.ts);

  settledMine().slice(0,6).forEach(b=>{
    const won = b.winners.includes('me');
    DB.activity.push({id:uid('a'), ts:b.endedAt, kind: won?'win':'loss', emoji: won?'trophy':punishmentById(b.punishmentId).emoji,
      text: won ? `You won <b>${b.title}</b> — ${money(payoutFor(b))}` : `You lost <b>${b.title}</b> — ${punishmentById(b.punishmentId).name} owed`});
  });
  DB.workouts.slice(-4).forEach(w=>{
    DB.activity.push({id:uid('a'), ts:w.ts, kind:'progress', emoji:'dumbbell', text:`You logged a <b>${w.type}</b> session — ${w.minutes} min`});
  });
  DB.activity.sort((a,b)=>b.ts-a.ts);

  DB.demoSeeded = true;
  saveDB();
}

function clearDemo(){
  DB.friends = []; DB.bets = []; DB.ledger = []; DB.xpEvents = []; DB.workouts = [];
  DB.punishLog = []; DB.rewardLog = []; DB.notifications = []; DB.activity = []; DB.invites = [];
  DB.challenges = [];
  addXP(XP.onboard, 'Profile complete', DB.createdAt);
  DB.demoSeeded = false;
  toast('Demo data cleared — this is a real empty account', 'refresh');
  commit();
}

/* ── toasts ── */
function toast(msg, icon){
  const layer = document.getElementById('toastLayer');
  if(!layer) return;
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<span class="tic">${G(icon||'check')}</span><span>${msg}</span>`;
  layer.appendChild(el);
  symbolEffect(el.querySelector('.tic .ico'), 'bounce');
  setTimeout(()=>{ el.classList.add('out'); setTimeout(()=>el.remove(), 320); }, 2600);
}


/* ═══════════════ MAIN APP — icons, router, screens ═══════════════ */

