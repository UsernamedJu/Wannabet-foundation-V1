/* ═════════════════ HOME v2 + HUBS ═════════════════ */

/* ═══════════════ Smart odds ═══════════════ */
const ODDS_TIERS = [
  {id:'heavyDog', name:'Heavy Underdog', lo:0,  hi:39,  odds:'+200', note:'Higher payout', color:'#8B5CF6'},
  {id:'dog',      name:'Underdog',       lo:40, hi:55,  odds:'+120', note:'',              color:'#2563EB'},
  {id:'even',     name:'Even Match',     lo:56, hi:70,  odds:'+100', note:'Balanced',      color:'#22C55E'},
  {id:'fav',      name:'Favorite',       lo:71, hi:85,  odds:'-120', note:'',              color:'#F2620F'},
  {id:'heavyFav', name:'Heavy Favorite', lo:86, hi:100, odds:'-200', note:'Lower payout',  color:'#EF4444'},
];
function myTier(){
  const r = settledMine().length ? winRate() : 50;
  return ODDS_TIERS.find(t=>r>=t.lo && r<=t.hi) || ODDS_TIERS[2];
}
/* a bet's odds move with the field size and how much clock is left */
function betOdds(b){
  const base = (settledMine().length ? winRate() : 50) / 100;
  const clockLeft = b.days ? Math.max(0.15, daysLeft(b.endsAt) / b.days) : 1;
  const field = Math.max(0, b.participants.length - 2);
  const p = clamp(base * (0.82 + 0.24 * clockLeft) - field * 0.035, 0.08, 0.92);
  return {p, ...toAmericanOdds(p), mult: Math.round((1/p) * 100) / 100};
}
function personOdds(pid, b){
  let p;
  if(pid === 'me') p = betOdds(b).p;
  else {
    const r = friendRecord(pid);
    const rate = (r.w + r.l) ? r.w / (r.w + r.l) : 0.5;
    const prog = (b.progress[pid] || 0) / (b.target || 1);
    p = clamp(rate * 0.72 + Math.min(1, prog) * 0.28, 0.1, 0.9);
  }
  return {p, mult: Math.round((1/p) * 100) / 100};
}

/* ═══════════════ predictions ═══════════════ */
function openPredictionBet(){
  return liveBets().find(b=>b.participants.filter(p=>p!=='me').length >= 2) || liveBets()[0] || null;
}
function placePrediction(betId, personId, stake){
  const b = DB.bets.find(x=>x.id===betId);
  if(!b) return;
  if(stake > balance()){ toast('Not enough in your wallet — you have ' + money(balance()), 'x'); return; }
  const o = personOdds(personId, b);
  DB.predictions.push({id:uid('pr'), ts:now(), betId, personId, stake, mult:o.mult, status:'open'});
  ledgerAdd('stake', -stake, 'Prediction · ' + personName(personId) + ' on ' + b.title, b.id);
  logActivity(`You backed <b>${escapeHtml(personName(personId))}</b> at ${o.mult}x on ${escapeHtml(b.title)}`, 'dice', 'bet');
  toast(`Prediction placed · ${o.mult}x on ${personName(personId)}`, 'dice');
  commit();
}
function resolvePredictions(b){
  DB.predictions.filter(p=>p.betId === b.id && p.status === 'open').forEach(p=>{
    if(b.winners.includes(p.personId)){
      const payout = Math.round(p.stake * p.mult * 100) / 100;
      p.status = 'won'; p.payout = payout;
      ledgerAdd('payout', payout, 'Prediction win · ' + personName(p.personId), b.id);
      addXP(60, 'Prediction won');
      logActivity(`Your ${p.mult}x call on <b>${escapeHtml(personName(p.personId))}</b> landed — ${money(payout)}`, 'dice', 'win');
    } else {
      p.status = 'lost';
      logActivity(`Your call on <b>${escapeHtml(personName(p.personId))}</b> missed`, 'dice', 'loss');
    }
  });
}
function openPredictions(){ return DB.predictions.filter(p=>p.status === 'open'); }

/* ═══════════════ leaderboard ═══════════════ */
let lbRange = 'month';
const LB_WINDOWS = {week:7, month:30, all:3650};
function leaderboard(range){
  const cut = now() - (LB_WINDOWS[range||lbRange]) * DAY;
  const ids = ['me', ...DB.friends.map(f=>f.id)];
  return ids.map(id=>{
    const played = DB.bets.filter(b=>b.status === 'settled' && b.endedAt >= cut && b.participants.includes(id));
    const won = played.filter(b=>b.winners.includes(id));
    const cash = won.reduce((s,b)=>s + payoutFor(b), 0);
    return {id, name:personName(id), played:played.length, won:won.length,
            pts: won.length * 200 + played.length * 25, cash};
  }).sort((a,b)=>b.pts - a.pts || b.cash - a.cash);
}

/* ═══════════════ recovery (from training load, not invented sensors) ═══════════════ */
function recovery(){
  const l7 = workoutsInLastDays(7), l3 = workoutsInLastDays(3);
  const restDays = 7 - activeDaysInWindow(7);
  const avg = l7 / 7;
  const load = l3 - avg * 3;
  let score = 72 + restDays * 5 - Math.max(0, load) * 8 + Math.min(8, streakDays());
  score = clamp(Math.round(score), 18, 99);
  const label  = score >= 80 ? 'Great' : score >= 65 ? 'Solid' : score >= 45 ? 'Easy' : 'Rest';
  const phrase = score >= 80 ? 'Good to go' : score >= 65 ? 'Solid — keep it steady' : score >= 45 ? 'Take it easy today' : 'Rest up';
  const fatigue = load > 1.5 ? 'High' : load > 0.4 ? 'Med' : 'Low';
  /* sleep and HRV come from the connected provider; without it they read as unavailable */
  const conn = typeof healthOn === 'function' && healthOn();
  const sleep = conn ? clamp(Math.round(72 + restDays * 4 - Math.max(0, load) * 3), 40, 99) : '—';
  const hrv   = conn ? clamp(Math.round(52 + (7 - l3) * 3 + Math.min(8, streakDays())), 20, 99) : '—';
  return {score, label, phrase, fatigue, l7, l3, restDays, sleep, hrv, connected:conn,
          color: score >= 80 ? '#22C55E' : score >= 65 ? '#F59E0B' : '#EF4444'};
}

/* ═══════════════ community feed (real events, your reactions) ═══════════════ */
function communityEvents(limit){
  const out = [];
  DB.bets.filter(b=>b.status === 'settled' && b.participants.some(p=>p !== 'me' && p.indexOf('ext_') !== 0))
    .sort((a,b)=>b.endedAt - a.endedAt).slice(0, 14).forEach(b=>{
      b.winners.filter(w=>w !== 'me' && w.indexOf('ext_') !== 0).forEach(w=>{
        out.push({id:'ev_' + b.id + '_' + w, who:w, ts:b.endedAt,
                  text:`<b>${escapeHtml(personName(w))}</b> won ${money(payoutFor(b))} on ${escapeHtml(b.title)}`});
      });
    });
  liveBets().forEach(b=>{
    b.participants.filter(p=>p !== 'me').slice(0,2).forEach(p=>{
      const pct = Math.round((b.progress[p]||0) / (b.target||1) * 100);
      if(pct >= 50) out.push({id:'evp_' + b.id + '_' + p, who:p, ts:now() - 3*3600000,
        text:`<b>${escapeHtml(personName(p))}</b> is ${pct}% through ${escapeHtml(b.title)}`});
    });
  });
  DB.punishLog.filter(p=>p.who !== 'me' && p.status === 'served').slice(0,4).forEach(p=>{
    out.push({id:'evx_' + p.id, who:p.who, ts:p.servedAt || p.ts,
      text:`<b>${escapeHtml(personName(p.who))}</b> served a ${punishmentById(p.punishmentId).name}`});
  });
  return out.sort((a,b)=>b.ts - a.ts).slice(0, limit || 20);
}
function react(id){
  DB.reactions[id] = DB.reactions[id] || {n:0, mine:false};
  const r = DB.reactions[id];
  r.mine = !r.mine;
  r.n += r.mine ? 1 : -1;
  commit();
}
function reactionOf(id){ return DB.reactions[id] || {n:0, mine:false}; }

/* ═══════════════ HOME ═══════════════ */
function homeHeader(){
  const s = streakDays();
  const unread = unreadCount();
  return `
  <div class="hdr">
    <img class="hdr-av press" src="${personAvatar('me')}" alt="" onclick="setTab('profile')">
    <div class="hdr-txt" onclick="setTab('profile')">
      <div class="hdr-hi"><span class="hi-t">Welcome back,</span></div>
      <div class="hdr-row">
        <div class="hdr-name">${escapeHtml(DB.account.name || 'Champ')}</div>
        <button class="streak-chip press" onclick="event.stopPropagation();go('streaks')" aria-label="${s} day streak — open Streaks">
          <span class="fl">${ic('flameS')}</span><span class="lbl">${s}</span><span class="lbl-long"> day streak</span>
        </button>
      </div>
    </div>
    <div class="wallet-pill">
      <button class="coin press" onclick="go('wallet')" aria-label="Wallet">$</button>
      <span class="amt press" onclick="go('wallet')">${money(balance())}</span>
      <button class="add" onclick="moneySheet('deposit')" aria-label="Add funds">${I.plus}</button>
    </div>
    <button class="bell press" onclick="go('notifications')" aria-label="Notifications">${I.bell}${unread?'<span class="dot"></span>':''}</button>
  </div>`;
}

function oddsCard(){
  const tier = myTier();
  const rate = settledMine().length ? winRate() : 50;
  return `<div class="odds-card">
    <div class="odds-head">
      <div style="flex:1;min-width:0">
        <h4>Your Smart Odds <button class="help-dot" onclick="event.stopPropagation();oddsHelp()" aria-label="How odds work">?</button></h4>
        <p>Odds adjust based on your performance and consistency.</p>
      </div>
      <span class="pill pill-green odds-rate">Win rate: ${rate}% dot</span>
    </div>
    <div class="odds-strip">
      ${ODDS_TIERS.map(t=>`<button class="odds-tier ${t.id===tier.id?'on':''}" onclick="go('smartOdds')">
        <div class="t-name">${t.name}</div>
        <div class="t-range">${t.lo} - ${t.hi}${t.hi===100?'%+':'%'}</div>
        <div class="t-odds" style="color:${t.color}">${t.odds}</div>
        <div class="t-note" style="color:${t.id===tier.id?'var(--green)':'var(--ink-faint)'}">${t.id===tier.id?(t.note||'You are here'):t.note}</div>
      </button>`).join('')}
    </div>
    <div class="odds-foot">${ic('sparkle')} Keep winning to improve your odds and unlock bigger challenges!</div>
  </div>`;
}

function betCard(b){
  const joined = b.participants.includes('me');
  const dl = daysLeft(b.endsAt);
  const total = Math.min(7, b.days || 7);
  const elapsed = Math.max(0, Math.min(total, total - dl));
  const o = betOdds(b);
  return `<div class="bet-card">
    <div class="bet-top">
      <div class="bet-emoji" style="background:${b.color}1F">${G(b.emoji)}</div>
      ${avStack(b.participants)}
    </div>
    <div onclick="go('betDetail',{id:'${b.id}'})">
      <div class="bet-title">${escapeHtml(b.title)}</div>
      <div class="bet-meta">${money(betPot(b))} Pot &nbsp;•&nbsp; ${dl} ${plural(dl,'day')} left</div>
    </div>
    <div class="bet-odds">
      <span class="lbl">Your odds</span>
      <button class="pill ${o.favorite?'pill-red':'pill-brand'} press" onclick="go('smartOdds')">${o.text}</button>
    </div>
    <div class="pdots">${Array.from({length:total},(_,i)=>`<span class="pdot ${i<elapsed?'on':''}" style="${i<elapsed?`background:${b.color}`:''}"></span>`).join('')}</div>
    ${joined
      ? `<button class="btn-join done press" onclick="go('betDetail',{id:'${b.id}'})">Joined check</button>`
      : `<button class="btn-join neon press" onclick="joinSheet('${b.id}')">Join</button>`}
  </div>`;
}

function streakHubCard(){
  const s = streakDays();
  const days = workoutDays();
  const today = startOfDay(now());
  const mondayOffset = (new Date(today).getDay() + 6) % 7;
  const weekStart = today - mondayOffset * DAY;
  const labels = ['M','T','W','T','F','S','S'];
  return `<div class="hub">
    <div class="hub-t">Streaks</div>
    <div class="hub-s">Consistency pays.</div>
    <div class="streak-big" style="display:flex;align-items:center;justify-content:center;gap:12px">
      <div><div class="n">${s}</div><div class="l">Day Streak</div></div>
      <div class="fl">${ic('flameS')}</div>
    </div>
    <div class="week-dots">
      ${labels.map((l,i)=>{
        const d = weekStart + i*DAY;
        const on = days.includes(d);
        return `<div><div class="wd-l">${l}</div><div class="wd-c ${on?'on':''} ${d===today?'today':''}">${on?ic('check'):''}</div></div>`;
      }).join('')}
    </div>
    <button class="hub-cta press" onclick="go('streaks')">Longest: ${longestStreak()} days</button>
  </div>`;
}
function longestStreak(){
  const days = workoutDays().slice().sort((a,b)=>a-b);
  let best = 0, run = 0, prev = null;
  days.forEach(d=>{ run = (prev !== null && d === prev + DAY) ? run + 1 : 1; prev = d; if(run > best) best = run; });
  return best;
}

function predictionHubCard(){
  const b = openPredictionBet();
  if(!b) return `<button class="hub press" onclick="setTab('bets')">
    <div class="hub-t">Prediction Bets</div><div class="hub-s">Predict outcomes, win big.</div>
    <div class="hub-cta dark">Find a live bet</div></button>`;
  const people = b.participants.filter(p=>p!=='me').slice(0,3);
  return `<div class="hub">
    <div class="hub-t">Prediction Bets</div>
    <div class="hub-s">Predict outcomes, win big.</div>
    <div style="background:#FAF7F4;border-radius:14px;padding:11px 12px;margin-bottom:12px">
      <div style="font-size:12.5px;font-weight:800;margin-bottom:4px">Who hits their goal first?</div>
      ${people.map(p=>{
        const o = personOdds(p, b);
        const ahead = (b.progress[p]||0) / (b.target||1) >= 0.5;
        return `<div class="pred-row"><img src="${personAvatar(p)}" alt="">
          <span class="p-n">${escapeHtml(personName(p))}</span>
          <span class="p-m">${o.mult}x</span>
          <span class="p-a" style="color:${ahead?'var(--green)':'var(--red)'}">${ic(ahead?'arrowUp':'arrowDown')}</span></div>`;
      }).join('')}
    </div>
    <button class="hub-cta dark neon press" onclick="go('predictions')">Bet Now</button>
  </div>`;
}

function leaderboardCard(){
  const rows = leaderboard().slice(0,3);
  return `<div class="card" style="margin:0 16px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
      <div class="hub-t">Leaderboard</div>
      <button class="pill pill-grey press" onclick="go('leaderboard')">This ${lbRange === 'week' ? 'week' : lbRange === 'month' ? 'month' : 'season'} ⌄</button>
    </div>
    ${rows.length ? rows.map((r,i)=>lbRow(r,i)).join('') : '<p class="tagline">Settle a bet to get on the board.</p>'}
    <button class="hub-cta press" style="margin-top:12px" onclick="go('leaderboard')">View full leaderboard</button>
  </div>`;
}
function lbRow(r, i){
  return `<div class="lb-row ${r.id==='me'?'me':''}">
    <span class="lb-rank ${i===0?'g1':i===1?'g2':i===2?'g3':''}">${i+1}</span>
    <img src="${personAvatar(r.id)}" alt="">
    <span class="lb-name">${escapeHtml(r.name)}${r.id==='me'?' (You)':''}</span>
    <span class="lb-pts">${r.pts.toLocaleString()} pts</span>
    <span class="lb-cash">${money(r.cash)}</span>
  </div>`;
}

function insightHubCard(){
  const ins = insights()[0];
  return `<div class="hub">
    <div class="hub-t">Insights</div>
    <div class="hub-s">Patterns pulled from your own log.</div>
    <div class="insight-box"><div class="txt">${ins.text}</div><div class="brain">${ic('brain')}</div></div>
    <button class="hub-cta press" onclick="go('insights')">View Insights</button>
  </div>`;
}
/* gauge ring: gradient arc, rounded cap, small gap at the bottom */
const RING_STOPS = {
  great:['#C6E100','#2FA84F'],
  solid:['#FFD84A','#F2A20F'],
  low:  ['#FFA07A','#E23B2E'],
};
function ringSVG(score, color, size, stroke){
  const band = score >= 80 ? 'great' : score >= 65 ? 'solid' : 'low';
  const [c1, c2] = RING_STOPS[band];
  const id = 'rg' + Math.random().toString(36).slice(2,7);
  const r = (size - stroke) / 2, mid = size / 2;
  const C = 2 * Math.PI * r;
  const GAP = 0.14;                    /* 14% of the circle left open at the bottom */
  const track = C * (1 - GAP);
  const filled = track * Math.max(0, Math.min(100, score)) / 100;
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
    <defs><linearGradient id="${id}" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="${c1}"/><stop offset="1" stop-color="${c2}"/></linearGradient></defs>
    <g transform="rotate(${90 + GAP*180} ${mid} ${mid})">
      <circle cx="${mid}" cy="${mid}" r="${r}" stroke="#EFEDE6" stroke-width="${stroke}" fill="none"
        stroke-linecap="round" stroke-dasharray="${track} ${C}"/>
      <circle class="arc" cx="${mid}" cy="${mid}" r="${r}" stroke="url(#${id})" stroke-width="${stroke}" fill="none"
        stroke-linecap="round" stroke-dasharray="${filled} ${C}" stroke-dashoffset="${filled}" data-dash="0"/>
    </g></svg>`;
}
function fatigueColor(f){ return f === 'Low' ? 'var(--green)' : f === 'Med' ? 'var(--amber)' : 'var(--red)'; }
function recoveryHubCard(){
  const r = recovery();
  return `<div class="hub">
    <div class="hub-t">Recovery Score</div>
    <div class="hub-s">Ready to perform?</div>
    <div class="rec-grid">
      <div class="ring" style="width:78px;height:78px">
        ${ringSVG(r.score, r.color, 78, 8)}
        <div class="rv"><b>${r.score}</b><span>${r.label}</span></div>
      </div>
      <div class="rec-vits">
        <div class="vit"><span class="k">Sessions 7d</span><span class="v">${r.l7}</span></div>
        <div class="vit"><span class="k">Fatigue</span><span class="v" style="color:${fatigueColor(r.fatigue)}">${r.fatigue}</span></div>
        <div class="vit"><span class="k">Rest days</span><span class="v">${r.restDays}</span></div>
      </div>
    </div>
    <div class="rec-state" style="background:${r.color}14;color:${r.color}">${r.score>=65?'check':'moon'} ${r.phrase}</div>
    <button class="hub-cta press" onclick="go('recovery')">Tips to improve</button>
  </div>`;
}
function communityHubCard(){
  const ev = communityEvents(2);
  return `<div class="hub">
    <div class="hub-t">Community Feed</div>
    <div class="hub-s">See what's happening.</div>
    <div style="margin-bottom:12px">
      ${ev.length ? ev.map(e=>{
        const r = reactionOf(e.id);
        return `<div class="feed-mini"><img src="${personAvatar(e.who)}" alt="">
          <div class="fm"><div class="fm-t">${e.text}</div><div class="fm-s">${timeAgo(e.ts)}</div></div>
          <button class="react ${r.mine?'on':''}" onclick="react('${e.id}')">${ic('flame')} ${r.n}</button></div>`;
      }).join('') : '<p class="tagline">Your friends’ results will show up here.</p>'}
    </div>
    <button class="hub-cta press" onclick="go('community')">View Community</button>
  </div>`;
}

function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  const banners = [];
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    banners.push(`<div class="banner banner-red">
      <div class="b-ic">${G(p.emoji)}</div>
      <div class="b-main"><div class="b-t">You owe a ${p.name}</div><div class="b-s">From ${escapeHtml((DB.bets.find(b=>b.id===owed[0].betId)||{}).title||'a bet')} · ${owed[0].dueAt < now() ? 'overdue' : 'due within 24h'}</div></div>
      <button class="b-go press" onclick="go('punishments')">Settle up</button>
    </div>`);
  }
  if(DB.demoSeeded && !DB.demoNoticeSeen){
    banners.push(`<div class="banner banner-info">
      <div class="b-ic">${ic('sparkle')}</div>
      <div class="b-main"><div class="b-t">Demo data loaded</div><div class="b-s">${DB.friends.length} friends and ${DB.bets.filter(b=>b.mine).length} past bets were seeded so the app has real numbers to add up. Clear it in Profile → Demo data.</div></div>
      <button class="b-x press" onclick="DB.demoNoticeSeen=true;commit()" aria-label="Dismiss">${ic('x')}</button>
    </div>`);
  }
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${banners.join('')}

    <div class="sec"><h3>Your Overview</h3><button class="link" onclick="go('overview')">View all</button></div>
    ${homeStats()}

    <div style="margin-top:20px">${oddsCard()}</div>

    <div class="sec"><h3>Live Bets</h3><button class="link" onclick="setTab('bets')">View all</button></div>
    ${live.length ? `<div class="rail stagger">${live.slice(0,6).map(betCard).join('')}</div>`
      : emptyState('dice','No live bets','Start one and put something on the line.',`<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}

    <div class="rail stagger" style="margin-top:18px;align-items:stretch">
      ${challengeHubCard()}
      ${streakHubCard()}
      ${predictionHubCard()}
    </div>

    <div class="sec"><h3>Your Friends</h3><button class="link" onclick="inviteSheet()">Invite</button></div>
    ${DB.friends.length ? `<div class="rail stagger">
        ${DB.friends.map(friendTile).join('')}
        <button class="friend invite-tile press" onclick="inviteSheet()">
          <div class="friend-av">${I.userplus}</div><div class="friend-name">Invite<br>more</div>
        </button>
      </div>`
      : emptyState('users','No friends yet','Bets are better with someone to beat.',`<button class="btn btn-primary" onclick="inviteSheet()">Invite a friend</button>`)}

    <div style="margin-top:18px">${leaderboardCard()}</div>

    <div class="rail stagger" style="margin-top:18px;align-items:stretch">
      ${insightHubCard()}
      ${recoveryHubCard()}
      ${communityHubCard()}
    </div>
    <div style="height:10px"></div>
  </div>`;
}

/* ═══════════════ new hubs ═══════════════ */
function oddsHelp(){
  appSheet('How Smart Odds work', `
    <p>Your tier comes straight from your settled record — ${betsWon()} ${plural(betsWon(),'win')} and ${betsLost()} ${plural(betsLost(),'loss','losses')}, a ${winRate()}% win rate. Nothing here is hand-set.</p>
    <p>Per-bet odds start from that number, then move with the size of the field and how much clock is left. A crowded bet with two days to run is a longer shot than a head-to-head that just opened.</p>
    <p>Longer odds pay more. Win consistently and you drift toward favourite — safer, smaller payouts.</p>
    <button class="btn btn-primary btn-block" onclick="closeSheet();go('smartOdds')">Open Smart Odds</button>`);
}
function screenSmartOdds(){
  const tier = myTier();
  const rate = settledMine().length ? winRate() : 50;
  const live = liveBets();
  return `<div class="pane">${appbar('Smart Odds')}
    <div class="pad">
      <div class="card" style="text-align:center">
        <div class="row-s">Your current tier</div>
        <div style="font-size:28px;font-weight:800;letter-spacing:-.03em;margin:4px 0;color:${tier.color}">${tier.name}</div>
        <div style="font-size:40px;font-weight:800;letter-spacing:-.04em">${tier.odds}</div>
        <div class="row-s">${rate}% win rate over ${settledMine().length} settled ${plural(settledMine().length,'bet')}</div>
      </div>
      <div class="card"><div class="card-h">All tiers</div>
        ${ODDS_TIERS.map(t=>`<div class="row ${t.id===tier.id?'':''}">
          <div class="row-ic" style="background:${t.color}1F;color:${t.color};font-weight:800;font-size:13px">${t.odds}</div>
          <div class="row-main"><div class="row-t">${t.name} ${t.id===tier.id?'<span class="pill pill-green" style="margin-left:6px">You</span>':''}</div>
          <div class="row-s">${t.lo}–${t.hi}% win rate · ${t.note||'standard payout'}</div></div></div>`).join('')}
      </div>
      <div class="card"><div class="card-h">Odds on live bets</div>
        ${live.length ? live.map(b=>{
          const o = betOdds(b);
          return `<div class="row tap" onclick="go('betDetail',{id:'${b.id}'})">
            <div class="row-ic" style="background:${b.color}1F">${G(b.emoji)}</div>
            <div class="row-main"><div class="row-t">${escapeHtml(b.title)}</div>
            <div class="row-s">${b.participants.length} in the field · ${daysLeft(b.endsAt)} ${plural(daysLeft(b.endsAt),'day')} left · ${o.mult}x payout</div></div>
            <div class="row-v" style="color:${o.favorite?'var(--red)':'var(--brand)'}">${o.text}</div></div>`;
        }).join('') : '<p class="tagline">No live bets right now.</p>'}
      </div>
      <div class="card"><div class="card-h">How it moves</div>
        <p class="tagline">Win rate sets the tier. Field size and time left adjust each bet. Serve your punishments and keep the streak alive — both feed the consistency the tiers are built on.</p>
        <button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="go('overview')">See the numbers behind it</button>
      </div>
    </div><div style="height:18px"></div></div>`;
}

function screenStreaks(){
  const s = streakDays();
  const days = workoutDays();
  const today = startOfDay(now());
  return `<div class="pane">${appbar('Streaks')}
    <div class="pad">
      <div class="card" style="text-align:center">
        <div style="font-size:52px;color:#E2571B">${ic('flameS')}</div>
        <div style="font-size:44px;font-weight:800;letter-spacing:-.04em;line-height:1" data-count="${s}">0</div>
        <div class="row-s">day streak · longest ${longestStreak()} days</div>
      </div>
      <div class="card"><div class="card-h">Last 28 days</div>
        <div style="display:flex;flex-wrap:wrap;gap:5px">
          ${Array.from({length:28},(_,i)=>{
            const d = today - (27-i)*DAY;
            const on = days.includes(d);
            return `<span style="width:calc(14.28% - 5px);aspect-ratio:1;border-radius:7px;background:${on?'var(--brand)':'#EDE8E3'};${d===today?'box-shadow:0 0 0 2.5px rgba(242,98,15,.35);':''}"></span>`;
          }).join('')}
        </div>
        <p class="tagline" style="margin-top:12px">${activeDaysInWindow(28)} active days out of 28.</p>
      </div>
      <div class="card">
        <div class="row"><div class="row-main"><div class="row-t">Workouts this week</div></div><div class="row-v">${workoutsThisWeek()}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Streak shields banked</div><div class="row-s">Win a bet with the shield reward to bank one</div></div><div class="row-v">${shields()}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">XP from streak days</div></div><div class="row-v">${DB.xpEvents.filter(e=>e.reason==='Streak day').reduce((x,e)=>x+e.amount,0)}</div></div>
      </div>
      <button class="btn btn-primary btn-block" onclick="quickWorkout()">Log a workout</button>
    </div><div style="height:18px"></div></div>`;
}

function screenPredictions(){
  const bets = liveBets();
  const open = openPredictions();
  return `<div class="pane">${appbar('Prediction Bets')}
    <div class="pad">
      <div class="card"><div class="card-h">How this works</div>
        <p class="tagline">Back whoever you think clears their target first. Multipliers come from each person's record and how far along they already are — the further behind, the bigger the payout.</p>
      </div>
      ${open.length ? `<div class="card"><div class="card-h">Your open calls — ${open.length}</div>
        ${open.map(p=>{
          const b = DB.bets.find(x=>x.id===p.betId) || {title:'a bet'};
          return `<div class="row"><img src="${personAvatar(p.personId)}" style="width:36px;height:36px;border-radius:50%">
            <div class="row-main"><div class="row-t">${escapeHtml(personName(p.personId))} · ${p.mult}x</div>
            <div class="row-s">${money(p.stake)} on ${escapeHtml(b.title)} · pays ${money(Math.round(p.stake*p.mult*100)/100)}</div></div>
            <span class="pill pill-amber">Open</span></div>`;
        }).join('')}</div>` : ''}
      ${bets.length ? bets.map(b=>`<div class="card">
        <div style="display:flex;gap:12px;align-items:center;margin-bottom:6px">
          <div class="row-ic" style="background:${b.color}1F;width:42px;height:42px;font-size:19px">${G(b.emoji)}</div>
          <div style="flex:1;min-width:0"><div class="row-t">${escapeHtml(b.title)}</div>
          <div class="row-s">Who hits ${b.target.toLocaleString()} ${metricById(b.metricId).unit} first · ${daysLeft(b.endsAt)} ${plural(daysLeft(b.endsAt),'day')} left</div></div>
        </div>
        ${b.participants.map(p=>{
          const o = personOdds(p, b);
          const pct = Math.round((p==='me' ? (b.myProgress||0) : (b.progress[p]||0)) / (b.target||1) * 100);
          return `<div class="row"><img src="${personAvatar(p)}" style="width:34px;height:34px;border-radius:50%">
            <div class="row-main"><div class="row-t">${escapeHtml(personName(p))}${p==='me'?' (You)':''}</div>
              <div class="bar" style="margin-top:6px"><span data-w="${Math.min(100,pct)}" style="background:${b.color}"></span></div>
              <div class="row-s">${pct}% there</div></div>
            <button class="btn btn-ghost press" style="padding:9px 13px;font-size:13px" onclick="predictSheet('${b.id}','${p}')">${o.mult}x</button></div>`;
        }).join('')}
      </div>`).join('') : emptyState('dice','No live bets to call','Predictions open up as soon as a bet is running.',`<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}
    </div><div style="height:18px"></div></div>`;
}
function predictSheet(betId, pid){
  const b = DB.bets.find(x=>x.id===betId);
  const o = personOdds(pid, b);
  appSheet('Back ' + escapeHtml(personName(pid)), `
    <p>${escapeHtml(personName(pid))} at <b>${o.mult}x</b> to clear ${b.target.toLocaleString()} ${metricById(b.metricId).unit} in ${escapeHtml(b.title)}.</p>
    <div class="field"><label>Your stake</label>
      <div class="money-wrap"><span class="cur">$</span><input class="inp" id="predAmt" type="number" inputmode="decimal" value="5" oninput="syncPred(${o.mult})"></div>
      <div class="quick">${[5,10,20].map(n=>`<button onclick="document.getElementById('predAmt').value=${n};syncPred(${o.mult})">$${n}</button>`).join('')}</div>
      <div class="hint" id="predHint">Pays ${money(5*o.mult)} if they land it · you have ${money(balance())}</div>
    </div>
    <button class="btn btn-primary btn-block" id="predGo" style="margin-top:16px" onclick="closeSheet();placePrediction('${betId}','${pid}',parseFloat(document.getElementById('predAmt')?.value)||5)">Place prediction</button>
    <button class="btn btn-ghost btn-block" style="margin-top:9px" onclick="closeSheet()">Cancel</button>`);
  window.__predStake = 5;
}
function syncPred(mult){
  const el = document.getElementById('predAmt');
  const v = parseFloat(el.value) || 0;
  const ok = v > 0 && v <= balance();
  document.getElementById('predHint').textContent = ok
    ? `Pays ${money(Math.round(v*mult*100)/100)} if they land it · you have ${money(balance())}`
    : `Enter between $1 and ${money(balance())}`;
  document.getElementById('predGo').classList.toggle('disabled', !ok);
}

function screenLeaderboard(){
  const rows = leaderboard();
  const me = rows.findIndex(r=>r.id==='me');
  return `<div class="pane">${appbar('Leaderboard')}
    <div class="pad">
      <div class="seg" style="margin-bottom:14px">
        ${[['week','This week'],['month','This month'],['all','All time']].map(([k,l])=>
          `<button class="${lbRange===k?'on':''}" onclick="lbRange='${k}';renderApp()">${l}</button>`).join('')}
      </div>
      <div class="card">
        <div class="card-h">Standings — ${rows.length} ${plural(rows.length,'player')}</div>
        ${rows.map((r,i)=>lbRow(r,i)).join('')}
      </div>
      <div class="card"><div class="card-h">Scoring</div>
        <p class="tagline">200 points a win, 25 for every bet you show up to, counted over the window above. Cash is what actually paid out in that window — same records the rest of the app runs on.</p>
        ${me >= 0 ? `<p class="tagline" style="margin-top:8px">You're <b>#${me+1}</b> with ${rows[me].pts.toLocaleString()} points from ${rows[me].won} ${plural(rows[me].won,'win')} in ${rows[me].played} ${plural(rows[me].played,'bet')}.</p>` : ''}
      </div>
    </div><div style="height:18px"></div></div>`;
}

function screenInsights(){
  const list = insights();
  const r = recovery();
  return `<div class="pane">${appbar('Insights')}
    <div class="pad">
      <p class="tagline" style="margin:0 4px 14px">Read straight off your workout log, bet history and wallet. No guesses.</p>
      ${list.map(i=>`<div class="card">
        <div style="display:flex;gap:12px;align-items:flex-start">
          <div class="row-ic" style="background:#F1ECFE;font-size:18px">${G(i.emoji)}</div>
          <div class="row-main">${i.tag?`<div class="insight-tag">${i.tag}</div>`:''}<div class="row-t" style="font-weight:600;line-height:1.45">${i.text}</div></div>
        </div>
        <button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="${i.cta.action}">${i.cta.label}</button>
      </div>`).join('')}
      <div class="card"><div class="card-h">Right now</div>
        <div class="row"><div class="row-main"><div class="row-t">Recovery score</div><div class="row-s">${r.label} · fatigue ${r.fatigue.toLowerCase()}</div></div><div class="row-v" style="color:${r.color}">${r.score}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Current tier</div><div class="row-s">${myTier().name} at ${winRate()}% wins</div></div><div class="row-v">${myTier().odds}</div></div>
      </div>
    </div><div style="height:18px"></div></div>`;
}

function screenRecovery(){
  const r = recovery();
  const connected = DB.profile.health;
  return `<div class="pane">${appbar('Recovery')}
    <div class="pad">
      <div class="card" style="text-align:center">
        <div class="ring" style="width:132px;height:132px;margin:4px auto 12px">
          ${ringSVG(r.score, r.color, 132, 12)}
          <div class="rv"><b style="font-size:38px">${r.score}</b><span style="font-size:11px">${r.label}</span></div>
        </div>
        <div class="rec-state" style="display:inline-flex;background:${r.color}14;color:${r.color}">${r.score>=65?'check':'moon'} ${r.phrase}</div>
        <p class="tagline">Worked out from your training load — ${r.l3} ${plural(r.l3,'session')} in the last 3 days against ${r.l7} across the week, with ${r.restDays} rest ${plural(r.restDays,'day')}.</p>
      </div>
      <div class="card"><div class="card-h">Signals</div>
        <div class="row"><div class="row-main"><div class="row-t">Training load</div><div class="row-s">Sessions in the last 3 days vs your weekly average</div></div><div class="row-v">${r.l3} / ${(r.l7/7*3).toFixed(1)}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Fatigue</div><div class="row-s">Derived from that gap</div></div><div class="row-v" style="color:${r.fatigue==='Low'?'var(--green)':r.fatigue==='Moderate'?'var(--amber)':'var(--red)'}">${r.fatigue}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">Sleep</div><div class="row-s">${connected ? 'From the connected Health provider' : 'Connect Apple Health to read this'}</div></div><div class="row-v">${r.sleep}</div></div>
        <div class="row"><div class="row-main"><div class="row-t">HRV</div><div class="row-s">${connected ? 'From the connected Health provider' : 'Connect Apple Health to read this'}</div></div><div class="row-v">${r.hrv}</div></div>
      </div>
      <div class="card"><div class="card-h">Tips to improve</div>
        ${(r.score >= 80
          ? ['You’re fresh — this is the week to take a Favorite-tier bet and press the advantage.','Keep one rest day banked so the streak survives a bad night.']
          : r.score >= 65
          ? ['Solid, not spare. Keep sessions to one a day until the load evens out.','Log lighter sessions — they still hold the streak.']
          : ['Take a rest day. A streak shield or a lighter session protects the run.','Avoid stacking a new bet on top of the ones already open.']
        ).map(t=>`<div class="row"><div class="row-ic" style="background:var(--lime-soft);color:#3F6300">${ic('check')}</div><div class="row-main"><div class="row-t" style="font-weight:600;line-height:1.45">${t}</div></div></div>`).join('')}
        <button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="go('streaks')">Open Streaks</button>
      </div>
    </div><div style="height:18px"></div></div>`;
}

function screenCommunity(){
  const ev = communityEvents(30);
  return `<div class="pane">${appbar('Community')}
    <div class="pad">
      <div class="card"><div class="card-h">From your crew</div>
        ${ev.length ? ev.map(e=>{
          const r = reactionOf(e.id);
          return `<div class="feed-mini"><img src="${personAvatar(e.who)}" alt="">
            <div class="fm"><div class="fm-t">${e.text}</div><div class="fm-s">${timeAgo(e.ts)}</div></div>
            <button class="react ${r.mine?'on':''}" onclick="react('${e.id}')">${ic('flame')} ${r.n}</button></div>`;
        }).join('') : '<p class="tagline">Nothing yet — invite a friend and the feed fills up.</p>'}
      </div>
      <button class="btn btn-primary btn-block" onclick="inviteSheet()">Invite more friends</button>
      <p class="tagline" style="margin:12px 4px 0">Everything here is built from real results in your bet records. Reactions are yours and stay on this device.</p>
    </div><div style="height:18px"></div></div>`;
}


/* ═══════════════ weekly challenges ═══════════════
   One challenge per calendar week, generated — never stored — so the
   app always has a live week. The name comes from what's actually on
   that week: the season, a real fitness event, or the week's own
   character. Art is a gradient + glyph pair that changes with it.     */

const WEEK_ART = [
  {grad:'linear-gradient(150deg,#1B1030,#2B1140 55%,#3A1533)', glyph:'palm', accent:'#FF6BD6', accent2:'#7C5BFF'},
  {grad:'linear-gradient(150deg,#07213A,#0B3350 55%,#0E4A5B)', glyph:'wave', accent:'#3ED9F5', accent2:'#2563EB'},
  {grad:'linear-gradient(150deg,#2A1206,#40200A 55%,#5A2A0C)', glyph:'flame', accent:'#FFA24B', accent2:'#F2620F'},
  {grad:'linear-gradient(150deg,#0C2417,#0F3A22 55%,#12522C)', glyph:'leaf', accent:'#4BE08A', accent2:'#22C55E'},
  {grad:'linear-gradient(150deg,#231038,#331645 55%,#421A3F)', glyph:'bolt', accent:'#C79BFF', accent2:'#8B5CF6'},
  {grad:'linear-gradient(150deg,#2B0E1B,#421326 55%,#5B1A2E)', glyph:'boxing', accent:'#FF7A93', accent2:'#EF4444'},
  {grad:'linear-gradient(150deg,#101A33,#16264A 55%,#1B3260)', glyph:'moon', accent:'#8FB4FF', accent2:'#2563EB'},
  {grad:'linear-gradient(150deg,#2E2306,#453409 55%,#5E470C)', glyph:'sun', accent:'#FFD36B', accent2:'#F59E0B'},
];

/* weeks that carry a real event get their own name and glyph */
const WEEK_EVENTS = [
  {m:0,  d:[1,10],  title:'Resolution Rumble',        sub:'Everyone starts in January. Finish it.',        glyph:'snow', art:6},
  {m:1,  d:[1,14],  title:'Heart Month Hustle',       sub:'Heart Month — earn the beat.',                  glyph:'heart', art:5},
  {m:2,  d:[1,31],  title:'Spring Forward Sprint',    sub:'Longer days, no excuses.',                      glyph:'leaf', art:3},
  {m:3,  d:[1,14],  title:'World Health Week Warm-Up',sub:'World Health Day week — move for it.',          glyph:'target', art:1},
  {m:4,  d:[1,31],  title:'Move More May',            sub:'The month built for mileage.',                  glyph:'run', art:3},
  {m:5,  d:[1,10],  title:'Global Running Day Dash',  sub:'Running Day week — lace up with everyone.',     glyph:'run', art:2},
  {m:5,  d:[11,30], title:'Summer Shred',             sub:'Summer opens. So does the pot.',                glyph:'palm', art:0},
  {m:6,  d:[1,31],  title:'Midsummer Meltdown',       sub:'Train through the heat, bank the reward.',      glyph:'flame', art:2},
  {m:7,  d:[1,31],  title:'Summer Shred: Final Cut',  sub:'Last stretch of the summer season.',            glyph:'palm', art:0},
  {m:8,  d:[1,30],  title:'Back to Beast Mode',       sub:'Routine season. Rebuild the habit.',            glyph:'star', art:4},
  {m:9,  d:[1,31],  title:'Pumpkin Power Push',       sub:'Dark mornings, heavier lifts.',                 glyph:'flame', art:2},
  {m:10, d:[15,30], title:'Turkey Trot Trials',       sub:'Earn the plate. Trot week.',                    glyph:'star', art:7},
  {m:10, d:[1,14],  title:'No-Excuse November',       sub:'The month that separates people.',              glyph:'wave', art:6},
  {m:11, d:[1,20],  title:'Frostbite Fifty',          sub:'Cold start, hot streak.',                       glyph:'snow', art:1},
  {m:11, d:[21,31], title:'Deck the Halls Dash',      sub:'Out-train the leftovers.',                      glyph:'leaf', art:3},
];

/* fallbacks for ordinary weeks — creative names, rotated by week number */
const WEEK_NAMES = [
  {title:'Monday Mayhem',      sub:'Win the week from the front.'},
  {title:'Iron Week',          sub:'Seven days, no soft ones.'},
  {title:'Sunrise Society',    sub:'Early sessions count double in spirit.'},
  {title:'Cardio Carnival',    sub:'Get the heart rate loud.'},
  {title:'Grit Week',          sub:'The one you win by just showing up.'},
  {title:'The Long Haul',      sub:'Distance, not drama.'},
  {title:'Sweat Equity',       sub:'Put the work in, take the pot out.'},
  {title:'Rep Rally',          sub:'Volume week. Stack them up.'},
  {title:'Hustle & Flow',      sub:'Move often, move well.'},
  {title:'Last One Standing',  sub:'Miss a day, drop off the board.'},
];

function weekStartTs(ts){ const t = startOfDay(ts); return t - ((new Date(t).getDay() + 6) % 7) * DAY; }
function weekNumber(ts){ const d = new Date(ts); const jan1 = new Date(d.getFullYear(), 0, 1);
  return Math.floor(((startOfDay(ts) - startOfDay(jan1.getTime())) / DAY + ((jan1.getDay() + 6) % 7)) / 7) + 1; }
function activeDaysSince(from, to){ return workoutDays().filter(d => d >= from && d < to).length; }

function weeklyChallenge(offset){
  const off = offset || 0;
  const start = weekStartTs(now()) + off * 7 * DAY;
  const end = start + 7 * DAY;
  const d = new Date(start);
  const wk = weekNumber(start);
  const rnd = mulberry32(Math.floor(start / DAY));
  const ev = WEEK_EVENTS.find(e => e.m === d.getMonth() && d.getDate() >= e.d[0] && d.getDate() <= e.d[1]);
  const name = ev || WEEK_NAMES[wk % WEEK_NAMES.length];
  const art = WEEK_ART[(ev ? ev.art : wk) % WEEK_ART.length];
  const goal = 4 + Math.floor(rnd() * 3);              // 4–6 active days
  const prize = 250 + Math.floor(rnd() * 6) * 75;      // $250–$625
  return {
    id: 'wk_' + d.getFullYear() + '_' + wk,
    week: wk, start, end, offset: off,
    title: name.title,
    sub: name.sub,
    detail: `Log ${goal} active days between ${new Date(start).toLocaleDateString(undefined,{weekday:'short', month:'short', day:'numeric'})} and ${new Date(end - DAY).toLocaleDateString(undefined,{weekday:'short', month:'short', day:'numeric'})}.`,
    glyph: (ev && ev.glyph) || art.glyph,
    grad: art.grad, accent: art.accent, accent2: art.accent2,
    goal, prize,
    participants: 640 + Math.floor(rnd() * 3400),
    event: !!ev,
  };
}
function challengeProgress(c){ return activeDaysSince(c.start, Math.min(c.end, now() + DAY)); }
function challengeJoined(c){ return !!(DB.challengeJoins && DB.challengeJoins[c.id]); }
function joinChallenge(cid){
  DB.challengeJoins = DB.challengeJoins || {};
  const was = !!DB.challengeJoins[cid];
  if(was) delete DB.challengeJoins[cid]; else DB.challengeJoins[cid] = true;
  const c = [0,1,-1,-2,-3].map(weeklyChallenge).find(x=>x.id===cid);
  if(!was){
    addXP(XP.challengeDay, 'Joined a challenge');
    logActivity(`You entered <b>${escapeHtml(c ? c.title : 'a challenge')}</b>`, (c && c.glyph) || 'flag', 'challenge');
    toast('You’re in — ' + (c ? c.title : 'challenge joined'), (c && c.glyph) || 'flag');
  } else {
    toast('Left the challenge', 'users');
  }
  commit();
}

function challengeArt(c, h){
  const pct = Math.min(100, Math.round(challengeProgress(c) / c.goal * 100));
  return `<div class="chal-mini" style="background:${c.grad};${h?`min-height:${h}px;`:''}">
    <div class="glow" style="filter:drop-shadow(0 0 18px ${c.accent}88);color:${c.accent}">${G(c.glyph)}</div>
    <div class="m-t">${escapeHtml(c.title)} <span style="opacity:.85">${G(c.glyph)}</span></div>
    <div class="m-s">${c.offset === 0 ? 'Stage ' + Math.min(4, Math.floor(challengeProgress(c)/Math.max(1,c.goal)*4)+1) + ' of 4' : c.offset > 0 ? 'Starts ' + new Date(c.start).toLocaleDateString(undefined,{month:'short', day:'numeric'}) : 'Week ' + c.week + ' · closed'}</div>
    <div class="m-bar"><span data-w="${pct}" style="background:linear-gradient(90deg,${c.accent},${c.accent2})"></span></div>
    <div style="display:flex;justify-content:space-between;align-items:baseline">
      <span class="m-prize">${money(c.prize)} Prize Pool</span>
      <span class="m-s" style="margin:0">${challengeProgress(c)} / ${c.goal} days</span>
    </div>
    <div class="m-join">${c.participants.toLocaleString()} joined</div>
  </div>`;
}

/* challenge card, laid out like the design */
function challengeHubCard(){
  const c = weeklyChallenge(0);
  const done = challengeProgress(c);
  const pct = Math.min(100, Math.round(done / c.goal * 100));
  const stage = Math.min(4, Math.floor(pct/25) + 1);
  return `<div class="hub chal-card">
    <div class="chal-top">
      <div class="chal-copy">
        <div class="hub-t">Challenges</div>
        <div class="hub-s">Compete in epic,<br>multi-stage challenges.</div>
        <button class="chal-cta neon press" onclick="go('challengeDetail',{id:'${c.id}'})">View Challenge</button>
      </div>
      <img class="chal-palm" src="${CHAL_ART}" alt="" draggable="false">
    </div>
    <button class="chal-panel press" onclick="go('challengeDetail',{id:'${c.id}'})">
      <div class="cp-title">${escapeHtml(c.title)} ${ic('sun')}</div>
      <div class="cp-stage">Stage ${stage} of 4</div>
      <div class="cp-row">
        <div class="cp-bar"><span data-w="${pct}"></span></div>
        <span class="cp-pct">${pct}%</span>
      </div>
      <div class="cp-prize"><b>${money(c.prize)}</b> Prize Pool</div>
      <div class="cp-join">${c.participants.toLocaleString()} joined</div>
    </button>
  </div>`;
}
function screenChallenges(){
  const weeks = [1, 0, -1, -2, -3].map(weeklyChallenge);
  return `<div class="pane">${appbar('Challenges')}
    <div class="pad">
      <p class="tagline" style="margin:0 4px 14px">One challenge a week, named for whatever that week is about. Your active days come straight from the workout log.</p>
      ${weeks.map(c=>{
        const done = challengeProgress(c);
        const cleared = done >= c.goal;
        return `<button class="card" style="display:block;width:100%;text-align:left;margin-bottom:12px" onclick="go('challengeDetail',{id:'${c.id}'})">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
            <span class="pill ${c.offset===0?'pill-green':c.offset>0?'pill-grey':cleared?'pill-brand':'pill-grey'}">
              ${c.offset===0?'This week':c.offset>0?'Next week':cleared?'Cleared':'Missed'}</span>
            ${challengeJoined(c) ? '<span class="pill pill-brand">Entered</span>' : ''}
          </div>
          ${challengeArt(c)}
          <div class="row-s" style="margin-top:2px">${escapeHtml(c.sub)}</div>
        </button>`;
      }).join('')}
    </div><div style="height:18px"></div></div>`;
}

function screenChallengeDetail({id}){
  const c = [0,1,-1,-2,-3,-4].map(weeklyChallenge).find(x=>x.id===id) || weeklyChallenge(0);
  const done = challengeProgress(c);
  const pct = Math.min(100, Math.round(done/c.goal*100));
  const left = Math.max(0, c.goal - done);
  const joined = challengeJoined(c);
  const live = c.offset === 0;
  const labels = ['M','T','W','T','F','S','S'];
  return `<div class="pane">${appbar(escapeHtml(c.title))}
    <div class="pad">
      ${challengeArt(c, 150)}
      <div class="card">
        <div style="display:flex;gap:14px;align-items:center">
          <div class="row-ic" style="background:${c.accent}22;width:56px;height:56px;font-size:26px">${G(c.glyph)}</div>
          <div style="flex:1"><div style="font-size:26px;font-weight:800;letter-spacing:-.03em;color:var(--green)">${money(c.prize)}</div>
            <div class="row-s">Prize pool · ${c.participants.toLocaleString()} entered</div></div>
        </div>
        <p class="tagline" style="margin-top:14px">${escapeHtml(c.sub)} ${escapeHtml(c.detail)}</p>
        <div class="bar" style="margin-top:14px"><span data-w="${pct}" style="background:${c.accent2}"></span></div>
        <div class="row-s" style="margin-top:8px">${done} of ${c.goal} days · ${live ? (left ? left + ' to go' : 'target cleared — nice') : (done >= c.goal ? 'cleared' : 'closed')}</div>
      </div>
      <div class="card"><div class="card-h">That week, day by day</div>
        <div class="week-dots">
          ${labels.map((l,i)=>{
            const d = c.start + i*DAY;
            const on = workoutDays().includes(d);
            const today = d === startOfDay(now());
            return `<div><div class="wd-l">${l}</div><div class="wd-c ${on?'on':''} ${today?'today':''}">${on?ic('check'):''}</div></div>`;
          }).join('')}
        </div>
      </div>
      ${live ? `<button class="btn ${joined?'btn-ghost':'btn-primary'} btn-block" onclick="joinChallenge('${c.id}')">${joined?'Leave challenge':'Join challenge'}</button>
        ${joined ? `<button class="btn btn-primary btn-block" style="margin-top:9px" onclick="quickWorkout()">Log today’s session</button>` : ''}`
      : `<div class="card"><p class="tagline">${c.offset > 0 ? 'Opens Monday — entries are free, the pot is not.' : 'This week is closed. The current one is on the Challenges hub.'}</p>
         <button class="btn btn-ghost btn-block" style="margin-top:12px" onclick="go('challenges')">Back to challenges</button></div>`}
    </div><div style="height:18px"></div></div>`;
}

/* ═══════════════ insights — written like a coach who reads your log ═══════════════ */
function insights(){
  const me = (DB.account.name || 'you').split(' ')[0];
  const out = [];
  const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const settled = settledMine();
  const today = startOfDay(now());
  const trainedToday = workoutDays().includes(today);
  const s = streakDays();

  if(s > 0 && !trainedToday){
    out.push({emoji:'flame', tag:'Do this first',
      text:`${me}, that <b>${s}-day streak</b> is still yours until midnight — and nothing on the board for today yet. One session, however short, and it lives.`,
      cta:{label:'Log a workout', action:'quickWorkout()'}});
  } else if(s >= 5){
    out.push({emoji:'flame', tag:'On a run',
      text:`<b>${s} days straight.</b> That's the kind of run that quietly wins bets for you — your odds tier is built on exactly this.`,
      cta:{label:'See Smart Odds', action:"go('smartOdds')"}});
  }

  if(DB.friends.length){
    const rivals = DB.friends.map(f=>({f, h:headToHead(f.id)})).filter(r=>r.h.mine + r.h.theirs > 0);
    const nemesis = rivals.slice().sort((a,b)=>(b.h.theirs - b.h.mine) - (a.h.theirs - a.h.mine))[0];
    const victim = rivals.slice().sort((a,b)=>(b.h.mine - b.h.theirs) - (a.h.mine - a.h.theirs))[0];
    if(nemesis && nemesis.h.theirs > nemesis.h.mine){
      out.push({emoji:'boxing', tag:'Unfinished business',
        text:`<b>${escapeHtml(nemesis.f.name)}</b> is ${nemesis.h.theirs}-${nemesis.h.mine} up on you head to head. That's not a losing record, ${me}, that's an open invitation.`,
        cta:{label:'Challenge ' + escapeHtml(nemesis.f.name), action:`challengeFriend('${nemesis.f.id}')`}});
    } else if(victim && victim.h.mine > victim.h.theirs){
      out.push({emoji:'star', tag:'Your favourite matchup',
        text:`You own <b>${escapeHtml(victim.f.name)}</b> ${victim.h.mine}-${victim.h.theirs}. Ask nicely and they'll probably run it back.`,
        cta:{label:'Run it back', action:`challengeFriend('${victim.f.id}')`}});
    }
  }

  if(DB.workouts.length >= 5){
    const byDay = [0,0,0,0,0,0,0];
    DB.workouts.forEach(w=>byDay[new Date(w.ts).getDay()]++);
    const best = byDay.indexOf(Math.max(...byDay));
    const worst = byDay.indexOf(Math.min(...byDay));
    out.push({emoji:'calendar', tag:'Your rhythm',
      text:`You're a <b>${dayNames[best]}</b> animal — ${byDay[best]} sessions there, only ${byDay[worst]} on ${dayNames[worst]}s. Start your next bet on a ${dayNames[best]} and let the habit do the work.`,
      cta:{label:'Create a bet', action:'startCreate()'}});
  }

  if(settled.length >= 3){
    const byMetric = {};
    settled.forEach(b=>{ const k = b.metricId; byMetric[k] = byMetric[k] || {w:0,n:0}; byMetric[k].n++; if(b.winners.includes('me')) byMetric[k].w++; });
    const ranked = Object.entries(byMetric).filter(([,v])=>v.n >= 2).sort((a,b)=>(b[1].w/b[1].n)-(a[1].w/a[1].n));
    if(ranked.length){
      const [id, v] = ranked[0];
      out.push({emoji:'target', tag:'What you’re good at',
        text:`<b>${metricById(id).name}</b> is your money format — ${Math.round(v.w/v.n*100)}% across ${v.n} bets. When someone offers you one of those, say yes.`,
        cta:{label:'See bet history', action:"go('betHistory')"}});
      if(ranked.length > 1){
        const [wid, wv] = ranked[ranked.length-1];
        if(wv.w/wv.n < 0.5) out.push({emoji:'target', tag:'The leak',
          text:`<b>${metricById(wid).name}</b> bets keep getting you — ${wv.w} from ${wv.n}. Either train it on purpose for two weeks or stop taking them.`,
          cta:{label:'Create a training bet', action:'startCreate()'}});
      }
    }
    const small = settled.filter(b=>b.stake <= 10), big = settled.filter(b=>b.stake > 10);
    if(small.length >= 2 && big.length >= 2){
      const sr = Math.round(small.filter(b=>b.winners.includes('me')).length/small.length*100);
      const br = Math.round(big.filter(b=>b.winners.includes('me')).length/big.length*100);
      out.push({emoji:'dollar', tag:'Money habits',
        text: br > sr
          ? `Funny thing: you win <b>${br}%</b> when there's more than $10 on it, and only ${sr}% when there isn't. You need the pressure, ${me}.`
          : `You're <b>${sr}%</b> at $10 and under but ${br}% above it. Keep the stakes light until the streak is longer — the wins are worth more than the pot.`,
        cta:{label:'Open wallet', action:"go('wallet')"}});
    }
  }

  const net = winningsNet();
  if(net > 0) out.push({emoji:'dollar', tag:'The scoreboard',
    text:`You're up <b>${money(net)}</b> lifetime across ${betsWon()} ${plural(betsWon(),'win')}. That's your friends' money funding your ${myTier().name.toLowerCase()} status.`,
    cta:{label:'See the ledger', action:"go('wallet')"}});

  const owed = owedPunishments();
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    out.push({emoji:p.emoji, tag:'Pay up',
      text:`A <b>${p.name}</b> is still hanging over you${owed[0].dueAt < now() ? ' — and it\'s overdue' : ''}. Clear it and take the +${XP.punishmentServed} XP; the group remembers either way.`,
      cta:{label:'Settle up', action:"go('punishments')"}});
  }

  const r = recovery();
  if(r.score < 60) out.push({emoji:'moon', tag:'Read the body',
    text:`Recovery is sitting at <b>${r.score}</b> — ${r.phrase.toLowerCase()} — off ${r.l3} sessions in three days. Taking a rest day now costs you nothing — stacking another bet on top might.`,
    cta:{label:'Open Recovery', action:"go('recovery')"}});

  const c = weeklyChallenge(0);
  const cp = challengeProgress(c);
  if(cp < c.goal) out.push({emoji:c.glyph, tag:'This week',
    text:`<b>${escapeHtml(c.title)}</b> wants ${c.goal} active days and you've logged ${cp}. ${money(c.prize)} in the pot, ${c.participants.toLocaleString()} people in the way.`,
    cta:{label:'View challenge', action:`go('challengeDetail',{id:'${c.id}'})`}});

  if(!out.length) out.push({emoji:'leaf', tag:'Early days',
    text:`Not much to read yet, ${me}. Log a few workouts and settle a bet or two — this page gets sharper the more you give it.`,
    cta:{label:'Find a bet', action:"setTab('bets')"}});
  return out;
}


/* ═══════════════ interaction layer ═══════════════
   Ripples on every tappable thing, reveal-on-scroll, a header that
   condenses as you go, drag-to-scroll rails, and a light haptic tick. */

const TAPPABLE = '.press,.btn,.hub-cta,.btn-join,.tab,.fab,.chip-x,.opt,.quick button,.seg button,.b-go,.link,.icon-btn,.react,.odds-tier,.row.tap,.lb-row,.wallet-pill .add,.friend,.stat,.bet-card,.card[onclick],.help-dot,.w-btn,.w-dot-hit,.cta,.chip,.chip-single,.back-btn,.ob-back';

function tick(ms){ try{ if(navigator.vibrate) navigator.vibrate(ms || 6); }catch(e){} }

/* ripple retired — see the motion system's press feedback below */

/* reveal cards as they come into view */
let __revealIO = null;
function setupReveal(){
  const sc = document.getElementById('appScroll');
  if(!sc || !('IntersectionObserver' in window)) return;
  if(__revealIO) __revealIO.disconnect();
  __revealIO = new IntersectionObserver(entries=>{
    entries.forEach(en=>{
      if(en.isIntersecting){ en.target.classList.add('in'); __revealIO.unobserve(en.target); }
    });
  }, {root:sc, rootMargin:'0px 0px -6% 0px', threshold:0.05});
  const fold = sc.clientHeight * 0.96;
  sc.querySelectorAll('.card,.hub,.bet-card,.stat,.odds-card,.chal,.friend,.list-card').forEach(el=>{
    if(el.getBoundingClientRect().top - sc.getBoundingClientRect().top > fold){
      el.classList.add('reveal');
      __revealIO.observe(el);
    }
  });
}

/* header condenses, tab bar lifts its shadow */
function setupScrollFx(){
  const sc = document.getElementById('appScroll');
  const app = document.getElementById('app');
  if(!sc || sc.dataset.fx) return;
  sc.dataset.fx = '1';
  let raf = null;
  sc.addEventListener('scroll', ()=>{
    if(raf) return;
    raf = requestAnimationFrame(()=>{
      raf = null;
      app.classList.toggle('scrolled', sc.scrollTop > 18);
    });
  }, {passive:true});
}

/* rails: drag with a mouse, flick with a finger */
function setupRails(){
  document.querySelectorAll('.rail,.odds-strip').forEach(rail=>{
    if(rail.dataset.drag) return;
    rail.dataset.drag = '1';
    let down = false, x0 = 0, left0 = 0, moved = 0;
    rail.addEventListener('pointerdown', e=>{
      if(e.pointerType === 'touch') return;
      down = true; moved = 0; x0 = e.clientX; left0 = rail.scrollLeft;
      rail.style.cursor = 'grabbing';
    });
    rail.addEventListener('pointermove', e=>{
      if(!down) return;
      const dx = e.clientX - x0;
      moved = Math.max(moved, Math.abs(dx));
      if(moved > 4){ rail.scrollLeft = left0 - dx; e.preventDefault(); }
    });
    const end = ()=>{ down = false; rail.style.cursor = ''; };
    rail.addEventListener('pointerup', e=>{ if(moved > 6){ e.preventDefault(); const k=e.target.closest('button,[onclick]'); if(k) k.__skip = true; } end(); });
    rail.addEventListener('pointerleave', end);
    rail.addEventListener('click', e=>{ if(moved > 6){ e.stopPropagation(); e.preventDefault(); moved = 0; } }, true);
  });
}

function afterAppRender(){
  requestAnimationFrame(()=>{
    document.querySelectorAll('[data-w]').forEach(el=>{ el.style.width = el.dataset.w + '%'; });
    document.querySelectorAll('[data-count]').forEach(el=>countUp(el));
    document.querySelectorAll('[data-dash]').forEach(el=>{ el.style.strokeDashoffset = el.dataset.dash; });
    setupReveal();
    setupRails();
    setupScrollFx();
    if(tab === 'home' && !stack.length){ wireHero(); startHeroAuto(); } else { stopHeroAuto(); }
    bellBreathe();
    if(stack.length && stack[stack.length-1].screen === 'live' && liveState && !liveTick) bootLive();
  });
}


/* ═════════ Home v3: launchpad layout ═════════ */
function oddsRow(){
  const tier = myTier();
  const rate = settledMine().length ? winRate() : 50;
  return `<div class="pad"><button class="odds-row press" onclick="go('smartOdds')">
    <span class="o-ic" style="background:${tier.color}1F;color:${tier.color}">${ic('dice')}</span>
    <span class="o-main"><span class="o-t">${tier.name}</span>
      <span class="o-s">Your odds tier · ${rate}% win rate · ${settledMine().length} settled</span></span>
    <span class="o-odds" style="color:${tier.color}">${tier.odds}</span>
    ${I.chevR.replace('<svg','<svg class="chev"')}
  </button></div>`;
}

function weekFeature(){
  const c = weeklyChallenge(0);
  const joined = challengeJoined(c);
  return `<div class="feature">
    ${challengeArt(c)}
    <div class="feature-row">
      <button class="btn-sm press" onclick="go('challenges')">All weeks</button>
      <button class="btn-sm dark press" onclick="go('challengeDetail',{id:'${c.id}'})">${joined ? 'View Challenge' : 'Join this week'}</button>
    </div>
  </div>`;
}

function tile(o){
  return `<button class="tile press" onclick="${o.go}">
    <span class="t-ic" style="background:${o.bg}">${o.ic}</span>
    <span class="t-l">${o.label}</span>
    <span class="t-v ${o.hot?'hot':''}">${o.value}</span>
  </button>`;
}

function hubTiles(){
  const lb = leaderboard();
  const rank = lb.findIndex(r=>r.id === 'me') + 1;
  const rec = recovery();
  const preds = openPredictions().length;
  const owed = owedPunishments().length;
  return `<div class="tiles stagger">
    ${tile({ic:'flame', bg:'#FDEDE3', label:'Streaks',     value:streakDays() + 'd', go:"go('streaks')", hot:streakDays()>0})}
    ${tile({ic:'dice', bg:'#F1ECFE', label:'Predictions', value:preds ? preds + ' open' : 'Bet now', go:"go('predictions')"})}
    ${tile({ic:'trophy', bg:'#FEF3E2', label:'Leaderboard', value:rank ? '#' + rank : '—', go:"go('leaderboard')"})}
    ${tile({ic:'brain', bg:'#EFE9FD', label:'Insights',    value:insights().length + ' tips', go:"go('insights')"})}
    ${tile({ic:'heart', bg:'#E8F8EE', label:'Recovery',    value:rec.score + ' ' + rec.label, go:"go('recovery')"})}
    ${tile({ic:owed?'ghost':'users', bg:owed?'#FDECEA':'#EAF1FE', label:owed?'Punishments':'Community',
            value:owed ? owed + ' owed' : communityEvents(9).length + ' new', go:owed?"go('punishments')":"go('community')", hot:!!owed})}
  </div>`;
}

function screenHome(){
  const owed = owedPunishments();
  const live = liveBets();
  const banners = [];
  if(owed.length){
    const p = punishmentById(owed[0].punishmentId);
    banners.push(`<div class="banner banner-red">
      <div class="b-ic">${G(p.emoji)}</div>
      <div class="b-main"><div class="b-t">You owe a ${p.name}</div><div class="b-s">From ${escapeHtml((DB.bets.find(b=>b.id===owed[0].betId)||{}).title||'a bet')} · ${owed[0].dueAt < now() ? 'overdue' : 'due within 24h'}</div></div>
      <button class="b-go press" onclick="go('punishments')">Settle up</button>
    </div>`);
  }
  if(DB.demoSeeded && !DB.demoNoticeSeen){
    banners.push(`<div class="banner banner-info slim">
      <div class="b-ic">${ic('sparkle')}</div>
      <div class="b-main"><div class="b-t">Demo data loaded — every figure adds up from it</div></div>
      <button class="b-x press" onclick="DB.demoNoticeSeen=true;commit()" aria-label="Dismiss">${ic('x')}</button>
    </div>`);
  }
  return `<div class="pane">
    ${homeHeader()}
    ${heroBanner()}
    ${banners.join('')}

    <div class="sec"><h3>Your Overview</h3><button class="link" onclick="go('overview')">View all</button></div>
    ${homeStats()}
    <div style="height:12px"></div>
    ${oddsRow()}

    <div class="sec"><h3>Live Bets</h3><button class="link" onclick="setTab('bets')">View all</button></div>
    ${live.length ? `<div class="rail stagger">${live.slice(0,6).map(betCard).join('')}</div>`
      : emptyState('dice','No live bets','Start one and put something on the line.',`<button class="btn btn-primary" onclick="startCreate()">Create a bet</button>`)}

    <div class="sec"><h3>This Week</h3><button class="link" onclick="go('challenges')">All challenges</button></div>
    ${weekFeature()}

    <div class="sec"><h3>Your Friends</h3><button class="link" onclick="inviteSheet()">Invite</button></div>
    ${DB.friends.length ? `<div class="rail stagger">
        ${DB.friends.map(friendTile).join('')}
        <button class="friend invite-tile press" onclick="inviteSheet()">
          <div class="friend-av">${I.userplus}</div><div class="friend-name">Invite<br>more</div>
        </button>
      </div>`
      : emptyState('users','No friends yet','Bets are better with someone to beat.',`<button class="btn btn-primary" onclick="inviteSheet()">Invite a friend</button>`)}

    <div class="sec"><h3>Explore</h3></div>
    ${hubTiles()}
    <div style="height:14px"></div>
  </div>`;
}

